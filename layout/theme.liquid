    {% if page.handle == 'ccpa-opt-out' %}
      {%- comment -%}
        Reopens the native cookie preferences modal from /pages/ccpa-opt-out.
        The modal exposes the data sale/sharing toggle for California visitors.

        The button is hidden by CSS rather than a `hidden` attribute: the page's
        rich text editor strips attributes on save, but cannot touch theme styles.
      {%- endcomment -%}

      <script>
        (function () {
          const btn = document.getElementById('pepper-privacy-optout');
          if (!btn) return;

          window.Shopify.loadFeatures(
            [{ name: 'consent-tracking-api', version: '0.1' }],
            function (error) {
              if (error) return;

              // The banner is configured for California only, so the button mirrors
              // Shopify's footer link and stays hidden everywhere else.
              if (!window.Shopify.customerPrivacy.saleOfDataRegion()) return;

              btn.classList.add('is-eligible');

              btn.addEventListener('click', function () {
                if (typeof privacyBanner === 'undefined' || !privacyBanner.showPreferences) {
                  window.location.href = 'mailto:hello@pepper-home.com?subject=Do%20Not%20Sell%20or%20Share%20My%20Information';
                  return;
                }

                privacyBanner.showPreferences();
              });
            }
          );
        })();
      </script>
    {% endif %}
