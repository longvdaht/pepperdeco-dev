    {%- comment -%}
      Dawn ships without Shopify.formatMoney, so the trade pricing app falls back to
      its own toFixed(2) output and flashes cents into the cart subtotal. Providing
      the function makes that app format money the same way Liquid does.
    {%- endcomment -%}
    <script>
      window.Shopify = window.Shopify || {};
      if (typeof window.Shopify.formatMoney !== 'function') {
        window.Shopify.formatMoney = function (cents) {
          var amount = Number(cents);
          if (isNaN(amount)) return '';

          // Mirrors money_without_trailing_zeros: cents only when not a whole number.
          var digits = amount % 100 === 0 ? 0 : 2;

          return '$' + (amount / 100).toLocaleString('en-US', {
            minimumFractionDigits: digits,
            maximumFractionDigits: digits
          });
        };
      }
    </script>

