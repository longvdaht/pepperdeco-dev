<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} | tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} | Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} | {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="https://kit.fontawesome.com/3d594780df.js" crossorigin="anonymous" defer="defer"></script>

    {{ content_for_header }}

    {% style %}
        @font-face {
          font-family: 'gt-super';
          src: url({{ 'gt-super-display-light.woff2' | asset_url }}) format('woff2'),
            url({{ 'gt-super-display-light.woff' | asset_url }}) format('woff'),
            url({{ 'gt-super-display-light.ttf' | asset_url }}) format('truetype');
          font-weight: 100;
          font-style: normal;
          font-display: swap;
        }
      @font-face {
          font-family: 'gt-super';
          src: url({{ 'gt-super-display-light-italic.woff2' | asset_url }}) format('woff2'),
            url({{ 'gt-super-display-light-italic.woff' | asset_url }}) format('woff'),
            url({{ 'gt-super-display-light-italic.ttf' | asset_url }}) format('truetype');
          font-weight: 100;
          font-style: italic;
          font-display: swap;
        }
        @font-face {
          font-family: 'gt-super';
          src: url({{ 'gt-super-display-regular.woff2' | asset_url }}) format('woff2'),
            url({{ 'gt-super-display-regular.woff' | asset_url }}) format('woff'),
            url({{ 'gt-super-display-regular.ttf' | asset_url }}) format('truetype');
          font-weight: normal;
          font-style: normal;
          font-display: swap;
        }

        @font-face {
          font-family: 'apercu';
          src: url({{ 'apercu-light-pro.eot' | asset_url }});
          src: url({{ 'apercu-light-pro.eot?#iefix' | asset_url }}) format('embedded-opentype'),
            url({{ 'apercu-light-pro.woff2' | asset_url }}) format('woff2'),
            url({{ 'apercu-light-pro.woff' | asset_url }}) format('woff'),
            url({{ 'apercu-light-pro.ttf' | asset_url }}) format('truetype');
          font-weight: 100;
          font-style: normal;
          font-display: swap;
        }

        @font-face {
          font-family: 'apercu';
          src: url({{ 'apercu-medium-pro.eot' | asset_url }});
          src: url({{ 'apercu-medium-pro.eot?#iefix' | asset_url }}) format('embedded-opentype'),
            url({{ 'apercu-medium-pro.woff2' | asset_url }}) format('woff2'),
            url({{ 'apercu-medium-pro.woff' | asset_url }}) format('woff'),
            url({{ 'apercu-medium-pro.ttf' | asset_url }}) format('truetype');
          font-weight: normal;
          font-style: normal;
          font-display: swap;
        }

        :root {
          --font-heading-family: 'gt-super', serif;
          --font-heading-weight: light;

          --font-body-family: 'apercu', sans-serif;
          --font-body-style: normal;
          --font-body-weight: 100;
          --font-button-weight: 400;

          --color-base-text: {{ settings.colors_text_primary.red }}, {{ settings.colors_text_primary.green }}, {{ settings.colors_text_primary.blue }};
          --color-base-background-primary: {{ settings.colors_background_primary.red }}, {{ settings.colors_background_primary.green }}, {{ settings.colors_background_primary.blue }};
          --color-base-background-secondary: {{ settings.colors_background_secondary.red }}, {{ settings.colors_background_secondary.green }}, {{ settings.colors_background_secondary.blue }};
          --color-base-button-label: {{ settings.colors_button_label.red }}, {{ settings.colors_button_label.green }}, {{ settings.colors_button_label.blue }};
          --color-base-button-background: {{ settings.colors_button_background.red }}, {{ settings.colors_button_background.green }}, {{ settings.colors_button_background.blue }};
          --color-base-button-background-hover: {{ settings.colors_button_background_hover.red }}, {{ settings.colors_button_background_hover.green }}, {{ settings.colors_button_background_hover.blue }};

          --page-width: {{ settings.page_width | divided_by: 10 }}rem;
        }

        *,
        *::before,
        *::after {
          box-sizing: inherit;
        }

        html {
          box-sizing: border-box;
          font-size: 62.5%;
          height: 100%;
        }

        body {
          display: flex;
          flex-direction: column;
          color: rgb(var(--color-base-text));
          margin: 0;
          min-height: 100%;
          font-family: var(--font-body-family);
          font-size: 1.5rem;
          font-style: var(--font-body-style);
          font-weight: var(--font-body-weight);
          line-height: 1.4;
        }

        @media screen and (min-width: 40em) {
          body {
            font-size: 1.6rem;
            line-height: 1.5;
          }
        }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
  </head>

  <body>
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {% section 'main-password-header' %}

    <main id="MainContent" class="password-main">
      {{ content_for_layout }}
      <div class="section-outer section-padded page-width page-width--narrow center">
        <div class="section-inner">
          {%- form 'storefront_password', class: 'password-form' -%}
            <div class="field{% if form.errors %} password-field--error{% endif %}">
              <label for="Password" class="field__label"> Password </label>
              <input
                type="password"
                name="password"
                id="Password"
                class="field__input"
                autocomplete="current-password"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="PasswordLoginForm-password-error"
                {% endif %}
                placeholder="Password"
              >
              {%- if form.errors -%}
                <div id="PasswordLoginForm-password-error" role="status">
                  <span class="visually-hidden">
                    {{ 'accessibility.error' | t }}
                  </span>
                  <span class="form__message"> Wrong password </span>
                </div>
                <button name="commit" class="button button--primary">Enter</button>
              {%- endif -%}
            </div>
          {%- endform -%}
        </div>
      </div>
    </main>
    <footer>
      {% section 'main-password-footer' %}
    </footer>
  </body>
</html>
