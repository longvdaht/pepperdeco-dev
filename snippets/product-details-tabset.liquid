{%- capture 'icon_up' -%}
  <svg class="icon icon-chevron-down" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M12.3984 5.80078L7.99967 10.1997L3.60075 5.80078" stroke="#242524"/>
  </svg>
{%- endcapture -%}
{%- capture 'icon_down' -%}
  <svg class="icon icon-chevron-up" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M3.60156 10.1997L8.00033 5.80078L12.3993 10.1997" stroke="#242524"/>
  </svg>
{%- endcapture -%}
<div class="product-details-collapse">
  <details>
    <summary>
      <span class="product-details-title">
        {{ 'products.product.details.details' | t }}
      </span>
      <span class="svg-wrapper">
          <span class="icon-plus">
            {{ icon_down }}
          </span>
          <span class="icon-minus">
            {{ icon_up }}
          </span>
        </span>
    </summary>
    <div class="details-content description rte">
      {% assign product_details_metaobject = product.metafields.custom.product_details_metaobject %}
        {% if product_details_metaobject %}
          {% for detail in product_details_metaobject.value %}
            {% if detail.product_details != blank %}
              {{ detail.product_details | metafield_tag }}
            {% endif %}
            {% if detail.image != blank %}
              <p>
                <img src="{{ detail.image | image_url: width: 500, height: 500 }}" alt="{{ detail.image.alt | default: product.title }}" width="500" height="500"/> 
              </p>
            {% endif %}
          {% endfor %}
        {% endif %}
    </div>
  </details>

  {% if product.metafields.custom.dimension != blank %}
    <details>
      <summary>
        <span class="product-details-title">
          {{ 'products.product.details.dimension' | t }}
        </span>
        <span class="svg-wrapper">
          <span class="icon-plus">
            {{ icon_down }}
          </span>
          <span class="icon-minus">
            {{ icon_up }}
          </span>
        </span>
      </summary>
      <div class="details-content rte">
        {% comment %} {{ product.metafields.global.Guides }} {% endcomment %}
        {% assign dimension_metaobject = product.metafields.custom.dimension %}
        {% if dimension_metaobject %}
          {% for dimension in dimension_metaobject.value %}
            {% if dimension.details != blank %}
              {{ dimension.details | metafield_tag }}
            {% endif %}
            {% if dimension.image != blank %}
              <p>
                <img src="{{ dimension.image | image_url: width: 500, height: 500 }}" alt="{{ dimension.image.alt | default: product.title }}" width="500" height="500"/> 
