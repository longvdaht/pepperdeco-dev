            class="trim-option-radio trim-{{ trim_option | handleize }}"
          >
            {{ trim_option | escape }}
          </label>
        {%- endif -%}
      {%- endfor -%}
      {%- for trim_option in trim_options -%}
        {%- if trim_option contains 'Pom Pom' -%}
          {%- liquid
            if product.metafields.pepper.trim_images.value == blank
