                for curtain_trim_image in metaobjects['curtain_trim_images'].values
                  assign trim_curtain_option_handle = curtain_trim_image.name | handle
                  if trim_curtain_option_handle == trim_option_handle
                    assign trim_image = curtain_trim_image.name | handleize
                    break
                  endif
                endfor
              endpaginate
            endif
          -%}
          {%- if pom_pom_label -%}
            <div class="js product-form__input product-form__input-pom-pom">
              <aside class="form__label">
                Pom Pom:
                <span id="{{ section.id }}-option-pom-pom"></span>
              </aside>
            </div>
            <input
