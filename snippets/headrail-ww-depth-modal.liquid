{% comment %}
  Renders the "Headrail depth" modal for Woven Wood shades.

  Desktop: one table — SHADE WEIGHT | 1.5" HEADRAIL MAXIMUM SIZE
  Mobile : two stacked tables — SHADE WEIGHT / WIDTH

  Usage:
    {% render 'headrail-ww-depth-modal', block: block %}

  Accepts:
  - block: {Object} Optional block, used for shopify_attributes and settings.content
{% endcomment %}

{%- liquid
  assign ns = 'products.product.shade_headrail_ww'
  assign label = ns | append: '.label' | t
-%}

<details-modal
  id="headrailModal"
  class="product__modal headrail-ww-depth-modal headrail-depth-modal"
  {{ block.shopify_attributes }}
>
  <details>
    <summary
      class="modal__toggle"
      aria-haspopup="dialog"
      aria-label="{{ label }} {{ 'products.product.calculate_dimension' | t }}"
    >
      <span class="option-link">?</span>
    </summary>

    <div
      class="product-modal modal__content"
      role="dialog"
      aria-modal="true"
      aria-label="{{ label }} {{ 'products.product.calculate_dimension' | t }}"
    >
      <div class="modal-overlay"></div>

      <div class="product-modal__content" tabindex="-1">
        <div id="headrail-depth-modal-content" class="headrail-depth-modal-content headrail-depth-ww-modal-content">
          <div class="product-modal__content--heading">{{ label }}:</div>

          <div class="headrail-depth-modal-content-wrapper">
            <div class="headrail-content-wrapper">
              {%- comment -%} ---------- DESKTOP TABLE ---------- {%- endcomment -%}
              <table class="headrail-table headrail-table--desktop">
                <thead>
                  <tr>
                    <th scope="col">{{ 'products.product.shade_headrail_ww.table.header_shade_weight' | t }}</th>
                    <th scope="col">{{ 'products.product.shade_headrail_ww.table.header_max_size' | t }}</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>{{ 'products.product.shade_headrail_ww.table.light' | t }}</td>
                    <td>{{ 'products.product.shade_headrail_ww.table.light_value_html' | t }}</td>
                  </tr>
                  <tr>
                    <td>{{ 'products.product.shade_headrail_ww.table.medium' | t }}</td>
                    <td>{{ 'products.product.shade_headrail_ww.table.medium_value_html' | t }}</td>
                  </tr>
                  <tr>
                    <td>{{ 'products.product.shade_headrail_ww.table.heavy' | t }}</td>
                    <td>{{ 'products.product.shade_headrail_ww.table.heavy_value_html' | t }}</td>
                  </tr>
                </tbody>
              </table>

              {%- comment -%} ---------- MOBILE TABLES ---------- {%- endcomment -%}
              <table class="headrail-table headrail-table--mobile">
                <thead>
                  <tr>
                    <th scope="col">{{ 'products.product.shade_headrail_ww.table.header_shade_weight' | t }}</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>{{ 'products.product.shade_headrail_ww.table.light' | t }}</td>
                  </tr>
                  <tr>
                    <td>{{ 'products.product.shade_headrail_ww.table.medium' | t }}</td>
                  </tr>
                  <tr>
                    <td>{{ 'products.product.shade_headrail_ww.table.heavy' | t }}</td>
                  </tr>
                </tbody>
              </table>

              <table class="headrail-table headrail-table--mobile">
                <thead>
                  <tr>
                    <th scope="col">{{ 'products.product.shade_headrail_ww.table.header_width' | t }}</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>{{ 'products.product.shade_headrail_ww.table.light_value_html' | t }}</td>
                  </tr>
                  <tr>
                    <td>{{ 'products.product.shade_headrail_ww.table.medium_value_html' | t }}</td>
                  </tr>
                  <tr>
                    <td>{{ 'products.product.shade_headrail_ww.table.heavy_value_html' | t }}</td>
                  </tr>
                </tbody>
              </table>

              {%- comment -%} ---------- IMAGE + NOTE ---------- {%- endcomment -%}
              <div class="content-below">
                <div class="content-note">
                  <span class="note">
                    {{ 'products.product.shade_headrail_ww.note_html.note' | t }}
                  </span>
                  <p>{{ 'products.product.shade_headrail_ww.note_html.outside' | t }}</p>
                  <p>{{ 'products.product.shade_headrail_ww.note_html.inside' | t }}</p>
                </div>

                <img
                  src="{{ 'woven-wood-desktop.png' | asset_img_url: 'large' }}"
                  alt="{{ 'products.product.shade_headrail_ww.image_alt' | t }}"
                  width="400"
                  height="400"
                  loading="lazy"
                >
              </div>
            </div>
          </div>

          <button
            type="button"
            class="modal__close-button link button-unstyled focus-inset"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {%- render 'icon-close' -%}
          </button>
        </div>
      </div>
    </div>
  </details>
</details-modal>

