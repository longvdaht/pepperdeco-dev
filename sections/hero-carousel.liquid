            },
            {
              "value": "transformyourspace",
              "label": "Transform Your Space With Timeless Prints"
            },
            {
              "value": "loomco",
              "label": "Loom & Co x Pepper Rugs"
            },
            {
              "value": "sustainabledecor",
              "label": "Sustainable Decor Your Little One Won't Outgrow"
            },
            {
              "value": "showercurtains",
              "label": "Give your bathroom an instant upgrade"
            },
            {
              "value": "by-the-yard",
              "label": "Prints and Colors by the Yard"
            },
            {
              "value": "grasscloths-linens",
              "label": "Grosscloths & Heavyweight Linens"
            },
            {
              "value": "sizes-and-trims",
              "label": "Say Hello to New Sizes and Trims"
            },
            {
              "value": "bundles",
              "label": "Handpicked by the Experts for Exceptional Style"
            },
            {
              "value": "customized",
              "label": "Soft, Stylish, and Completely Customized"
            },
            {
              "value": "chappywrap",
              "label": "Wrapped up in style"
            },
            {
              "value": "naturalfibers",
