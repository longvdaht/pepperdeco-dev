<link rel="stylesheet" href="{{ 'section-design-hub.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-card.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-rte.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>{{ 'section-design-hub.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-card.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-rte.css' | asset_url | stylesheet_tag }}</noscript>

<script src="{{ 'design-details.js' | asset_url }}" defer></script>

{%- assign grid_mobile_column = 'one' -%}
{%- assign grid_desktop_column = 'one-half' -%}

<div
  class="section-outer section-design-hub section-trade-hub section-color-{{ section.settings.color_scheme }} center"
  id="design-hub"
>
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="section-heading-outer page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="h2 section-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section-subheading intro">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="page-width">
    <div class="grid mobile-{{ grid_mobile_column }} desktop-{{ grid_desktop_column }}">
      <div class="grid__item design-links" {{ block.shopify_attributes }}>
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'link' -%}
              {% if block.settings.link != blank %}
                <details
                  {% if forloop.first %}
                    open
                  {% endif %}
                  class="expand-on-hover"
                >
                  <summary>
                    <div class="h4 expand-heading">
                      {{- block.settings.heading }}
                      {% render 'icon-down-arrow' -%}
                    </div>
                  </summary>
                  <a href="{{ block.settings.link }}" class="full-unstyled-link">
                    <div class="expand-content">{{ block.settings.content }}</div>
                  </a>
                </details>
              {% else %}
                <details class="expand-on-hover">
                  <summary>
                    <div class="h4 expand-heading">
                      {{- block.settings.heading }}
                      {% render 'icon-down-arrow' -%}
                    </div>
                  </summary>
                  <div class="expand-content">
                    {% if block.settings.link != blank %}
                      <a href="{{ block.settings.link }}">
                        {{ block.settings.content }}
                      </a>
                    {% else %}
                      {{ block.settings.content }}
                    {% endif %}
                  </div>
                </details>
              {% endif %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
      <div class="grid__item grid__item-design-card" {{ block.shopify_attributes }}>
        {%- assign tip_number = 1 -%}
        <slider-component class="{% unless section.settings.show_buttons %} slider-hide-buttons {% endunless %}{% unless section.settings.show_dots %} slider-hide-dots {% endunless %}">
          <ul
            class="list-unstyled slider grid grid-nowrap mobile-one desktop-one design-hub-carousel-outer"
            id="Slider-{{ section.id }}"
            role="list"
          >
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'design_block' -%}
                  <li class="carousel-cell" {{ block.shopify_attributes }}>
                    {% render 'design-card', block: block, tip: tip_number, show_tips: section.settings.show_tips %}
                    {%- assign tip_number = tip_number | plus: 1 -%}
                  </li>
                {%- when 'image' -%}
                  <li class="carousel-cell" {{ block.shopify_attributes }}>
                    {%- if block.settings.image != blank -%}
                      <div class="media media--transparent media--square">
                        <img
                          srcset="
                            {%- if block.settings.image.width >= 375 -%}{{ block.settings.image | image_url: width: 375 }} 375w,{%- endif -%}
                            {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
                            {%- if block.settings.image.width >= 1100 -%}{{ block.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
                            {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
                            {%- if block.settings.image.width >= 1780 -%}{{ block.settings.image | image_url: width: 1780 }} 1780w,{%- endif -%}
                            {%- if block.settings.image.width >= 2000 -%}{{ block.settings.image | image_url: width: 2000 }} 2000w,{%- endif -%}
                            {%- if block.settings.image.width >= 3000 -%}{{ block.settings.image | image_url: width: 3000 }} 3000w,{%- endif -%}
                            {%- if block.settings.image.width >= 3840 -%}{{ block.settings.image | image_url: width: 3840 }} 3840w,{%- endif -%}
                          "
                          sizes="(min-width: 40em) 40vw, calc(100vw - 4rem)"
                          src="{{ block.settings.image | image_url: width: 400 }}"
                          loading="lazy"
                          alt="{{ block.settings.image.alt | escape }}"
                          width="{{ block.settings.image.width }}"
                          height="{{ block.settings.image.width | divided_by: block.settings.image.aspect_ratio }}"
                        >
                      </div>
                    {%- elsif request.design_mode -%}
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg hide-on-desktop' }}
                    {%- endif -%}
                  </li>
              {%- endcase -%}
            {%- endfor -%}
          </ul>
          <div class="slider-dots no-js-hidden">
            {% for dot in (1..section.blocks.size) %}
              <button
                type="button"
                data-index="{{ forloop.index }}"
                class="slider-dot{% if forloop.index0 == 0 %} is-active{% endif %}"
                name="index"
                aria-label="{{ 'accessibility.slide_index' | t: index: forloop.index }}"
              ></button>
            {% endfor %}
          </div>
          <div class="slider-buttons no-js-hidden">
            <button
              type="button"
              class="slider-button slider-button--prev"
              name="previous"
              aria-label="{{ 'accessibility.previous_slide' | t }}"
            >
              {% render 'icon-arrow-left' %}
            </button>
            <div class="slider-counter caption">
              <span class="slider-counter--current">1</span>
              <span aria-hidden="true"> / </span>
              <span class="visually-hidden">{{ 'accessibility.of' | t }}</span>
              <span class="slider-counter--total">{{ section.blocks.size }}</span>
            </div>
            <button
              type="button"
              class="slider-button slider-button--next"
              name="next"
              aria-label="{{ 'accessibility.next_slide' | t }}"
            >
              {% render 'icon-arrow-right' %}
            </button>
          </div>
        </slider-component>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trade feature",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "background-primary",
          "label": "Primary"
        },
        {
          "value": "background-secondary",
          "label": "Secondary"
        }
      ],
      "default": "background-secondary"
    },
    {
      "type": "checkbox",
      "id": "show_tips",
      "label": "Show tip numbers",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_buttons",
      "label": "Show buttons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "design_block",
      "name": "Design Card",
      "settings": [
        {
          "type": "color",
          "id": "background_color",
          "label": "Card background color",
          "default": "#A39E73"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "info": "This cannot contain a link if the card link is set"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trade feature",
      "settings": {
        "heading": "Design Hub",
        "subheading": "Pepper it yourself with some help from our design resources"
      },
      "blocks": [
        {
          "type": "link",
          "settings": {
            "heading": "Complimentary Design Assistance"
          }
        },
        {
          "type": "link",
          "settings": {
            "heading": "Wallpaper Calculator"
          }
        },
        {
          "type": "link",
          "settings": {
            "heading": "Curtain Calculator"
          }
        },
        {
          "type": "link",
          "settings": {
            "heading": "Explore our Blog"
          }
        },
        {
          "type": "link",
          "settings": {
            "heading": "Fabric Swatches"
          }
        },
        {
          "type": "link",
          "settings": {
            "heading": "Designer Bundles"
          }
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
