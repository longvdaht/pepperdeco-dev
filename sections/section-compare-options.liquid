
<link rel="stylesheet" href="{{ 'section-compare-options.css' | asset_url }}" media="print" onload="this.media='all'">

<style>
  .section-product-compare-option {
    background-color: {{ section.settings.background_color }};
  }
</style>

{% assign fabric_options = product.metafields.custom.compare_fabric_options %}
{% if fabric_options.value %}
  <div
    class="section-outer section-product-compare-option center{% if section.settings.heading == 'Trim Selections' and trim_options == blank %} hidden{% endif %}"
    id="additional"
  >
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="section-heading-outer page-width">
        {%- if section.settings.heading != blank -%}
          <h2 class="display section-heading" id="additional-{{ section.settings.heading | handleize }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section-subheading intro" {% if section.settings.subheading_width != blank %}style="max-width: {{ section.settings.subheading_width | times: 1 }}px;"{% endif %}>{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="section-product-compare-option-content page-width">
      {% for item in fabric_options.value %}
        <div class="section-product-option-wrapper">
          <div class="fabric-option-block-wrapper cotten-block">
            <span class="fabric-option-title">{{ 'sections.compare_options.cotton' | t }}</span>
            <div class="fabric-option-block">
              <img src="{{ item.printed_cotton_image | image_url: width: 600 }}" width="600" height="600"/>
              <div class="rte">
                {% for child in item.printed_cotton_description.value.children %}
                  {% for subchild in child.children %}
                    {% assign subchild_content = subchild.value | raw | strip | split: '•' %}
                    <ul>
                      {% for content in subchild_content %}
                        {% if content != '' %}
                          <li>{{ content }}</li>
                        {% endif %}
                      {% endfor %}
                    </ul>
                  {% endfor %}
                {% endfor %}
              </div>
            </div>
          </div>
          <div class="fabric-option-block-wrapper linen-block">
            <span class="fabric-option-title">{{ 'sections.compare_options.linen' | t }}</span>
            <div class="fabric-option-block">
              <img src="{{ item.printed_linen_image | image_url: width: 600 }}" width="600" height="600"/>
              <div class="rte">
                {% for child in item.printed_linen_description.value.children %}
                  {% for subchild in child.children %}
                    {% assign subchild_content = subchild.value | raw | strip | split: '•' %}
                    <ul>
                      {% for content in subchild_content %}
                        {% if content != '' %}
                          <li>{{ content }}</li>
                        {% endif %}
                      {% endfor %}
                    </ul>
                  {% endfor %}
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
      {%  if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_url | default: '#' }}" class="button button--secondary" title="{{ section.settings.button_text }}">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Section compare options",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Using metafield Fabric option."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fabric Options"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "The Art of Fabric: Cotton or Linen—See Which One Suits Your Space Best"
    },
    {
      "type": "text",
      "id": "subheading_width",
      "label": "Subheading width",
      "default": "400",
      "info": "Unit: px. Leave it blank to config full width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F3F1EC"
    },
    {
      "type": "text",
      "label": "Button text",
      "id": "button_text",
      "default": "ORDER FABRIC SAMPLES"
    },
    {
      "type": "url",
      "label": "Button url",
      "id": "button_url"
    }
  ],
  "presets": [
    {
      "name": "Section compare options"
    }
  ]
}
{% endschema %}
