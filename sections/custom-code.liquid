{%- style -%}
  [data-section-id="{{ section.id }}"] {
    background-color: {{ section.settings.background_color }};
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="section-custom-code" data-section-id="{{ section.id }}">
  <div class="section-outer section-{{ section.id }}-padding {% if section.settings.include_margins %}page-width{% endif %}">
    {% if section.settings.title != blank or section.settings.description != blank %}
      <div class="heading-section">
        {% if section.settings.title != blank or section.settings.description != blank %}
          <h3 class="heading">{{ section.settings.title }}</h3>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="rte description">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>
    {% endif %}
    {{ section.settings.code }}
  </div>
</div>

{% schema %}
{
  "name": "Custom Code",
  "tag": "section",
  "class": "spaced-section",
  "settings": [
    {
      "type": "color",
      "label": "Background color",
      "id": "background_color"
    },
    {
      "type": "checkbox",
      "id": "include_margins",
      "default": true,
      "label": "Make section margins the same as theme"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "html",
      "id": "code",
      "label": "code"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Custom Code"
    }
  ]
}
{% endschema %}
