<link rel="stylesheet" href="{{ 'section-ugc-images.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'section-ugc-images.css' | asset_url | stylesheet_tag }}</noscript>

<script>
  document.addEventListener('galleryReady:covetPics', function (e) {
    const widgets = document.querySelectorAll('covet-pics-widget, covet-pics-popup, covet-pics-upload');
    const widget = document.querySelector('covet-pics-widget');

    const widgetStyles = document.createElement('style');
    widgetStyles.innerHTML = `
    @media (min-width: 40em) {
      covet-pics-gallery-item {
        max-width: 25%;
        --covet-font-family: 'sweet-sans-pro', sans-serif;
      }
    }
    `;
    widget.shadowRoot.appendChild(widgetStyles);
    widgets.forEach((el) => {
      el.style.setProperty('--covet-pics-font-family', "'sweet-sans-pro', sans-serif");
      el.style.setProperty('--covet-font-family', "'sweet-sans-pro', sans-serif");
    });
  });
</script>

<style>
  .section-ugc-images {
    background-color: {{ section.settings.background_color }};
  }
</style>

{% comment %}theme-check-disable{% endcomment %}
{% assign found_a_gallery = false %}
{% assign gallery = product.metafields.global['Covet-Gallery'] %}
{% if gallery == 'true' %}
  {% assign found_a_gallery = true %}
{% endif %}
{% comment %}theme-check-enable{% endcomment %}

{%- assign grid_mobile_column = 'one-half' -%}
{%- assign grid_desktop_column = 'one-quarter' -%}

{%- if section.blocks.size >= 5 -%}
  {%- assign grid_desktop_column = section.blocks.size -%}
{%- endif -%}

{% if found_a_gallery == true or section.blocks.size > 1 %}
  <div class="section-outer section-ugc-images{% if section.settings.is_slider %} section-ugc-images-slider{% endif %}{% if section.settings.apply_new_style %} center-big-text{% endif %}{% if section.settings.section_full_width == "yes" %} section-ugc-content-full-w {% endif %} center{% if section.settings.hub_section != "" %} section-hub-content section-hub-{{ section.settings.hub_section }}{% endif %}">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="section-heading-outer page-width">
        {%- if section.settings.heading != blank -%}
          <h3 class="h2 heading heading-mobile section-heading">
            {{ section.settings.heading }}
          </h3>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <h4 class="intro section-subheading">{{ section.settings.subheading }}</h4>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="page-width">
      {% if section.settings.is_slider %}
        <slider-component class="{% unless section.settings.show_dots %} slider-hide-dots{% endunless %} ugc-slider">
          <ul class="list-unstyled slider grid grid-nowrap mobile-one desktop-one"
            id="Slider-{{ section.id }}"
            role="list"
          >
      {% else %}
        <div class="grid mobile-{{ grid_mobile_column }} desktop-{{ grid_desktop_column }}">
      {% endif %}
        {% if collection.metafields.custom.ugc_items %}
          {% assign metaobjects = collection.metafields.custom.ugc_items.value %}

          {% for item in metaobjects %}
            {% assign file = item.media %}
            {% assign file_url = file | file_url %}

            <{% if section.settings.is_slider %}li{% else %}div{% endif %} class="grid__item{% if section.settings.is_slider %} carousel-cell{% endif %}">
              {%- if item.link != blank -%}
                <a href="{{ item.link }}">
              {%- endif -%}

              {%- if file_url contains '.jpg' or file_url contains '.jpeg' or file_url contains '.png' or file_url contains '.webp' or file_url contains '.gif' -%}
                <div class="media media--square">
                  <img
                    srcset="
                      {%- if file.width >= 375 -%}{{ file | file_url: width: 375 }} 375w,{%- endif -%}
                      {%- if file.width >= 750 -%}{{ file | file_url: width: 750 }} 750w,{%- endif -%}
                      {%- if file.width >= 1100 -%}{{ file | file_url: width: 1100 }} 1100w,{%- endif -%}
                      {%- if file.width >= 1500 -%}{{ file | file_url: width: 1500 }} 1500w,{%- endif -%}
                      {%- if file.width >= 1780 -%}{{ file | file_url: width: 1780 }} 1780w,{%- endif -%}
                      {%- if file.width >= 2000 -%}{{ file | file_url: width: 2000 }} 2000w,{%- endif -%}
                      {%- if file.width >= 3000 -%}{{ file | file_url: width: 3000 }} 3000w,{%- endif -%}
                      {%- if file.width >= 3840 -%}{{ file | file_url: width: 3840 }} 3840w,{%- endif -%}
                    "
                    sizes="(min-width: 40em) 40vw, 80vw"
                    src="{{ file | file_url }}"
                    loading="lazy"
                    alt="{{ item.heading | escape }}"
                    width="{{ file.width }}"
                    height="{{ file.height }}"
                  >
                </div>

              {%- elsif file_url contains '.mp4' or file_url contains '.mov' -%}
                <div class="media media--square">
                  <video autoplay muted loop playsinline>
                    <source src="{{ file | file_url }}" type="video/mp4">
                  </video>
                </div>
              {%- endif -%}

              {%- if item.link != blank -%}
                </a>
              {%- endif -%}
            </{% if section.settings.is_slider %}li{% else %}div{% endif %}>
          {% endfor %}

        {% else %}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'image' -%}
                <{% if section.settings.is_slider %}li{% else %}div{% endif %} class="grid__item{% if section.settings.is_slider %} carousel-cell{% endif %}" {{ block.shopify_attributes }}>
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}">
                  {%- endif -%}
                  {% if block.settings.image != blank %}
                    <div class="media media--square">
                      <img
                        srcset="
                          {%- if block.settings.image.width >= 375 -%}{{ block.settings.image | image_url: width: 375 }} 375w,{%- endif -%}
                          {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
                          {%- if block.settings.image.width >= 1100 -%}{{ block.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
                          {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
                          {%- if block.settings.image.width >= 1780 -%}{{ block.settings.image | image_url: width: 1780 }} 1780w,{%- endif -%}
                          {%- if block.settings.image.width >= 2000 -%}{{ block.settings.image | image_url: width: 2000 }} 2000w,{%- endif -%}
                          {%- if block.settings.image.width >= 3000 -%}{{ block.settings.image | image_url: width: 3000 }} 3000w,{%- endif -%}
                          {%- if block.settings.image.width >= 3840 -%}{{ block.settings.image | image_url: width: 3840 }} 3840w,{%- endif -%}
                        "
                        sizes="(min-width: 40em) 40vw, 80vw"
                        src="{{ block.settings.image | image_url: width: 400 }}"
                        loading="lazy"
                        alt="{{ block.settings.image.alt | escape }}"
                        width="{{ block.settings.image.width }}"
                        height="{{ block.settings.image.width | divided_by: block.settings.image.aspect_ratio }}"
                      >
                    </div>
                  {% elsif request.design_mode %}
                    {%- assign placeholder = 'collection-' | append: forloop.index -%}
                    {{ placeholder | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                  {%- if block.settings.heading != blank -%}
                    {%- if block.settings.link != blank -%}
                      <h4 class="h5 arrow-hover">
                        {% render 'icon-arrow-right' %}
                        {{ block.settings.heading }}
                      </h4>
                    {%- else -%}
                      <h4 class="h5">{{ block.settings.heading }}</h4>
                    {%- endif -%}
                  {%- endif -%}
                  {%- if block.settings.link != blank -%}
                    </a>
                  {%- endif -%}
                </{% if section.settings.is_slider %}li{% else %}div{% endif %}>
              {%- when 'two_image' -%}
                <{% if section.settings.is_slider %}li{% else %}div{% endif %} class="grid__item grid__item-two-image{% if block.settings.link != blank %} has-link{% endif %} {% if section.settings.is_slider %} carousel-cell{% endif %}" {{ block.shopify_attributes }}>
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}">
                  {%- endif -%}
                  {% if block.settings.image != blank or block.settings.image_2 != blank %}
                    {% if block.settings.image != blank %}
                      <div class="media media--square media--primary">
                        <img
                          srcset="
                            {%- if block.settings.image.width >= 375 -%}{{ block.settings.image | image_url: width: 375 }} 375w,{%- endif -%}
                            {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
                            {%- if block.settings.image.width >= 1100 -%}{{ block.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
                            {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
                            {%- if block.settings.image.width >= 1780 -%}{{ block.settings.image | image_url: width: 1780 }} 1780w,{%- endif -%}
                            {%- if block.settings.image.width >= 2000 -%}{{ block.settings.image | image_url: width: 2000 }} 2000w,{%- endif -%}
                            {%- if block.settings.image.width >= 3000 -%}{{ block.settings.image | image_url: width: 3000 }} 3000w,{%- endif -%}
                            {%- if block.settings.image.width >= 3840 -%}{{ block.settings.image | image_url: width: 3840 }} 3840w,{%- endif -%}
                          "
                          sizes="(min-width: 40em) 40vw, 80vw"
                          src="{{ block.settings.image | image_url: width: 400 }}"
                          loading="lazy"
                          alt="{{ block.settings.image.alt | escape }}"
                          width="{{ block.settings.image.width }}"
                          height="{{ block.settings.image.width | divided_by: block.settings.image.aspect_ratio }}"
                        >
                      </div>
                    {% endif %}
                    {% if block.settings.image_2 != blank  %}
                      <div class="media media--square media--secondary">
                        <img
                          srcset="
                            {%- if block.settings.image_2.width >= 375 -%}{{ block.settings.image_2 | image_url: width: 375 }} 375w,{%- endif -%}
                            {%- if block.settings.image_2.width >= 750 -%}{{ block.settings.image_2 | image_url: width: 750 }} 750w,{%- endif -%}
                            {%- if block.settings.image_2.width >= 1100 -%}{{ block.settings.image_2 | image_url: width: 1100 }} 1100w,{%- endif -%}
                            {%- if block.settings.image_2.width >= 1500 -%}{{ block.settings.image_2 | image_url: width: 1500 }} 1500w,{%- endif -%}
                            {%- if block.settings.image_2.width >= 1780 -%}{{ block.settings.image_2 | image_url: width: 1780 }} 1780w,{%- endif -%}
                            {%- if block.settings.image_2.width >= 2000 -%}{{ block.settings.image_2 | image_url: width: 2000 }} 2000w,{%- endif -%}
                            {%- if block.settings.image_2.width >= 3000 -%}{{ block.settings.image_2 | image_url: width: 3000 }} 3000w,{%- endif -%}
                            {%- if block.settings.image_2.width >= 3840 -%}{{ block.settings.image_2 | image_url: width: 3840 }} 3840w,{%- endif -%}
                          "
                          sizes="(min-width: 40em) 40vw, 80vw"
                          src="{{ block.settings.image_2 | image_url: width: 400 }}"
                          loading="lazy"
                          alt="{{ block.settings.image_2.alt | escape }}"
                          width="{{ block.settings.image_2.width }}"
                          height="{{ block.settings.image_2.width | divided_by: block.settings.image_2.aspect_ratio }}"
                        >
                      </div>
                    {% endif %}
                  {% elsif request.design_mode %}
                    {%- assign placeholder = 'collection-' | append: forloop.index -%}
                    {{ placeholder | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                  {%- if block.settings.heading != blank -%}
                    {%- if block.settings.link != blank -%}
                      <h4 class="h5 arrow-hover">
                        {% render 'icon-arrow-right' %}
                        {{ block.settings.heading }}
                      </h4>
                    {%- else -%}
                      <h4 class="h5">{{ block.settings.heading }}</h4>
                    {%- endif -%}
                  {%- endif -%}
                  {%- if block.settings.link != blank -%}
                    </a>
                  {%- endif -%}
                </{% if section.settings.is_slider %}li{% else %}div{% endif %}>
              {%- when '@app' -%}
                {% if found_a_gallery == true %}
                  <div class="grid__item--full{% if section.settings.is_slider %} carousel-cell{% endif %}" {{ block.shopify_attributes }}>
                    {% render block %}
                  </div>
                {% endif %}
            {%- endcase -%}
          {%- endfor -%}
        {% endif %}
      
      {% if section.settings.is_slider %}
          </ul>
          <div class="slider-dots no-js-hidden">
            {% for dot in (1..section.blocks.size) %}
              <button
                type="button"
                data-index="{{ forloop.index }}"
                class="slider-dot{% if forloop.index0 == 0 %} is-active{% endif %}"
                name="index"
                aria-label="{{ 'accessibility.slide_index' | t: index: forloop.index }}"
              ></button>
            {% endfor %}
          </div>
          <div class="section-ugc-button">
            {%- if section.settings.label_view_all != blank and section.settings.link_view_all != blank -%}
              <div class="action-view-all">
                <a href="{{ section.settings.link_view_all }}"{% if section.settings.is_slider %} class="btn"{% endif %}>{{ section.settings.label_view_all }}</a>
              </div>
            {%- endif -%}
            <div class="slider-buttons no-js-hidden">
              <button
                type="button"
                class="slider-button slider-button--prev"
                name="previous"
                aria-label="{{ 'accessibility.previous_slide' | t }}"
              >
                {% unless section.settings.is_slider %}
                  {% render 'icon-arrow-left' %}
                {% else %}
                  <svg width="10" height="11" viewBox="0 0 10 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M9.85543 11C9.85543 10.6224 9.85543 10.2812 9.85543 10.2005C9.85543 10.1354 9.85543 10.0729 9.85543 10.0078L1.77124 5.44271L9.8879 0.989583C9.89151 0.638021 9.89872 0.302083 9.90233 0L0 5.43229L9.85543 11Z" fill="#231F20"/>
                              </svg>
                {% endunless %}

              </button>
              <div class="slider-counter caption">
                <span class="slider-counter--current">1</span>
                <span aria-hidden="true"> / </span>
                <span class="visually-hidden">{{ 'accessibility.of' | t }}</span>
                <span class="slider-counter--total">{{ section.blocks.size }}</span>
              </div>
              <button
                type="button"
                class="slider-button slider-button--next"
                name="next"
                aria-label="{{ 'accessibility.next_slide' | t }}"
              >
                {% unless section.settings.is_slider %}
                  {% render 'icon-arrow-right' %}
                {% else %}
                  <svg width="10" height="11" viewBox="0 0 10 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0.14462 0C0.14462 0.377604 0.14462 0.71875 0.14462 0.799479C0.14462 0.864583 0.14462 0.927083 0.14462 0.992187L8.22521 5.55729L0.108546 10.0104C0.104939 10.362 0.0977236 10.6979 0.0941162 11L9.99644 5.56771L0.14462 0Z" fill="#231F20"/>
                  </svg>
                {% endunless %}
              </button>
            </div>
          </div>
        </slider-component>
      {% else %}
        </div>
        {%- if section.settings.label_view_all != blank and section.settings.link_view_all != blank -%}
          <div class="action-view-all">
            <a href="{{ section.settings.link_view_all }}"{% if section.settings.is_slider %} class="btn"{% endif %}>{{ section.settings.label_view_all }}</a>
          </div>
        {%- endif -%}
      {% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "UGC Images",
  "tag": "section",
  "class": "spaced-section ugc-images",
  "settings": [
    {
      "type": "checkbox",
      "label": "Apply new style",
      "id": "apply_new_style",
    },
    {
      "type": "select",
      "id": "section_full_width",
      "label": "Is the section full width?",
      "options": [
        {
          "value": "no",
          "label": "No"
        },
        {
          "value": "yes",
          "label": "Yes"
        }
      ],
      "default": "no"
    },
    {
      "type": "checkbox",
      "id": "is_slider",
      "label": "Is slider?",
      "default": false
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "<div>Designed by Us, Styled by You.</div>"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "label_view_all",
      "label": "Label view all"
    },
    {
      "type": "url",
      "id": "link_view_all",
      "label": "Link view all"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F3F1EC"
    },
    {
      "type": "header",
      "content": "Design hub section"
    },
    {
      "type": "select",
      "id": "hub_section",
      "label": "Hub section",
      "options": [
        {
          "value": "",
          "label": "None"
        },
        {
          "value": "curtains",
          "label": "Curtains"
        },
        {
          "value": "pillows",
          "label": "Pillows"
        },
        {
          "value": "wallpaper",
          "label": "Wallpaper"
        }
      ],
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "two_image",
      "name": "Two image",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Image 2"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "#JustAddPepper",
      "settings": {
        "heading": "Designed by Us, Styled by You."
      },
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
