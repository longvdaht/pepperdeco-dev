<link rel="stylesheet" href="{{ 'section-image-columns.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'section-image-columns.css' | asset_url | stylesheet_tag }}</noscript>

{%- assign grid_mobile_column = section.settings.mobile_columns -%}
{%- assign grid_desktop_column = section.settings.desktop_columns -%}
{%- assign image_ratio = section.settings.image_ratio -%}

{% if template.suffix == 'reviews' %}
  <div class="page-width">
    <div class="border-top"></div>
  </div>
{% endif %}

<div class="section-outer section-image-columns image-columns-not-with {% if section.settings.section_full_width == "fw_no_padding" %} section-image-columns-full-w {% endif %} {% if section.settings.section_full_width == "fw_has_padding" %} section-image-columns-fw-has-p {% endif %} section-color-{{ section.settings.color_scheme }} center image-order-{{ section.settings.image_order }} {% if section.settings.hub_section != "" %} section-hub-content section-hub-{{ section.settings.hub_section }}{% endif %}">
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="section-heading-outer page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="{{ section.settings.heading_size }} body section-heading">
          {% render 'no-widows', content: section.settings.heading %}
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section-subheading intro">{% render 'no-widows', content: section.settings.subheading %}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="{% if section.settings.section_full_width == "no" %} page-width {% endif %}">
    {%- if section.settings.enable_slider -%}
      <slider-component
        class="{% unless section.settings.show_buttons %} slider-hide-buttons{% endunless %}{% unless section.settings.show_dots %} slider-hide-dots{% endunless %}"
      >
    {%- endif -%}
    <ul
      class="column-grid grid mobile-{{ grid_mobile_column }} desktop-{{ grid_desktop_column }}{% if section.settings.enable_slider %} slider grid-nowrap{% endif %} list-unstyled"
      id="Slider-{{ section.id }}"
      role="list"
    >
      {%- for block in section.blocks -%}
        <li
          class="{% if section.settings.enable_slider %}carousel-cell {% endif %}grid__item section-color-{{ section.settings.card_color_scheme }}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image != blank %}
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" rel="nofollow">
            {% endif %}
            <div
              class="media media--contain media--transparent media--{{ image_ratio }}"
              {% if image_ratio == 'adapt' and template.name != 'index' %}
                {% if section.settings.color_scheme == 'background-tertiary' and section.settings.card_color_scheme == 'background-primary' %}
                style="margin: 0 auto 1rem;max-width: 70%;padding-top: 70%;"
                {% else %}
                style="padding-bottom: {{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;"
                {% endif %}
              {% endif %}
            >
              <img
                srcset="
                  {%- if block.settings.image.width >= 250 -%}{{ block.settings.image | image_url: width: 250 }} 250w,{%- endif -%}
                  {%- if block.settings.image.width >= 480 -%}{{ block.settings.image | image_url: width: 480 }} 480w,{%- endif -%}
                  {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
                  {%- if block.settings.image.width >= 1100 -%}{{ block.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
                  {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
                  {%- if block.settings.image.width >= 1780 -%}{{ block.settings.image | image_url: width: 1780 }} 1780w,{%- endif -%}
                  {%- if block.settings.image.width >= 2000 -%}{{ block.settings.image | image_url: width: 2000 }} 2000w,{%- endif -%}
                  {%- if block.settings.image.width >= 3000 -%}{{ block.settings.image | image_url: width: 3000 }} 3000w,{%- endif -%}
                  {%- if block.settings.image.width >= 3840 -%}{{ block.settings.image | image_url: width: 3840 }} 3840w,{%- endif -%}
                "
                sizes="(min-width: 40em) 25vw, 15vw"
                src="{{ block.settings.image | image_url: width: 400 }}"
                loading="lazy"
                alt="{{ block.settings.image.alt | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.width | divided_by: block.settings.image.aspect_ratio }}"
              >
            </div>
            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          {% elsif request.design_mode %}
            {%- assign placeholder = 'product-' | append: forloop.index -%}
            {{ placeholder | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
          {%- if section.settings.show_numerals -%}
            <div class="h5 numerals">
              {{- forloop.index | prepend: '0' -}}
              .
            </div>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h3 class="h6">{% render 'no-widows', content: block.settings.heading %}</h3>
          {%- endif -%}
          {%- if block.settings.subheading != blank -%}
            {% render 'no-widows', content: block.settings.subheading %}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.enable_slider -%}
      </slider-component>
    {%- endif -%}

    {% if section.settings.link != blank %}
      <div class="center">
        <a href="{{ section.settings.link }}" class="button button--secondary">{{ section.settings.label }}</a>
      </div>
    {% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Image columns",
  "tag": "section",
  "class": "spaced-section image-columns",
  "settings": [
    {
      "type": "select",
      "id": "section_full_width",
      "label": "Is the section full width?",
      "options": [
        {
          "value": "no",
          "label": "No"
        },
        {
          "value": "fw_no_padding",
          "label": "Full width no padding"
        },
        {
          "value": "fw_has_padding",
          "label": "Full width has padding"
        }
      ],
      "default": "no"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h1",
          "label": "Heading 1"
        },
        {
          "value": "h2",
          "label": "Heading 2"
        },
        {
          "value": "h3",
          "label": "Heading 3"
        },
        {
          "value": "h4",
          "label": "Heading 4"
        }
      ],
      "default": "h3"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Aspect Ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "image_order",
      "label": "Image order",
      "options": [
        {
          "value": "image-first",
          "label": "Image first"
        },
        {
          "value": "image-last",
          "label": "Image last"
        }
      ],
      "default": "image-first"
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "Enable slider",
      "default": false
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        {
          "value": "one",
          "label": "One"
        },
        {
          "value": "one-half",
          "label": "Two"
        }
      ],
      "default": "one"
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop",
      "options": [
        {
          "value": "one",
          "label": "One"
        },
        {
          "value": "one-half",
          "label": "Two"
        },
        {
          "value": "one-third",
          "label": "Three"
        },
        {
          "value": "one-quarter",
          "label": "Four"
        },
        {
          "value": "one-fifth",
          "label": "Five"
        }
      ],
      "default": "one-third"
    },
    {
      "type": "select",
      "id": "card_color_scheme",
      "label": "Card color scheme",
      "options": [
        {
          "value": "background-primary",
          "label": "Primary"
        },
        {
          "value": "background-secondary",
          "label": "Secondary"
        },
        {
          "value": "background-tertiary",
          "label": "Tertiary"
        }
      ],
      "default": "background-primary"
    },
    {
      "type": "checkbox",
      "id": "show_numerals",
      "label": "Show card numbers",
      "default": false
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "background-primary",
          "label": "Primary"
        },
        {
          "value": "background-secondary",
          "label": "Secondary"
        },
        {
          "value": "background-tertiary",
          "label": "Tertiary"
        }
      ],
      "default": "background-primary"
    },
    {
      "type": "header",
      "content": "Design hub section"
    },
    {
      "type": "select",
      "id": "hub_section",
      "label": "Hub section",
      "options": [
        {
          "value": "",
          "label": "None"
        },
        {
          "value": "curtains",
          "label": "Curtains"
        },
        {
          "value": "pillows",
          "label": "Pillows"
        },
        {
          "value": "wallpaper",
          "label": "Wallpaper"
        }
      ],
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "(optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image columns",
      "settings": {
        "heading": "Custom Decor For Every Home",
        "subheading": "Here's how it works"
      },
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}