<link rel="stylesheet" href="{{ 'section-image-grid.css' | asset_url }}">

{%- if section.settings.enable_slider -%}
  <link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>
{%- endif -%}

<div class="section-outer section-image-grid section-color-{{ section.settings.color_scheme }} center">
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="section-heading-outer page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="h5 section-heading body">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section-subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="{% if section.settings.padded %} padded-extra{% endif %}">
    {%- if section.settings.enable_slider -%}
      <slider-component
        class="image-grid-carousel-outer slider-hide-buttons"
        {% if section.settings.autoplay %}
          data-autoplay="{{ section.settings.autoplay_timing | times: 1000 }}"
        {% endif %}
      >
        <ul class="list-unstyled slider grid grid-nowrap image-grid mobile-{{ section.settings.mobile_per_row }} desktop-{{ section.settings.desktop_per_row }}">
          {%- for block in section.blocks -%}
            <li class="grid__item carousel-cell" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="full-unstyled-link">
              {% endif %}
              {% if block.settings.image != blank %}
                <div
                  class="media media--transparent media--contain"
                  style="padding-bottom: {{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;"
                >
                  <img
                    srcset="
                      {%- if block.settings.image.width >= 375 -%}{{ block.settings.image | image_url: width: 375 }} 375w,{%- endif -%}
                      {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
                      {%- if block.settings.image.width >= 1100 -%}{{ block.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
                      {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
                      {%- if block.settings.image.width >= 1780 -%}{{ block.settings.image | image_url: width: 1780 }} 1780w,{%- endif -%}
                      {%- if block.settings.image.width >= 2000 -%}{{ block.settings.image | image_url: width: 2000 }} 2000w,{%- endif -%}
                      {%- if block.settings.image.width >= 3000 -%}{{ block.settings.image | image_url: width: 3000 }} 3000w,{%- endif -%}
                      {%- if block.settings.image.width >= 3840 -%}{{ block.settings.image | image_url: width: 3840 }} 3840w,{%- endif -%}
                    "
                    sizes="(min-width: 40em) calc(100vw / {{ section.settings.desktop_per_row }}), calc(100vw / {{ section.settings.mobile_per_row }})"
                    src="{{ block.settings.image | image_url: width: 400 }}"
                    loading="lazy"
                    alt="{{ block.settings.image.alt | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.width | divided_by: block.settings.image.aspect_ratio }}"
                  >
                </div>
              {% elsif request.design_mode %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
              {% if block.settings.link != blank %}
                </a>
              {% endif %}
            </li>
          {%- endfor -%}
        </ul>
        <div class="slider-buttons no-js-hidden">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'accessibility.previous_slide' | t }}"
          >
            {% render 'icon-arrow-left' %}
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'accessibility.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'accessibility.next_slide' | t }}"
          >
            {% render 'icon-arrow-right' %}
          </button>
        </div>
      </slider-component>
    {%- else -%}
      <div class="grid image-grid mobile-{{ section.settings.mobile_per_row }} desktop-{{ section.settings.desktop_per_row }}">
        {%- for block in section.blocks -%}
          <div class="grid__item" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="full-unstyled-link">
                {% if block.settings.link.title != blank %}
                  <div class="visually-hidden">{{ block.settings.link.title }}</div>
                {% elsif block.settings.image.alt != blank %}
                  <div class="visually-hidden">{{ block.settings.image.alt }}</div>
                {% endif %}
            {% endif %}
            {% if block.settings.image != blank %}
              <div
                class="media media--transparent media--contain"
                style="padding-bottom: {{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;"
              >
                <img
                  srcset="
                    {%- if block.settings.image.width >= 375 -%}{{ block.settings.image | image_url: width: 375 }} 375w,{%- endif -%}
                    {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
                    {%- if block.settings.image.width >= 1100 -%}{{ block.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
                    {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
                    {%- if block.settings.image.width >= 1780 -%}{{ block.settings.image | image_url: width: 1780 }} 1780w,{%- endif -%}
                    {%- if block.settings.image.width >= 2000 -%}{{ block.settings.image | image_url: width: 2000 }} 2000w,{%- endif -%}
                    {%- if block.settings.image.width >= 3000 -%}{{ block.settings.image | image_url: width: 3000 }} 3000w,{%- endif -%}
                    {%- if block.settings.image.width >= 3840 -%}{{ block.settings.image | image_url: width: 3840 }} 3840w,{%- endif -%}
                  "
                  sizes="(min-width: 40em) calc(100vw / {{ section.settings.desktop_per_row }}), calc(100vw / {{ section.settings.mobile_per_row }})"
                  src="{{ block.settings.image | image_url: width: 400 }}"
                  loading="lazy"
                  alt="{{ block.settings.image.alt | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.width | divided_by: block.settings.image.aspect_ratio }}"
                >
              </div>
            {% elsif request.design_mode %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Image grid",
  "tag": "section",
  "class": "spaced-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "checkbox",
      "id": "padded",
      "label": "Add extra mobile and desktop padding",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "Enable slider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay slides",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_timing",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "unit": "s",
      "label": "Autoplay timing",
      "default": 5
    },
    {
      "type": "range",
      "id": "desktop_per_row",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Desktop per row",
      "default": 4
    },
    {
      "type": "range",
      "id": "mobile_per_row",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Mobile per row",
      "default": 2
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "background-primary",
          "label": "Primary"
        },
        {
          "value": "background-secondary",
          "label": "Secondary"
        }
      ],
      "default": "background-secondary"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "(optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image grid",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
