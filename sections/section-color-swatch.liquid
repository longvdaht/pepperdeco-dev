{% if section.blocks.size > 0 %}
  <link rel="stylesheet" href="{{ 'section-color-swatch.css' | asset_url }}" media="print" onload="this.media='all'">

  <div class="section-color-swatch center" style="--background-color: {{ section.settings.background_color }}">
    <div class="section-heading-outer page-width page-width--narrow">
      {%- if section.settings.heading != blank -%}
        <h2 class="display section-heading body" id="additional-{{ section.settings.heading | handleize }}">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section-subheading" {% if section.settings.subheading_width != blank %}style="max-width: {{ section.settings.subheading_width | times: 1 }}px;"{% endif %}>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    <div class="color-swatch-wrapper page-width page-width--narrow">
      {% for swatch in section.blocks %}
        <div class="color-swatch-item ">
          <span class="swatch swatch-{{ swatch.settings.name | handle }}" style="--swatch-color: {{ swatch.settings.color }}; {% if swatch.settings.image != blank %}--swatch-image: url({{ swatch.settings.image | image_url: width: 100 }}){% endif %}"></span>
          {%- if swatch.settings.name != blank or swatch.settings.type != blank -%}
            <span class="swatch-title">
              {%- if swatch.settings.name != blank -%}
                <strong>{{ swatch.settings.name }}</strong>
              {%- endif -%}
              {%- if swatch.settings.type != blank -%}
                {{ swatch.settings.type }}
              {%- endif -%}
            </span>
          {%- endif -%}
        </div>
      {% endfor %}
    </div>
    {% if section.settings.button_text != blank %}
      <div class="color-swatch-action">
        <a href="{{ section.settings.button_link | default: '#' }}" class="button button--secondary">{{ section.settings.button_text }}</a>
      </div>
    {% endif %}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Section color swatch",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "color",
      "label": "Background color",
      "id": "background_color"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Furniture Welt Options"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find your perfect fabric+ welt combo by using the Trim tool in the product listing."
    },
    {
      "type": "text",
      "id": "subheading_width",
      "label": "Subheading width",
      "default": "400",
      "info": "Unit: px. Leave it blank to config full width"
    },
    {
      "type": "text",
      "label": "Button text",
      "id": "button_text"
    },
    {
      "type": "url",
      "label": "Button link",
      "id": "button_link"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "background-primary",
          "label": "Primary"
        },
        {
          "value": "background-secondary",
          "label": "Secondary"
        }
      ],
      "default": "background-secondary"
    }
  ],
  "blocks": [
    {
      "type": "color",
      "name": "Color",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "type",
          "label": "Type"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Section color swatch"
    }
  ]
}
{% endschema %}