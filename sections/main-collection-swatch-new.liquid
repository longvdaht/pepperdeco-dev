{% schema %}
{
  "name": "Swatch/Product grid new",
  "class": "spaced-section collection-grid-section section",
  "settings": [
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "Show second image on hover"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "default": false,
      "label": "Show price on card"
    },
    {
      "type": "checkbox",
      "id": "show_type",
      "default": false,
      "label": "Show type on card"
    },
    {
      "type": "header",
      "content": "Filtering and sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "checkbox",
      "id": "hide_color_filter",
      "label": "Hide color from filter"
    },
    {
      "type": "checkbox",
      "id": "hide_material_filter",
      "label": "Hide material type from filter"
    },
    {
      "type": "checkbox",
      "id": "hide_type_filter",
      "label": "Hide product type from filter"
    },
    {
      "type": "checkbox",
      "id": "hide_fabric_filter",
      "label": "Hide fabric type from filter"
    },
    {
      "type": "checkbox",
      "id": "hide_trim_filter",
      "label": "Hide trim type from filter"
    },
    {
      "type": "checkbox",
      "id": "hide_filter_silhouette",
      "label": "Hide Silhouette from filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_kidscolor_filter",
      "label": "Hide Kidscolor from filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_pricing_filter",
      "label": "Hide Pricing Tier from filter",
      "default": true
    },
    {
      "type": "header",
      "content": "Collection items per row"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        {
          "value": "one",
          "label": "One"
        },
        {
          "value": "one-half",
          "label": "Two"
        },
        {
          "value": "one-third",
          "label": "Three"
        }
      ],
      "default": "one-third"
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop items per row",
      "options": [
        {
          "value": "one",
          "label": "One"
        },
        {
          "value": "one-half",
          "label": "Two"
        },
        {
          "value": "one-third",
          "label": "Three"
        },
        {
          "value": "one-quarter",
          "label": "Four"
        },
        {
          "value": "one-fifth",
          "label": "Five"
        },
        {
          "value": "one-sixth",
          "label": "Six"
        }
      ],
      "default": "one-sixth"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "design_block",
      "name": "Design Card",
      "settings": [
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "info": "This cannot contain a link if the card link is set"
        }
      ]
    },
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "This will override products normally listed in the collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Swatch/Product grid new"
    }
  ]
}
{% endschema %}
