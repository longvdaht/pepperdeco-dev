<link rel="stylesheet" href="{{ 'section-image-content.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'section-image-with-text-split.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>{{ 'section-image-content.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'section-image-with-text-split.css' | asset_url | stylesheet_tag }}</noscript>

{%- assign grid_mobile_column = 'one' -%}
{%- assign grid_desktop_column = 'one-half' -%}

<div class="section-outer section-image-with-text-split section-color-{{ section.settings.color_scheme }} center" style="--background-color: {{ section.settings.background_color }}">
  <div class="full-width">
    <div class="grid mobile-{{ grid_mobile_column }} desktop-{{ grid_desktop_column }}">
      <div class="grid__item has-background-image text-split-wrapper image-desktop-align-{{ section.settings.desktop_alignment }}">
        {% assign text_above_blocks = section.blocks | where: 'type', 'text-above' %}
        {% if text_above_blocks.size > 0 %}
          <div class="text-above">
            {% for block in text_above_blocks %}
              <div class="section-content content-{{ block.type }} {{ section.settings.text_alignment }}">
                {%- if block.settings.heading != blank -%}
                  <h2 class="{{ block.settings.heading_size }} section-heading">
                    {% render 'no-widows', content: block.settings.heading %}
                  </h2>
                {%- endif -%}
                {%- if block.settings.subheading != blank -%}
                  <div class="rte section-subheading">
                    {% render 'no-widows', content: block.settings.subheading %}
                  </div>
                {%- endif -%}
                {%- if block.settings.content != blank -%}
                  <div class="rte rte-content">
                    {%- assign content = block.settings.content -%}
                    {% render 'no-widows', content: content -%}
                  </div>
                {%- endif -%}
                {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}" class="{% if section.settings.button_type == 'button' %}button button--secondary{% elsif section.settings.button_type == 'underline' %} button-link button--underline{% else %} button-link button--text{% endif %}">{{ block.settings.label }}</a>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.image != blank or section.settings.image_mobile != blank %}
          {% assign block_image = section.settings.image %}
          {% if section.settings.image_mobile != blank %}
            {% assign block_image = section.settings.image_mobile %}
          {% endif %}
          <div class="image-mobile">
            <div
              class="img-wrapper"
              {% comment %} style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;" {% endcomment %}
            >
              <img
                srcset="
                  {%- if block_image.width >= 375 -%}{{ block_image | image_url: width: 375 }} 375w,{%- endif -%}
                  {%- if block_image.width >= 750 -%}{{ block_image | image_url: width: 750 }} 750w,{%- endif -%}
                  {%- if block_image.width >= 1100 -%}{{ block_image | image_url: width: 1100 }} 1100w,{%- endif -%}
                  {%- if block_image.width >= 1500 -%}{{ block_image | image_url: width: 1500 }} 1500w,{%- endif -%}
                  {%- if block_image.width >= 1780 -%}{{ block_image | image_url: width: 1780 }} 1780w,{%- endif -%}
                  {%- if block_image.width >= 2000 -%}{{ block_image | image_url: width: 2000 }} 2000w,{%- endif -%}
                  {%- if block_image.width >= 3000 -%}{{ block_image | image_url: width: 3000 }} 3000w,{%- endif -%}
                  {%- if block_image.width >= 3840 -%}{{ block_image | image_url: width: 3840 }} 3840w,{%- endif -%}
                "
                sizes="(min-width: 40em) 40vw, 90vw"
                src="{{ block_image | image_url: width: 800 }}"
                loading="lazy"
                alt="{{ block_image.alt | escape }}"
                width="{{ block_image.width }}"
                height="{{ block_image.width | divided_by: block_image.aspect_ratio }}"
              >
            </div>
          </div>
        {% endif %}

        {% assign text_under_blocks = section.blocks | where: 'type', 'text-under' %}
        {% if text_under_blocks.size > 0 %}
          <div class="text-under">
            {% for block in text_under_blocks %}
              <div class="section-content content-{{ block.type }} {{ section.settings.text_alignment }}">
                {%- if block.settings.heading != blank -%}
                  <h2 class="{{ block.settings.heading_size }} section-heading">
                    {% render 'no-widows', content: block.settings.heading %}
                  </h2>
                {%- endif -%}
                {%- if block.settings.subheading != blank -%}
                  <div class="rte section-subheading">
                    {% render 'no-widows', content: block.settings.subheading %}
                  </div>
                {%- endif -%}
                {%- if block.settings.content != blank -%}
                  <div class="rte rte-content">
                    {%- assign content = block.settings.content -%}
                    {% render 'no-widows', content: content -%}
                  </div>
                {%- endif -%}
                {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}" class="{% if section.settings.button_type == 'button' %}button button--secondary{% elsif section.settings.button_type == 'underline' %} button-link button--underline{% else %} button-link button--text{% endif %}">{{ block.settings.label }}</a>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
      <div class="grid__item mobile-align-first desktop-align-{{ section.settings.desktop_alignment }} media--type-image">
        {% if section.settings.image != blank %}
          <div
            class="img-wrapper"
            {% comment %} style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;" {% endcomment %}
          >
            <img
              srcset="
                {%- if section.settings.image.width >= 375 -%}{{ section.settings.image | image_url: width: 375 }} 375w,{%- endif -%}
                {%- if section.settings.image.width >= 750 -%}{{ section.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
                {%- if section.settings.image.width >= 1100 -%}{{ section.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
                {%- if section.settings.image.width >= 1500 -%}{{ section.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
                {%- if section.settings.image.width >= 1780 -%}{{ section.settings.image | image_url: width: 1780 }} 1780w,{%- endif -%}
                {%- if section.settings.image.width >= 2000 -%}{{ section.settings.image | image_url: width: 2000 }} 2000w,{%- endif -%}
                {%- if section.settings.image.width >= 3000 -%}{{ section.settings.image | image_url: width: 3000 }} 3000w,{%- endif -%}
                {%- if section.settings.image.width >= 3840 -%}{{ section.settings.image | image_url: width: 3840 }} 3840w,{%- endif -%}
              "
              sizes="(min-width: 40em) 40vw, 90vw"
              src="{{ section.settings.image | image_url: width: 400 }}"
              loading="lazy"
              alt="{{ section.settings.image.alt | escape }}"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.width | divided_by: section.settings.image.aspect_ratio }}"
            >
          </div>
        {% elsif request.design_mode %}
          {{ 'collection-6' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with split text",
  "tag": "section",
  "class": "section-image-content-wrapper",
  "settings": [
    {
      "type": "color",
      "label": "Background color",
      "id": "background_color"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image mobile"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "desktop_alignment",
      "label": "Desktop image alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "background-primary",
          "label": "Primary"
        },
        {
          "value": "background-secondary",
          "label": "Secondary"
        }
      ],
      "default": "background-primary"
    }
  ],
  "blocks": [
    {
      "name": "Text above",
      "type": "text-above",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "richtext",
          "id": "subheading",
          "label": "Subheading",
          "default": "<p></p>"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "select",
          "label": "Button type",
          "id": "button_type",
          "default": "button",
          "options": [
            {
              "value": "button",
              "label": "Button"
            },
            {
              "value": "link",
              "label": "Link"
            },
            {
              "value": "underline",
              "label": "Underline"
            }
          ]
        }   
      ]
    },
    {
      "name": "Text under",
      "type": "text-under",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "richtext",
          "id": "subheading",
          "label": "Subheading",
          "default": "<p></p>"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "select",
          "label": "Button type",
          "id": "button_type",
          "default": "button",
          "options": [
            {
              "value": "button",
              "label": "Button"
            },
            {
              "value": "link",
              "label": "Link"
            },
            {
              "value": "underline",
              "label": "Underline"
            }
          ]
        } 
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with split text"
    }
  ]
}
{% endschema %}
