<link rel="stylesheet" href="{{ 'section-product-guides.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>{{ 'section-product-guides.css' | asset_url | stylesheet_tag }}</noscript>
<script src="{{ 'product-guides.js' | asset_url }}" defer="defer"></script>

<div class="section-color-{{ section.settings.color_scheme }} center">
  <div class="page-width">
    <div class="product-guide-top">
      <h2 class="product-guide-title">{{ section.settings.section_heading }}</h2>
      <div class="product-guide-des">
        {{ section.settings.content }}
      </div>
    </div>
    <div class="product-guide-main">
      <div class="product-guide-sidebar">
        <div class="guide-sidebar-label">Filter by:</div>
        <ul class="guide-sidebar-nav">
          {% assign count = 0 %}
          {% for block in section.blocks %}
            {% assign count = count | plus: 1 %}
            <li>
              <div class ="product-sidebar-item" data-sidebar="{{ count }}">{{ block.settings.title }}</div>
            </li>
          {% endfor %}
        </ul>
      </div>
      <div class="product-guide-content">
        {% assign count_tab = 0 %}
        {% for block in section.blocks %}
          {% assign count_tab = count_tab | plus: 1 %}
          <div id="{{ count_tab }}" class="product-guide-items">
            <h3 class="guide-item-title">{{ block.settings.title_content }}</h3>
            {% if block.settings.article_1 != blank %}
              {% assign article_image_1 = block.settings.cover_article_1 %}
              {% assign page_url = block.settings.article_1 %}
              {% assign url_parts = page_url | split: '/' %}
              {% if page_url contains 'blogs' %}
                {% assign trimmed_url = page_url | remove: '/blogs/' %}
                {% assign article_handle = trimmed_url %}
                {% assign article_object = articles[article_handle] %}
                <div class="product-guide-item">
                  <a href="{{ article_object.url }}">
                    <div class="product-guide-image">
                      {% if article_object.image != blank %}
                        {% assign article_image_1 = article_object.image %}
                      {% endif %}
                      <img src="{{ article_image_1 | img_url: '600x' }}" alt="{{ article_object.title }}"
                        width="{{ article_image_1.width }}"
                        height="{{ article_image_1.width | divided_by: article_image_1.aspect_ratio }}">
                    </div>
                    {% if section.settings.show_item_title %}
                      <div class="product-guide-name">{{ article_object.title }}</div>
                    {% endif %}
                  </a>
                </div>
              {% else %}
                {% assign page_url = block.settings.article_1 %}
                {% assign page_handle = page_url | split: '/' | last %}
                {% assign page_object = pages[page_handle] %}
                {% if page_object %}
                  <div class="product-guide-item">
                    <a href="{{ page_url }}">
                      <div class="product-guide-image">
                        {% if page_object.metafields.pages.featured_image.image != blank %}
                          {% assign article_image_1 = page_object.metafields.pages.featured_image.image %}
                        {% endif %}
                        <img src="{{ article_image_1 | img_url: '600x' }}" alt="{{ article_object.title }}"
                          width="{{ article_image_1.width }}"
                          height="{{ article_image_1.width | divided_by: article_image_1.aspect_ratio }}">
                      </div>
                      
                      {% if section.settings.show_item_title %}
                        <div class="product-guide-name">{{ page_object.title }}</div>
                      {% endif %}
                    </a>
                  </div>
                {% endif %}
              {% endif %}
            {% endif %}
