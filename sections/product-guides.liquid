                {% assign page_object = pages[page_handle] %}
                {% if page_object %}
                  <div class="product-guide-item">
                    <a href="{{ page_url }}">
                      <div class="product-guide-image">
                        {% if page_object.metafields.pages.featured_image.image != blank %}
                          {% assign article_image_12 = page_object.metafields.pages.featured_image.image %}
                        {% endif %}
                        <img src="{{ article_image_12 | img_url: '600x' }}" alt="{{ article_object.title }}"
                          width="{{ article_image_12.width }}"
                          height="{{ article_image_12.width | divided_by: article_image_12.aspect_ratio }}">
                      </div>
                      {% if section.settings.show_item_title %}
                        <div class="product-guide-name">{{ page_object.title }}</div>
                      {% endif %}
                    </a>
                  </div>
                {% endif %}
              {% endif %}
            {% endif %}
            <div class="product-guide-action"><a href="#" class="product-guide-item__see-all">
                <span class="read-more more">{{ 'general.read_more_title' | t }}</span>
                <span class="read-less less">{{ 'general.read_less_title' | t }}</span></a>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const tabTitles = document.querySelectorAll(".product-sidebar-item");
    const tabContents = document.querySelectorAll(".product-guide-items");

    tabTitles.forEach(function(title) {
      title.addEventListener("click", function() {
        const tabId = title.getAttribute("data-sidebar");

        tabTitles.forEach(function(title) {
          title.classList.remove("active");
        });
        title.classList.add("active");

        tabContents.forEach(function(content) {
          content.classList.remove("active");
          if (content.getAttribute("id") === tabId) {
            content.classList.add("active");
          }
        });
      });
    });

    // Activate the first tab by default
    if (tabTitles.length > 0) {
      tabTitles[0].click();
    }

    const actionReadmores = document.querySelectorAll(".product-guide-action .product-guide-item__see-all");

    actionReadmores.forEach(function(actionReadmore) {
      var items = actionReadmore.closest(".product-guide-items").querySelectorAll(".product-guide-item");
      if (items.length < 7) {
        actionReadmore.classList.add("hidden");
      }

      actionReadmore.addEventListener("click", function(e) {
       e.preventDefault();
    
        // Toggle the visibility of additional items
        let guideItems = actionReadmore.closest(".product-guide-items");
        guideItems.classList.toggle("show-all");
    
        // If it's now in "Read Less" mode (i.e., show-all class is removed)
        if (!guideItems.classList.contains("show-all")) {
          // Scroll smoothly to the top of the product guide section
          guideItems.scrollIntoView({
            behavior: "smooth",
            block: "start"
          });
        }
      });
    });
  });
</script>

