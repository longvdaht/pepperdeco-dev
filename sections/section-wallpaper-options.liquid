
<link rel="stylesheet" href="{{ 'section-wallpaper-options.css' | asset_url }}" media="print" onload="this.media='all'">

<style>
  .section-product-wallpaper-option {
    background-color: {{ section.settings.background_color }};
  }
</style>

{% assign wallpaper_options = product.metafields.custom.compare_wallpaper_options %}
{% if template.name == 'article' %}
  {% assign wallpaper_options = article.metafields.custom.compare_wallpaper_options %}
{% endif %}
{% if wallpaper_options.value %}
  {% assign count_items = 0 %}
  {% for index in wallpaper_options.value %}
    {% assign count_items = count_items | plus: 1 %}
  {% endfor %}
  <div
    class="section-outer section-product-wallpaper-option center"
    id="additional"
  >
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="section-heading-outer page-width">
        {%- if section.settings.heading != blank -%}
          <h2 class="display section-heading" id="additional-{{ section.settings.heading | handleize }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section-subheading intro" {% if section.settings.subheading_width != blank %}style="max-width: {{ section.settings.subheading_width | times: 1 }}px;"{% endif %}>{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="section-product-wallpaper-option-content page-width">
      <slider-component>
        <ul class="slider slider--everywhere product-slider-mobile product-slider-{{ count_items }}-items" role="list" id="Slider-wallpaper-{{ section.id }}">
          {% for item in wallpaper_options.value %}
            <li id="Slide-{{ item.name | handle }}" class="slide__mobile section-product-option-wrapper">
              <div class="wallpaper-option-block-wrapper">
                <div class="wallpaper-option-block">
                  <div class="wallpaper-option-top">
                    <div class="wallpaper-option-top-top">
                      <img src="{{ item.image | image_url: width: 400 }}" width="400" height="400" alt="{{ item.name }}"/>
                      <h2 class="wallpaper-title h1 body">{{ item.name }}</h2>
                      <div class="rte price-content-wrapper">
                        {{ item.price | metafield_tag }}
                      </div>
                    </div>
                    <div class="rte content-wrapper">
                      {% assign raw_content = item.content | metafield_tag %}
                      {% assign split_key = '<p><strong>INSTALLATION:</strong></p>' %}
                      {% assign parts = raw_content | split: split_key %}

                      {{ parts[0] }}

                      {% if parts[1] %}
                      <details  class="content-toggle">
                        <summary>
                          <span class="content-toggle-close">Show more</span>
                          <span class="content-toggle-open">Show less</span>
                          {% render 'icon-chevron-down' %}
                        </summary>
                        <div class="metafield-more__content">
                          {{ split_key }}{{ parts[1] }}
                        </div>
                      </details>
                      {% endif %}
                    </div>
                  </div>
                  {%  if item.button_text != blank %}
                    <a href="{{ item.button_link | default: '#' }}" class="button" title="{{ item.button_text }}">
                      {{ item.button_text }}
                    </a>
                  {% endif %}
                </div>
              </div>
            </li>
          {% endfor %}
        </ul>
        <div class="slider-buttons no-js-hidden {% if wallpaper_options.value.size <= 1 %} visually-hidden{% endif %}">
          <button
            type="button"
            class="slider-button slider-button--prev slider-mobile-box"
            name="previous"
            aria-label="{{ 'accessibility.previous_slide' | t }}"
          >
            {% render 'icon-arrow-left' %}
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'accessibility.of' | t }}</span>
            <span class="slider-counter--total">3</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next slider-mobile-box"
            name="next"
            aria-label="{{ 'accessibility.next_slide' | t }}"
          >
            {% render 'icon-arrow-right' %}
          </button>
        </div>
      </slider-component>
    </div>
  </div>
{% endif %}

<script>
  (function () {
    const CARD_SELECTOR = '.section-product-wallpaper-option .wallpaper-option-block-wrapper';
    const FIELD_LABELS = ['PRICE', 'WIDTH', 'BEST USE', 'GROUND', 'WEIGHTS', 'DOUBLE RUBS', 'GROUND COLOR', 'TEXTURE', 'INSTALLATION', 'ECO-FRIENDLY QUALITIES'];

    function normalizeLabel(text) {
      return text.replace(/[:\s]+$/, '').trim().toUpperCase();
    }

    function findFieldBlocks(card) {
      const blocks = new Map(); // label -> element
      card.querySelectorAll('strong').forEach((strong) => {
        const label = normalizeLabel(strong.textContent);
        if (!FIELD_LABELS.includes(label)) return;

        var block = strong.closest('p, div') || strong.parentElement;
        if (label == 'INSTALLATION' || label == 'ECO-FRIENDLY QUALITIES') {
          const blockParent = strong.closest('p, div') || strong.parentElement;
          block = blockParent.nextElementSibling;
        }

        blocks.set(label, block);
      });
      return blocks;
    }

    function equalizeHeights() {
      const cards = Array.from(document.querySelectorAll(CARD_SELECTOR));
      if (!cards.length) return;

      const allBlocks = cards.map(findFieldBlocks);

      allBlocks.forEach((map) => map.forEach((el) => (el.style.minHeight = '')));
      void document.body.offsetHeight; // ép reflow

      const maxByLabel = {};
      FIELD_LABELS.forEach((label) => {
        let max = 0;
        allBlocks.forEach((map) => {
          const el = map.get(label);
          if (el) max = Math.max(max, el.getBoundingClientRect().height);
        });
        maxByLabel[label] = max;
      });

      allBlocks.forEach((map) => {
        map.forEach((el, label) => {
          if (maxByLabel[label]) el.style.minHeight = maxByLabel[label] + 'px';
        });
      });
    }

    function debounce(fn, wait) {
      let t;
      return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), wait); };
    }
    const debouncedEqualize = debounce(equalizeHeights, 150);

    window.addEventListener('load', equalizeHeights);
    window.addEventListener('resize', debouncedEqualize);
    document.addEventListener('DOMContentLoaded', equalizeHeights);
    
  })();
</script>

{% schema %}
{
  "name": "Section wallpaper options",
  "tag": "section",
  "enabled_on": {
    "templates": ["product", "article"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Using metafield Wallpaper options."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wallpaper Options"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore the options below to find the perfect wallpaper for your space."
    },
    {
      "type": "text",
      "id": "subheading_width",
      "label": "Subheading width",
      "default": "400",
      "info": "Unit: px. Leave it blank to config full width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F3F1EC"
    }
  ],
  "presets": [
    {
      "name": "Section wallpaper options"
    }
  ]
}
{% endschema %}
