<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-article-card.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-article-card.css' | asset_url | stylesheet_tag }}</noscript>

<style>
  .section-featured-articles.section-outer {
    padding-bottom: 3rem;
    padding-top: 3rem;
  }
  .section-featured-articles .page-width {
    max-width: calc(var(--page-width) * 1.075);
  }
  .section-featured-articles .section-heading {
    margin: 0 auto 1rem;
  }
  .section-featured-articles .section-subheading.intro {
    margin: 0 auto;
    max-width: 30rem;
  }
  .section-featured-articles .section-cta {
    margin: 2rem auto 0;
  }
  .section-featured-articles slider-component .grid .grid__item {
    flex: 1 0 calc(100% / 2.4);
  }
  @media (min-width: 40em) {
    .section-featured-articles.section-outer {
      padding-bottom: 5rem;
    }
    .section-featured-articles slider-component .grid .grid__item {
      flex: 1 0 calc(100% / 5);
    }
  }
</style>

{%- assign grid_mobile_column = section.settings.mobile_per_row -%}
{%- assign grid_desktop_column = section.settings.desktop_per_row -%}

<div class="section-outer section-featured-articles section-color-{{ section.settings.color_scheme }}">
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="section-heading-outer page-width center">
      {%- if section.settings.heading != blank -%}
        <h2 class="h4 section-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section-subheading intro">{% render 'no-widows', content: section.settings.subheading %}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="page-width">
    {% if section.settings.slider %}
      <slider-component
        class="{% unless section.settings.show_buttons %}slider-hide-buttons {% endunless %}{% unless section.settings.show_dots %}slider-hide-dots {% endunless %}section-hero-carousel section-color-{{ section.settings.color_scheme }} center"
      >
    {% endif %}
    <ul
      class="list-unstyled slider grid grid-nowrap mobile-{{ grid_mobile_column }} desktop-{{ grid_desktop_column }}"
      id="Slider-{{ section.id }}"
      role="list"
    >
      {%- for block in section.blocks -%}
        <li class="grid__item carousel-cell" {{ block.shopify_attributes }}>
          {% render 'article-card',
            article: block.settings.article,
            mobile_per_row: grid_mobile_column,
            desktop_per_row: grid_desktop_column,
            squiggle: true
          %}
        </li>
      {%- endfor -%}
    </ul>
    {% if section.blocks.size > 1 %}
      <div class="slider-dots no-js-hidden">
        {% for dot in (1..section.blocks.size) %}
          <button
            type="button"
            data-index="{{ forloop.index }}"
            class="slider-dot{% if forloop.index0 == 0 %} is-active{% endif %}"
            name="index"
            aria-label="{{ 'accessibility.slide_index' | t: index: forloop.index }}"
          ></button>
        {% endfor %}
      </div>
      <div class="slider-buttons no-js-hidden">
        <button
          type="button"
          class="slider-button slider-button--prev"
          name="previous"
          aria-label="{{ 'accessibility.previous_slide' | t }}"
        >
          {% render 'icon-arrow-left' %}
        </button>
        <div class="slider-counter caption">
          <span class="slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="visually-hidden">{{ 'accessibility.of' | t }}</span>
          <span class="slider-counter--total">{{ section.blocks.size }}</span>
        </div>
        <button
          type="button"
          class="slider-button slider-button--next"
          name="next"
          aria-label="{{ 'accessibility.next_slide' | t }}"
        >
          {% render 'icon-arrow-right' %}
        </button>
      </div>
    {% endif %}
    {% if section.settings.slider %}
      </slider-component>
    {% endif %}
  </div>
  {%- if section.settings.link != blank and section.settings.label != blank -%}
    <div class="section-cta page-width center">
      <a href="{{ section.settings.link }}" class="button button--secondary">{{ section.settings.label }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Featured articles",
  "tag": "section",
  "class": "spaced-section no-x",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "desktop_per_row",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Desktop per row",
      "default": 5
    },
    {
      "type": "range",
      "id": "mobile_per_row",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Mobile per row",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "slider",
      "label": "Show carousel",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_buttons",
      "label": "Show buttons",
      "default": false
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "See All"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "background-primary",
          "label": "Primary"
        },
        {
          "value": "background-secondary",
          "label": "Secondary"
        }
      ],
      "default": "background-secondary"
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Article",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured articles",
      "settings": {
        "heading": "Styleguides",
        "subheading": "Get some room inspo with our curated guides",
        "link": "/blogs/pep-talk/tagged/style-guides",
        "label": "See All"
      },
      "blocks": [
        {
          "type": "article"
        },
        {
          "type": "article"
        },
        {
          "type": "article"
        },
        {
          "type": "article"
        },
        {
          "type": "article"
        }
      ]
    }
  ]
}
{% endschema %}
