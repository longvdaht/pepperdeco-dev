<style>
  .spaced-section .section-simple.section-simple-new.section-outer {
    padding: 5rem 6rem;
  }
  .section-simple.section-simple-new .section-subheading.intro {
    font-family: var(--font-body-family);
    font-weight: var(--font-button-weight);
    font-size: 1.1rem;
    line-height: 2.1rem;
    letter-spacing: var(--font-body-spacing);
  }
  .section-simple.section-simple-new .rte > p {
    font-size: 1.3rem;
    line-height: 1.8rem;
    letter-spacing: .05rem;
  }
  .template-index .section-simple.spaced-section .section-outer {
    padding: 5rem 2rem 7rem;
  }
  .template-index .section-simple.section-simple-new .button {
    margin-block-start: 2.5rem;
    padding-inline: 7rem;
  }
  .section-simple.section-simple-new .section-heading {
    font-size: 3.8rem;
    letter-spacing: normal;
    line-height: 4.6rem;
    margin: 1rem 0;
    padding: 0;
    font-weight: 100;
    text-transform: initial;
  }
  #shopify-section-template--16176832249916__simple_7TUkxJ .rte {
    padding-inline: 5rem;
  }
  #shopify-section-template--16176832249916__simple_Hr7xVj .section-outer {
    background-position: center center;
    padding: 5rem 2rem;
  }
  @media (min-width: 60em) {
    #shopify-section-template--16176832249916__simple_Hr7xVj .section-outer {
      padding: 10rem 2rem 7rem;
    }
    .section-simple.section-simple-new .rte {
      padding-inline: 6rem;
    }
  }
</style>

<div
  class="section-outer section-simple section-simple-new section-hero-text section-color-{{ section.settings.color_scheme }} center {% if section.settings.background_image != blank %} section-background-image{% endif %}"
  {% if section.settings.background_image != blank %}
    style="background-image: url('{{ section.settings.background_image | image_url: width: 1000  }}')"
  {% endif %}
>
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="section-heading-outer page-width">
      {%- if section.settings.subheading != blank -%}
        <div class="section-subheading intro">
          {% if section.settings.subheading != blank %}
            {{ section.settings.subheading }}
          {% endif %}
        </div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-heading">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
      {%- if section.settings.content != blank -%}
        <div class="rte page-width page-width-narrow">
          {{ section.settings.content }}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Hero Text",
  "tag": "section",
  "class": "section-simple spaced-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "background-primary",
          "label": "Primary"
        },
        {
          "value": "background-secondary",
          "label": "Secondary"
        },
        {
          "value": "background-tertiary",
          "label": "Tertiary"
        }
      ],
      "default": "background-primary"
    }
  ],
  "presets": [
    {
      "name": "Hero Text",
      "settings": {
      }
    }
  ]
}
{% endschema %}
