<link rel="stylesheet" href="{{ 'section-simple.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'section-simple.css' | asset_url | stylesheet_tag }}</noscript>

{% if template.suffix == 'reviews' %}
  <div class="page-width">
    <div class="border-top"></div>
  </div>
{% endif %}

<div
  class="section-outer section-simple section-color-{{ section.settings.color_scheme }} center{% if section.settings.hub_section != "" %} section-hub-content section-hub-{{ section.settings.hub_section }}{% endif %}{% if section.settings.background_image != blank %} section-background-image{% endif %}{% if section.settings.background_image != blank and section.settings.invert_text %} section-invert-text{% endif %}"
  {% if section.settings.background_image != blank %}
    style="background-image: url('{{ section.settings.background_image | image_url: width: 2000  }}')"
  {% endif %}
>
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="section-heading-outer page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-heading body h6">
          {%- assign heading_content = section.settings.heading
            | replace: 'Decor, ', 'Decor, <br class="hide-on-desktop">'
          -%}
          {% render 'no-widows', content: heading_content %}
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="section-subheading intro">{% render 'no-widows', content: section.settings.subheading %}</div>
      {%- endif -%}
      {%- if section.settings.content != blank -%}
        <div class="rte page-width page-width-narrow">
          {% render 'no-widows', content: section.settings.content %}
        </div>
      {%- endif -%}
      {% if section.settings.link != blank and section.settings.label != blank %}
        <a href="{{ section.settings.link }}" class="button button--secondary">{{ section.settings.label }}</a>
      {% endif %}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Simple",
  "tag": "section",
  "class": "section-simple spaced-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "(optional)"
    },
    {
      "type": "checkbox",
      "id": "invert_text",
      "label": "Invert text",
      "default": false,
      "info": "Requires darkened image"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "background-primary",
          "label": "Primary"
        },
        {
          "value": "background-secondary",
          "label": "Secondary"
        },
        {
          "value": "background-tertiary",
          "label": "Tertiary"
        }
      ],
      "default": "background-primary"
    },
    {
      "type": "header",
      "content": "Design hub section"
    },
    {
      "type": "select",
      "id": "hub_section",
      "label": "Hub section",
      "options": [
        {
          "value": "",
          "label": "None"
        },
        {
          "value": "curtains",
          "label": "Curtains"
        },
        {
          "value": "pillows",
          "label": "Pillows"
        },
        {
          "value": "wallpaper",
          "label": "Wallpaper"
        }
      ],
      "default": ""
    }
  ],
  "presets": [
    {
      "name": "Simple",
      "settings": {
        "heading": "Custom Decor For Every Home",
        "subheading": "<p>Here's how it works</p>"
      }
    }
  ]
}
{% endschema %}
