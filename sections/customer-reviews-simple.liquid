<link rel="stylesheet" href="{{ 'section-customer-reviews.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-card.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-rte.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>{{ 'section-customer-reviews.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-card.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-rte.css' | asset_url | stylesheet_tag }}</noscript>

<div class="section-outer section-customer-reviews section-customer-reviews--simple section-color-{{ section.settings.color_scheme }}{% if section.settings.hub_section != "" %} section-review-{{ section.settings.hub_section }}{% endif %}">
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="section-heading-outer page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="{{ section.settings.heading_size }} display section-heading">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section-subheading intro">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
  <slider-component class="{% unless section.settings.show_buttons %} slider-hide-buttons {% endunless %}{% unless section.settings.show_dots %} slider-hide-dots {% endunless %} review-slider">
    <ul
      class="list-unstyled slider grid grid-nowrap mobile-one desktop-one"
      id="Slider-{{ section.id }}"
      role="list"
    >
      {% for block in section.blocks %}
        <li
          class="grid__item carousel-cell"
          {{ block.shopify_attributes }}
        >
          <div class="card-stars">
            {% assign stars = block.settings.stars | floor %}
            {% for star in (1..stars) %}
              {% render 'icon-star' %}
            {% endfor %}
          </div>
          <div class="serif">&ldquo;{{ block.settings.content | strip_html }}&rdquo;</div>
          <div class="h6 card-review-info">
            {{ block.settings.source -}}
            {%- if block.settings.product != blank %}, {{ block.settings.product.title }}{% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
    <div class="slider-dots no-js-hidden">
      {% for dot in (1..section.blocks.size) %}
        <button
          type="button"
          data-index="{{ forloop.index }}"
          class="slider-dot{% if forloop.index0 == 0 %} is-active{% endif %}"
          name="index"
          aria-label="{{ 'accessibility.slide_index' | t: index: forloop.index }}"
        ></button>
      {% endfor %}
    </div>
    <div class="section-review-button">
      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link | default: '#' }}" class="btn">{{ section.settings.button_text }}</a>
      {% endif %}
      <div class="slider-buttons no-js-hidden">
        <button
          type="button"
          class="slider-button slider-button--prev"
          name="previous"
          aria-label="{{ 'accessibility.previous_slide' | t }}"
        >
          {% if section.settings.hub_section == "" %}
            {% render 'icon-arrow-left' %}
          {% else %}
            
            <svg width="10" height="11" viewBox="0 0 10 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M9.85543 11C9.85543 10.6224 9.85543 10.2812 9.85543 10.2005C9.85543 10.1354 9.85543 10.0729 9.85543 10.0078L1.77124 5.44271L9.8879 0.989583C9.89151 0.638021 9.89872 0.302083 9.90233 0L0 5.43229L9.85543 11Z" fill="#231F20"/>
                        </svg>
          {% endif %}

        </button>
        <div class="slider-counter caption">
          <span class="slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="visually-hidden">{{ 'accessibility.of' | t }}</span>
          <span class="slider-counter--total">{{ section.blocks.size }}</span>
        </div>
        <button
          type="button"
          class="slider-button slider-button--next"
          name="next"
          aria-label="{{ 'accessibility.next_slide' | t }}"
        >
          {% if section.settings.hub_section == "" %}
            {% render 'icon-arrow-right' %}
          {% else %}
            <svg width="10" height="11" viewBox="0 0 10 11" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0.14462 0C0.14462 0.377604 0.14462 0.71875 0.14462 0.799479C0.14462 0.864583 0.14462 0.927083 0.14462 0.992187L8.22521 5.55729L0.108546 10.0104C0.104939 10.362 0.0977236 10.6979 0.0941162 11L9.99644 5.56771L0.14462 0Z" fill="#231F20"/>
            </svg>
          {% endif %}
        </button>
      </div>
    </div>
  </slider-component>
</div>

{% schema %}
{
  "name": "Customer reviews simple",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "background-primary",
          "label": "Primary"
        },
        {
          "value": "background-secondary",
          "label": "Secondary"
        },
        {
          "value": "background-tertiary",
          "label": "Tertiary"
        }
      ],
      "default": "background-secondary"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_buttons",
      "label": "Show buttons",
      "default": true
    },
    {
      "type": "header",
      "content": "Design hub section"
    },
    {
      "type": "select",
      "id": "hub_section",
      "label": "Hub section",
      "options": [
        {
          "value": "",
          "label": "None"
        },
        {
          "value": "design-assistance",
          "label": "Design assistance"
        }
      ],
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "review",
      "name": "Customer review",
      "limit": 10,
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Review content"
        },
        {
          "type": "text",
          "id": "source",
          "label": "Reviewer Name",
          "placeholder": "Reviewer Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer reviews simple",
      "settings": {
      }
    }
  ]
}
{% endschema %}
