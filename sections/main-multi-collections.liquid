{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{{ 'component-rte.css' | asset_url | stylesheet_tag: preload: true }}

<script src="{{ 'collection-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'collection-custom-filters.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  if section.settings.show_color_filter == false and section.settings.show_pattern_filter == false and section.settings.show_type_filter == false and section.settings.show_material_filter == false
    assign filters = false
  else
    assign filters = true
  endif
-%}

{%- assign parent_collection = collection -%}

{%- assign grid_mobile_column = section.settings.mobile_columns -%}
{%- assign grid_desktop_column = section.settings.desktop_columns -%}

{% assign enable_sorting = false %}
{% if section.blocks.size == 0 and section.settings.enable_sorting %}
  {% assign enable_sorting = true %}
{% endif %}

{%- if enable_sorting and section.settings.filter_type == 'vertical' -%}
  <facet-filters-form class="facets facets-vertical-sort page-width small-hide">
    <form class="facets-vertical-form" id="FacetSortForm">
      <div class="facet-filters sorting caption">
        <div class="facet-filters__field">
          <h2 class="facet-filters__label caption-large text-body">
            <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
          </h2>
          <div class="select">
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            <select
              name="sort_by"
              class="facet-filters__sort select__select caption-large"
              id="SortBy"
              aria-describedby="a11y-refresh-page-message"
            >
              {%- for option in collection.sort_options -%}
                <option
                  value="{{ option.value | escape }}"
                  {% if option.value == sort_by %}
                    selected="selected"
                  {% endif %}
                >
                  {{ option.name | escape }}
                </option>
              {%- endfor -%}
            </select>
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </div>
        </div>
      </div>

      <div class="product-count-vertical light" role="status">
        <h2 class="product-count__text text-body">
          <span id="ProductCountDesktop">
            {%- if collection.results_count -%}
              {{
                'templates.search.results_with_count'
                | t: terms: collection.terms, count: collection.results_count
              }}
            {%- elsif collection.products_count == collection.all_products_count -%}
              {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
            {%- else -%}
              {{
                'products.facets.product_count'
                | t: product_count: collection.products_count, count: collection.all_products_count
              }}
            {%- endif -%}
          </span>
        </h2>
        {%- render 'loading-spinner' -%}
      </div>
    </form>
  </facet-filters-form>
{%- endif -%}
<div class="section-{{ section.id }}-padding main-collection-swatch-grid-section main-multi-collections-section{% if section.settings.collection_layout == 'slider' and section.blocks.size > 0 %} main-multi-collection-slider{% endif %}">
  {% if section.blocks.size > 0 %}
  <collection-filters class="swatch-collection-filter{% if section.settings.filter_type == 'vertical' %} facets-vertical page-width{% endif %}">
  {% endif %}
    {{ 'component-facets.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
    {%- if section.settings.enable_filtering or enable_sorting -%}
      <aside
        aria-labelledby="verticalTitle"
        class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
        id="main-collection-filters"
        data-id="{{ section.id }}"
      >
        {% render 'facets',
          results: collection,
          enable_filtering: section.settings.enable_filtering,
          enable_sorting: enable_sorting,
          enable_grid_view: section.settings.enable_grid_view_mobile,
          filter_type: 'horizontal',
          paginate: paginate
        %}
      </aside>
    {%- endif -%}
    {% if section.blocks.size > 0 %}
      </collection-filters>
    {% endif %}


  <div id="ProductGridContainer" class="product-grid-container" data-id="{{ section.id }}">
    <div class="collection {% if section.settings.collection_layout == 'slider' and section.blocks.size > 0 %}collection-slider-wrapper{% endif %}{% if filters == false %} no-filters{% endif %}">
      <div class="loading-overlay"></div>

      <collection-form>
        <a href="#" class="scroll-to-top" onclick="window.scrollTo(0, 0);">
          <div>
            <i class="fa-sharp fa-solid fa-chevron-up"></i>
            <div class="scroll-text">to top</div>
          </div>
        </a>
        {%- unless section.blocks.size > 0 -%}
          <div class="collection-block-wrapper">
            <div class="page-width">
              <ul
                id="main-collection-product-grid"
                data-id="{{ section.id }}"
                class="grid mobile-{{ grid_mobile_column }} desktop-{{ grid_desktop_column }} product-grid list-unstyled"
              >
                {% comment %} Set up index for design card blocks {% endcomment %}
                {% assign limit_product = section.settings.product_limit %}
                {% assign desktop_hide = false %}
                {% if section.settings.product_limit_mobile > section.settings.product_limit %}
                  {% assign limit_product = section.settings.product_limit_mobile %}
                  {% assign desktop_hide = true %}
                {% endif %}
                {% assign mobile_hide = false %}
                {% if section.settings.product_limit_mobile < section.settings.product_limit %}
                  {% assign limit_product = section.settings.product_limit %}
                  {% assign mobile_hide = true %}
                {% endif %}


                {%- for product in collection.products limit: limit_product -%}
                  {% assign product_limit_class = '' %}
                  {% if desktop_hide and forloop.index > section.settings.product_limit %} 
                    {% assign product_limit_class = 'desktop-hide' %}
                  {% endif %}
                  {% if mobile_hide and forloop.index > section.settings.product_limit_mobile %} 
                    {% assign product_limit_class = 'mobile-hide' %}
                  {% endif %}

                  <li class="grid__item grid__item-product-card center {{ product_limit_class }}">
                    {% render 'card-product',
                      card_product: product,
                      media_aspect_ratio: section.settings.image_ratio,
                      image_shape: section.settings.image_shape,
                      show_secondary_image: section.settings.show_secondary_image,
                      show_price: section.settings.show_price,
                      show_vendor: section.settings.show_vendor,
                      show_rating: section.settings.show_rating,
                      lazy_load: lazy_load,
                      skip_styles: skip_card_product_styles,
                      quick_add: section.settings.quick_add,
                      section_id: section.id,
                      show_product_type: section.settings.show_product_type,
                      show_color_switch_option: section.settings.show_color_switch_option
                    %}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          </div>
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'collection' -%}
                {%- assign collection = collections[block.settings.collection] -%}
                {% assign has_desc = false %}
                {% if block.settings.collection_description != blank or collection.description %}
                  {% assign has_desc = true %}
                {% endif %}
                <div
                  class="collection-block-wrapper{% unless has_desc %} no-desc{% endunless %} "
                  data-products="{{ collection.all_products_count }}"
                  {{ block.shopify_attributes }}
                  style="background-color: {{ block.settings.background_color }}"
                >
                  <div class="section-heading-outer{% if section.settings.collection_layout == 'grid' %} page-width{% endif %}">
                      {%- if block.settings.collection_title != blank -%}
                        {% assign collection_title = block.settings.collection_title %}
                      {%- else -%}
                        {% assign collection_title = collection.title %}
                      {%- endif -%}
                    <div class="section-subheading-wrapper">
                      <h2 class="h2 section-heading {% unless block.settings.title_as_link %} non-link{% endunless %}">
                        {% if block.settings.title_as_link %}<a href="{{ collection.url }}" title="{{ collection_title }}">{% endif %}
                          <span>{{ collection_title }}</span>
                        {% if block.settings.title_as_link %}</a>{% endif %}
                      </h2>
                    </div>
                    
                    <div class="section-subheading intro">
                      {%- if block.settings.collection_description != blank -%}
                        {{ block.settings.collection_description }}
                      {%- elsif collection.metafields.custom.mobile_subtitle != blank -%}
                        <div class="section-subheading intro desktop-hide">
                          {{ collection.metafields.custom.mobile_subtitle }}
                        </div>
                        <div class="section-subheading intro mobile-hide">
                          {{ collection.description | strip_html }}
                        </div>
                      {%- else -%}
                        <div class="section-subheading intro">
                          {{ collection.description | strip_html }}
                        </div>
                      {%- endif -%}
                      
                      <div class="button-wrapper-top mobile-hide">
                        <a
                          href="{{ collection.url }}"
                          class="btn--link"
                        >
                          {{ 'sections.collection_template.shop_all' | t }}
                          {% render 'icon-chevron-right' %}
                        </a>
                      </div>
                      
                    </div>
                  </div>
                  {% if section.settings.collection_layout == 'slider' and section.blocks.size > 0 %}
                    <slider-component class="collections-carousel-outer">
                      <ul id="main-collection-product-grid-{{ forloop.index }}"
                        data-id="{{ section.id }}" 
                        class="slider grid product-grid list-unstyled grid-nowrap">
                  {% else %}
                    <div class="collection page-width">
                      <ul
                        id="main-collection-product-grid-{{ forloop.index }}"
                        data-id="{{ section.id }}"
                        class="grid mobile-{{ grid_mobile_column }} desktop-{{ grid_desktop_column }} product-grid list-unstyled"
                      >
                  {% endif %}
                  
                  {% assign limit_product = section.settings.product_limit %}
                  {% assign desktop_hide = false %}
                  {% if section.settings.product_limit_mobile > section.settings.product_limit %}
                    {% assign limit_product = section.settings.product_limit_mobile %}
                    {% assign desktop_hide = true %}
                  {% endif %}
                  {% assign mobile_hide = false %}
                  {% if section.settings.product_limit_mobile < section.settings.product_limit %}
                    {% assign limit_product = section.settings.product_limit %}
                    {% assign mobile_hide = true %}
                  {% endif %}
                  
                  {% assign skip_card_product_styles = false %}
                  {% for product in collection.products limit: limit_product %}
                    {% assign lazy_load = false %}
                    {%- if forloop.index > 2 -%}
                      {%- assign lazy_load = true -%}
                    {%- endif -%}
                    {%- capture tag_classes -%}
                      {%- for tag in product.tags -%}
                        {%- assign tag_handle = tag | handleize -%}
                        {%- if tag_handle contains 'trimtype-' -%}
                          {{- tag_handle | replace_first: 'trimtype-', 'trim-' | append: ' ' -}}
                        {%- else -%}
                          {{- tag_handle | append: ' ' -}}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endcapture -%}
                    {% assign product_limit_class = '' %}
                    {% if desktop_hide and forloop.index > section.settings.product_limit %} 
                      {% assign product_limit_class = 'desktop-hide' %}
                    {% endif %}
                    {% if mobile_hide and forloop.index > section.settings.product_limit_mobile %} 
                      {% assign product_limit_class = 'mobile-hide' %}
                    {% endif %}
                    <li class="grid__item grid__item-product-card {% if section.settings.collection_layout == 'slider' and section.blocks.size > 0 %} carousel-cell-item{% endif %} {{ tag_classes }} {{ product_limit_class }}">
                      {% render 'card-product',
                        card_product: product,
                        media_aspect_ratio: section.settings.image_ratio,
                        image_shape: section.settings.image_shape,
                        show_secondary_image: section.settings.show_secondary_image,
                        show_price: section.settings.show_price,
                        show_vendor: section.settings.show_vendor,
                        show_rating: section.settings.show_rating,
                        lazy_load: lazy_load,
                        skip_styles: skip_card_product_styles,
                        quick_add: section.settings.quick_add,
                        section_id: section.id,
                        show_product_type: section.settings.show_product_type,
                        show_color_switch_option: section.settings.show_color_switch_option
                      %}
                    </li>
                    {%- assign skip_card_product_styles = true -%}
                  {% endfor %}
                  {% if section.settings.collection_layout == 'slider' and section.blocks.size > 0 %}
                    </ul>
                    <div class="slider-buttons no-js-hidden">
                      <button
                        type="button"
                        class="slider-button slider-button--prev"
                        name="previous"
                        aria-label="{{ 'accessibility.previous_slide' | t }}"
                      >
                        {% render 'icon-arrow-left' %}
                      </button>
                      <div class="visually-hidden slider-counter caption">
                        <span class="slider-counter--current">1</span>
                        <span aria-hidden="true"> / </span>
                        <span class="visually-hidden">{{ 'accessibility.of' | t }}</span>
                        <span class="slider-counter--total">{{ section.blocks.size }}</span>
                      </div>
                      <button
                        type="button"
                        class="slider-button slider-button--next"
                        name="next"
                        aria-label="{{ 'accessibility.next_slide' | t }}"
                      >
                        {% render 'icon-arrow-right' %}
                      </button>
                    </div>
                    </slider-component>
                  {% else %}
                      </ul>
                    </div>
                  {% endif %}
                  {%- if block.settings.button_text != blank -%}
                    <div class="button-wrapper{% if section.settings.collection_layout == 'slider' and section.blocks.size > 0 %} desktop-hide{% endif %}">
                      <a href="{{ collection.url }}" title="{{ collection.title }}" class="{% if section.settings.collection_layout == 'slider' and section.blocks.size > 0 %}btn--link{% else %}button button--primary{% endif %}">{{ block.settings.button_text }}</a>
                    </div>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
          <div
            class="collection collection--empty visually-hidden page-width{% if filters == false %} no-filters{% endif %}"
            data-id="{{ section.id }}"
          >
            <div class="title-wrapper center">
              <h2 class="title title--primary">
                {{ 'sections.collection_template.empty' | t -}}
                <br>
                {{
                  'sections.collection_template.use_fewer_filters_html'
                  | t: link: parent_collection.url, class: 'underlined-link link clear-filters'
                }}
              </h2>
            </div>
          </div>
        {%- endunless -%}
        <div id="ProductBar-{{ section.id }}" class="product-bar no-js-hidden">
          <slider-component>
            <ul id="ProductBar-Images-{{ section.id }}" class="product-images list-unstyled" role="list"></ul>
          </slider-component>
          <div class="visually-hidden alert">{{ 'sections.collection_template.warning' | t }}</div>
          <div class="collection-add visually-hidden">
            <button type="submit" class="button button-unstyled">
              {{ 'sections.collection_template.add_to_cart' | t }}
              <span id="ProductBarCount-{{ section.id }}"></span>
            </button>
          </div>
        </div>
      </collection-form>
    </div>
  </div>
</div>

{% javascript %}
  const customFilters = document.querySelector('.custom-filters');
  if (window.matchMedia('(min-width: 40em)').matches && customFilters) {
    customFilters.querySelector('details').setAttribute('open', '');
    customFilters.querySelector('summary').classList.add('visually-hidden');
  }
{% endjavascript %}

{% schema %}
{
  "name": "Multi collections",
  "class": "spaced-section collection-grid-section section multi-collection-landing-section",
  "settings": [
    {
      "type": "header",
      "content": "Collection layout for block"
    },
    {
      "type": "select",
      "id": "collection_layout",
      "label": "Collection layout",
      "default": "grid",
      "options": [
        {
          "value": "slider",
          "label": "Slider"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ]
    },
    {
      "type": "range",
      "label": "Product limit",
      "id": "product_limit",
      "default": 9,
      "max": 50,
      "min": 1,
      "step": 1
    },
    {
      "type": "range",
      "label": "Product limit (mobile)",
      "id": "product_limit_mobile",
      "default": 8,
      "max": 50,
      "min": 1,
      "step": 1
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "Show second image on hover"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "default": false,
      "label": "Show price on card"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_rating.label",
      "info": "t:sections.main-collection-product-grid.settings.show_rating.info"
    },
    {
      "type": "checkbox",
      "id": "show_product_type",
      "default": false,
      "label": "Show product type"
    },
    {
      "type": "checkbox",
      "id": "show_color_switch_option",
      "default": true,
      "label": "Show color switch on card"
    },
    {
      "type": "header",
      "content": "Filtering and sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "checkbox",
      "id": "hide_color_filter",
      "label": "Hide color from filter"
    },
    {
      "type": "checkbox",
      "id": "hide_material_filter",
      "label": "Hide material type from filter"
    },
    {
      "type": "checkbox",
      "id": "hide_type_filter",
      "label": "Hide product type from filter"
    },
    {
      "type": "checkbox",
      "id": "hide_fabric_filter",
      "label": "Hide fabric type from filter"
    },
    {
      "type": "checkbox",
      "id": "hide_trim_filter",
      "label": "Hide trim type from filter"
    },
    {
      "type": "checkbox",
      "id": "hide_filter_silhouette",
      "label": "Hide Silhouette from filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_kidscolor_filter",
      "label": "Hide Kidscolor from filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_pricing_filter",
      "label": "Hide Pricing Tier from filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_grid_view_mobile",
      "default": true,
      "label": "Enable grid view mobile"
    },
    {
      "type": "header",
      "content": "Collection items per row"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        {
          "value": "one",
          "label": "One"
        },
        {
          "value": "one-half",
          "label": "Two"
        }
      ],
      "default": "one-half"
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop items per row",
      "options": [
        {
          "value": "one",
          "label": "One"
        },
        {
          "value": "one-half",
          "label": "Two"
        },
        {
          "value": "one-third",
          "label": "Three"
        },
        {
          "value": "one-quarter",
          "label": "Four"
        },
        {
          "value": "one-fifth",
          "label": "Five"
        },
        {
          "value": "one-sixth",
          "label": "Six"
        },
      ],
      "default": "one-quarter"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "checkbox",
          "label": "Show collection title as a link",
          "id": "title_as_link",
          "default": false
        },
        {
          "type": "color",
          "label": "Background color",
          "id": "background_color"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "This will override products normally listed in the collection"
        },
        {
          "type": "text",
          "id": "collection_title",
          "label": "Collection title"
        },
        {
          "type": "textarea",
          "label": "Collection description",
          "id": "collection_description"
        },
        {
          "type": "text",
          "label": "Button text",
          "id": "button_text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multi collections"
    }
  ]
}
{% endschema %}
