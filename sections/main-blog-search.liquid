<script src="{{ 'blog-search.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign show_tags = section.settings.show_tags
  assign show_search = section.settings.show_search
-%}
{% if show_tags or show_search %}
  <div class="search-blog-wrapper">
    {% if section.settings.menu_desktop != blank %}
      <slider-component>
        <div class="slider-buttons no-js-hidden hide-on-desktop">
          <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'accessibility.previous_slide' | t }}">&lsaquo;</button>
          <div class="visually-hidden slider-counter caption">
            <span class="slider-counter--current">1</span>
              <span aria-hidden="true"> / </span>
              <span class="visually-hidden">{{ 'accessibility.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'accessibility.next_slide' | t }}">&rsaquo;</button>
        </div>
        <ul class="list-menu list-menu--inline slider slider--everywhere" role="list">
          {% assign blog_link = blog.url %}
          {% if template.name == 'article' %}
            {% assign parts = article.url | split: '/' %}
            {% assign blog_handle = parts[2] %}
            {% assign blog_link = '/blogs/' | append: blog_handle %}
          {% endif %}
          <li id="Slide-all" class="slide__mobile">
            {% assign all_active = false %}
            {% if template.name == 'blog' %}
              {% unless request.path contains 'tagged' %}
                {% assign all_active = true %}
              {%  else %}
              {% endunless %}
            {% endif %}
            <a href="{{ blog_link }}" class="blog-tag{% if all_active %} active{% endif %}">
              <span>{{ 'blogs.search.all' | t }}</span>
            </a>
          </li>
          {% for link in section.settings.menu_desktop.links  %}
            <li id="Slide-{{ link.title | handle }}" class="slide__mobile">
              <a href="{{ link.url }}" class="blog-tag{% if link.url contains request.path and request.path contains 'tagged' %} active{% endif %}">
                <span>{{ link.title }}</span>
              </a>
            </li>
          {% endfor %}
        </ul>
      </slider-component>
    {% endif %}
    <blog-search class="blog-search">
      <div class="blog-search-wrapper">
        <span class="svg-wrapper">
          {% render 'icon-search' %}
        </span>
        <input type="text" class="search__input field__input" name="blog-search" placeholder="{{ 'blogs.search.search_placeholder' | t }}" value="" data-blog-handle="{% if template.name == 'article' %}{{ article.handle | split: '/' | first }}{% else %}{{ blog.handle }}{% endif %}">
      </div>
    </blog-search>
  </div>
  <div class="blog-search-result page-width" id="blog-search-result"></div>
{% endif %}

{% schema %}
  {
    "name": "Blog search",
    "tag": "section",
    "class": "spaced-section",
    "settings": [
      {
        "type": "link_list",
        "id": "menu_desktop",
        "label": "Menu (desktop)"
      },
      {
        "type": "checkbox",
        "id": "show_search",
        "label": "Show Blog search",
        "default": true
      }
    ],
    "presets": [
      {
        "name": "Blog search"
      }
    ]
  }
{% endschema %}