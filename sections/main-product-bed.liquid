    var BASE_MAP   = maps.base   || {};
    var LEG_MAP    = maps.leg    || {};
    var WELT_MAP   = maps.welt   || {};
    var FOUR_CHANNEL_MAP = maps.four_channel || {};
    var STYLE_MAP = maps.style || {};

    var FABRIC_KEY = 'FABRIC';
    var productType = (window.productType || '').toLowerCase();
    var silhouette = (window.productSilhouette || '').toLowerCase();
    if (
      (productType === 'sofa' ||
      productType === 'sectional' ||
      (productType === 'chair' && silhouette === 'milo') ||
      (productType === 'chair' && silhouette === 'lila') ||
      (productType === 'chair' && silhouette === 'henry')) && silhouette != 'waverly' && silhouette != 'colette'
    ) {
      var LEG_KEY   = 'BASE LEG COLOR';
    } else if ((productType === 'chair' || productType === 'sofa') && silhouette === 'waverly') {
      var LEG_KEY   = 'LEG COLOR';
    } else if ((productType === 'chair' || productType === 'sofa' || productType === 'ottoman' || productType === 'settee') && silhouette === 'colette') {
      var LEG_KEY   = 'LEG COLOR';
    } else {
      var LEG_KEY   = 'LEG FINISH';
    }

    var BASE_KEY   = 'BASE TYPE';
    var WELT_KEY   = 'WELT COLOR';
    var FOUR_CHANNEL_KEY = '4 CHANNEL';
    var STYLE_KEY = 'STYLE';

    var fabricName    = window.__cylindoFabricName || '';
    var currentFabric = FABRIC_MAP[fabricName] || '';
    var currentBase   = '';
    var currentLeg    = '';
    var currentWelt = (function() {
      var noWeltEl = document.querySelector('input[name="properties[Trim]"][value="No Welt"]');
      if (noWeltEl) {
        return WELT_MAP['No Welt'] || WELT_MAP['NO WELT'] || '';
      }
      return WELT_MAP['Self Welt'] || WELT_MAP['SELF WELT'] || '';
    })();

    var isFourChannelProduct = silhouette === 'delaney' || silhouette === 'cecilia';
    var isMaronSleeperSofaProduct =
                                (silhouette === 'maron' && (productType === 'sofa' || productType === 'sleeper')) ||
                                (silhouette === 'waverly' && productType === 'sofa');
    var isSectionalProduct = productType === 'sectional';
    var currentFourChannel = '';
    var currentStyleMaron = '';
    var isHenryChairProduct = silhouette === 'henry' && productType === 'chair';
    var isWaverlyChairProduct = silhouette === 'waverly' && productType === 'chair';
    var sizeCodeMap = window.__cylindoProductCodes || {};

    function hasMultipleOptions(selector) {
      return document.querySelectorAll(selector).length > 1;
    }

    // function getMappedCode(selector) {
    //   var input = document.querySelector(selector);
    //   var handle = input
    //     ? (input.getAttribute('data-handle') || '').toLowerCase().trim()
    //     : '';
      
