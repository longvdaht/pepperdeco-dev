    //     // 1. Exact key match
    //     if (sizeCodeMap[handle]) return sizeCodeMap[handle];

    //     // 2. Match when handle is one segment of the key
    //     //    handle "bench" -> key "waverly-sofa-bench-seat" (segments include "bench")
    //     var matchedKey = Object.keys(sizeCodeMap).find(function (key) {
    //       return key.toLowerCase().split('-').indexOf(handle) !== -1;
    //     });
        
    //     if (matchedKey) return sizeCodeMap[matchedKey];
    //     console.log('cccc', sizeCodeMap[matchedKey]);
    //   }

    //   return Object.values(sizeCodeMap)[0] || '';
    // }

    function getMappedCode(selector) {
      var input = document.querySelector(selector);
      var handle = input ? (input.getAttribute('data-handle') || '') : '';

      if (handle) {
        var matchedKey = Object.keys(sizeCodeMap).find(function (key) {
          return (
            key.includes('-' + handle + '-') ||
            key.endsWith('-' + handle)
          );
        });

        if (matchedKey) return sizeCodeMap[matchedKey];
      }

      return Object.values(sizeCodeMap)[0] || '';
    }

    function getCurrentCode() {
      if (isMaronSleeperSofaProduct) {
        return getMappedCode('input.input-seat:checked');
      }

      if (isSectionalProduct) {
        return getMappedCode('input.input-configuration:checked');
      }

      var sizeInput = document.querySelector('input.input-size:checked');
      var sizeHandle = sizeInput ? (sizeInput.getAttribute('data-handle') || '') : '';

      if (sizeHandle) {
        if (sizeCodeMap[sizeHandle]) return sizeCodeMap[sizeHandle];

        var matchedKey = Object.keys(sizeCodeMap).find(function (key) {
          return key.endsWith('-' + sizeHandle);
        });

        if (matchedKey) return sizeCodeMap[matchedKey];
      }

      return Object.values(sizeCodeMap)[0] || '';
    }

    function updateCylindo() {
      var viewers = document.querySelectorAll('cylindo-viewer');
      if (!viewers.length) return;

      var code  = getCurrentCode();
      var parts = [];
      if (currentFabric) parts.push(FABRIC_KEY + ':' + currentFabric);

      if ((productType === 'chair' && silhouette === 'henry')) {
        if (currentBase && hasMultipleOptions('input[name="Leg"]'))
          parts.push(BASE_KEY + ':' + currentBase);
      } else {
        if (currentBase && hasMultipleOptions('input[name="Base"]'))
          parts.push(BASE_KEY + ':' + currentBase);
      }
      

      if (currentLeg && hasMultipleOptions('input[name="properties[Wood Finish]"]'))
        parts.push(LEG_KEY + ':' + currentLeg);

      if (currentWelt && hasMultipleOptions('input[name="properties[Trim]"]'))
        parts.push(WELT_KEY + ':' + currentWelt);

      if (isFourChannelProduct && currentFourChannel)
        parts.push(FOUR_CHANNEL_KEY + ':' + currentFourChannel);

      if (isMaronSleeperSofaProduct && currentStyleMaron)
        parts.push(STYLE_KEY + ':' + currentStyleMaron);

      viewers.forEach(function (v) {
        if (code) v.setAttribute('code', code);
        if (parts.length > 0) {
          v.setAttribute('configuration', parts.join(','));
        }
      });
    }

    function resolveBaseValue(baseValue) {
      var isAdeline = (window.productSilhouette || '').toLowerCase() === 'adeline';
      if (!isAdeline) return baseValue;
      
      var swivelChecked = document.querySelector('input[name="Swivel"]:checked');
      var isSwivel = swivelChecked && swivelChecked.value === 'Swivel';
      if (baseValue === 'Upholstered Base' && isSwivel) {
        return 'Upholstered Base with Swivel';
      }
      return baseValue;
    }

    // Size change
    document.querySelectorAll('input.input-size').forEach(function (el) {
      el.addEventListener('change', function() {
        {% comment %} var firstLeg = document.querySelector('input[name="properties[Wood Finish]"]');
        if (firstLeg && !document.querySelector('input[name="properties[Wood Finish]"]:checked')) {
          firstLeg.checked = true;
          firstLeg.dispatchEvent(new Event('change'));
        } {% endcomment %}
        updateCylindo();
      });
    });

    // Sofa maron seat change
    if (isMaronSleeperSofaProduct) {
      document.querySelectorAll('input.input-seat').forEach(function (el) {
        el.addEventListener('change', function() {
          updateCylindo();
        });
      });
    }

    // Sectional change
    if (isSectionalProduct) {
      document.querySelectorAll('input.input-configuration').forEach(function (el) {
        el.addEventListener('change', function() {
          updateCylindo();
        });
      });
    }
   
    // Base change
    if (!isHenryChairProduct) {
      document.querySelectorAll('input[name="Base"]').forEach(function (el) {
        el.addEventListener('change', function () {
          var baseValue = resolveBaseValue(this.value);
          var code = BASE_MAP[baseValue];
          if (code !== undefined) { currentBase = code; updateCylindo(); }

          {% comment %} if (this.value === 'Legs') {
            var firstLeg = document.querySelector('input[name="properties[Wood Finish]"]');
            if (firstLeg && !document.querySelector('input[name="properties[Wood Finish]"]:checked')) {
              firstLeg.checked = true;
              firstLeg.dispatchEvent(new Event('change'));
            }
          } {% endcomment %}
        });
      });
    }

    if (isWaverlyChairProduct) {
      document.querySelectorAll('input[name="properties[Wood Finish]"]').forEach(function (el) {
        el.addEventListener('change', function () {
          var checkedBaseEl = document.querySelector('input[name="Base"]:checked');
          if (!checkedBaseEl) return;

          var baseValue = resolveBaseValue(checkedBaseEl.value);
          var code = BASE_MAP[baseValue];
          if (code !== undefined) { currentBase = code; updateCylindo(); }
        });
      });
    }

    // Swivel change
    document.querySelectorAll('input[name="Swivel"]').forEach(function (el) {
      el.addEventListener('change', function () {
        var checkedBaseEl = document.querySelector('input[name="Base"]:checked');
        if (!checkedBaseEl) return;

        var baseValue = resolveBaseValue(checkedBaseEl.value);
        var code = BASE_MAP[baseValue];
        if (code !== undefined) { currentBase = code; updateCylindo(); }
      });
    });

    // Leg color change
    document.querySelectorAll('input[name="properties[Wood Finish]"]').forEach(function (el) {
      el.addEventListener('change', function () {
        var code = LEG_MAP[this.value];
        if (code !== undefined) { currentLeg = code; updateCylindo(); }
      });
    });

    // Trim/Welt change
    document.querySelectorAll('input[name="properties[Trim]"]').forEach(function (el) {
      el.addEventListener('change', function () {
        var code = WELT_MAP[this.value];
        if (code !== undefined) { currentWelt = code; updateCylindo(); }
      });
    });

    // Detail/Four Channel
    if (isFourChannelProduct) {
      document.querySelectorAll('input[name="Detail"]').forEach(function (el) {
        el.addEventListener('change', function () {
          var code = FOUR_CHANNEL_MAP[this.value];
          if (code !== undefined) { currentFourChannel = code; updateCylindo(); }
        });
      });
    }

    // Maron sofa style
    if (isMaronSleeperSofaProduct) {
      document.querySelectorAll('input[name="Detail"]').forEach(function (el) {
        el.addEventListener('change', function () {
          var code = STYLE_MAP[this.value];
          if (code !== undefined) { currentStyleMaron = code; updateCylindo(); }
        });
      });
    }

    // Init base
    if (isHenryChairProduct) {
      document.querySelectorAll('input[name="Leg"]').forEach(function (el) {
        el.addEventListener('change', function () {
          var baseValue = resolveBaseValue(this.value);
          var code = BASE_MAP[baseValue];
          if (code !== undefined) { currentBase = code; updateCylindo(); }
        });
      });

      var checkedBase = document.querySelector('input[name="Leg"]:checked');
      if (checkedBase) {
        var baseValue = resolveBaseValue(checkedBase.value);
        var initCode = BASE_MAP[baseValue];
        if (initCode !== undefined) currentBase = initCode;
      }
    } else {
      var checkedBase = document.querySelector('input[name="Base"]:checked');
      if (checkedBase) {
        var baseValue = resolveBaseValue(checkedBase.value);
        var initCode = BASE_MAP[baseValue];
        if (initCode !== undefined) currentBase = initCode;
      }
    }

    // Init leg
    var checkedLeg = document.querySelector('input[name="properties[Wood Finish]"]:checked');
    if (checkedLeg) {
      var initLegCode = LEG_MAP[checkedLeg.value];
      if (initLegCode !== undefined) currentLeg = initLegCode;
    }

    // Init detail
    if (isFourChannelProduct) {
      var checkedDetail = document.querySelector('input[name="Detail"]:checked');
      if (checkedDetail) {
        var initDetailCode = FOUR_CHANNEL_MAP[checkedDetail.value];
        if (initDetailCode !== undefined) currentFourChannel = initDetailCode;
      }
    }

    // Init detail sofa
    if (isMaronSleeperSofaProduct) {
      var checkedDetail = document.querySelector('input[name="Detail"]:checked');
      if (checkedDetail) {
        var initDetailCode = STYLE_MAP[checkedDetail.value];
        if (initDetailCode !== undefined) currentStyleMaron = initDetailCode;
      }
    }

    // Init on load
    updateCylindo();
  })();
</script>

<script>
  (function() {
    var sliders = document.querySelectorAll('.main-images-slider .slider');
    if (!sliders.length) return;

    sliders.forEach(function(slider) {
      var touchStartX = 0;
      var touchStartY = 0;
      var touchStartTime = 0;
      var isCylindoSlide = false;

      slider.addEventListener('touchstart', function(e) {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        touchStartTime = Date.now();
        isCylindoSlide = !!e.target.closest('.cylindo-viewer');
      }, { passive: true, capture: true });

      slider.addEventListener('touchend', function(e) {
        if (!isCylindoSlide) return;

        var dx = e.changedTouches[0].clientX - touchStartX;
        var dy = e.changedTouches[0].clientY - touchStartY;
        var elapsed = Date.now() - touchStartTime;
        var velocity = Math.abs(dx) / elapsed;
        var isHorizontal = Math.abs(dx) > Math.abs(dy) * 2;

        if (velocity > 0.6 && isHorizontal && Math.abs(dx) > 80 && elapsed < 300) {
          var sliderComponent = slider.closest('slider-component');
          if (!sliderComponent) return;

          var btn = dx < 0
            ? sliderComponent.querySelector('.slider-button--next')
            : sliderComponent.querySelector('.slider-button--prev');

          if (btn) btn.click();
        }
      }, { passive: true, capture: true });
    });
  })();
</script>

<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ shop.url | append: product.url | json }},
    {%- if product.selected_or_first_available_variant.featured_media -%}
      "image": [
        {{ product.selected_or_first_available_variant.featured_media | image_url: width: product.selected_or_first_available_variant.featured_media.preview_image.width | prepend: "https:" | json }}
      ],
    {%- endif -%}
    "description": {{ product.description | strip_html | json }},
    {%- if product.selected_or_first_available_variant.sku != blank -%}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif -%}
    "brand": {
      "@type": "Thing",
      "name": {{ product.vendor | json }}
    },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type" : "Offer",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price" : {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency" : {{ cart.currency.iso_code | json }},
          "url" : {{ shop.url | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

