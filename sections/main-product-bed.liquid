{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-rte.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>{{ 'component-price.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-rte.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script>
  var preorder_eta_pom_pom = {{ product.metafields.custom.pre_order_eta.value | json }}
</script>
{% if section.settings.enable_zoom or section.settings.enable_zoom_mobile %}
  <script src="{{ 'pinch-zoom.umd.js' | asset_url }}" defer="defer"></script>
  <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
{% endif %}
{%- assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' -%}
{%- assign product_type = product.type | handle -%}
{% assign current_variant_title_handle = product.selected_or_first_available_variant.title | handle %}
{% render 'breadcrumb-pdp' %}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 992px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="section-{{ section.id }}-padding section-outer page-width main-product-furniture">
  <div class="grid product-template-grid">
    <div class="mobile-top__content grid__item mobile-one product-info-wrapper">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
          {%- when 'title' -%}
            <h1 class="display product__title" {{ block.shopify_attributes }}>
              {{ product.title | escape }}
              {{ product.metafields.pepper.type.value }}
            </h1>
          {%- when 'price' -%}
            {% render 'block-price', block: block, section: section %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
    <div class="grid__item mobile-one desktop-two-thirds product-media-wrapper product-media-{{ section.settings.media_thumbnail }}">
      <a class="skip-to-content-link visually-hidden" href="#ProductInfo-{{ section.id }}">
        {{ 'accessibility.skip_to_product_info' | t }}
      </a>

      <slider-component class="{% unless section.settings.show_buttons %} slider-hide-buttons{% endunless %}{% unless section.settings.show_dots %} slider-hide-dots{% endunless %} thumbnail-slider">
        <ul tabindex="0"
          class="list-unstyled slider grid grid-nowrap mobile-one desktop-one"
          id="Slider-{{ section.id }}"
          role="list"
        >
          {%- assign image_count = 0 -%}
          {%- for media in product.media -%}
            {%- unless variant_images contains media.src -%}
              {%- assign image_count = image_count | plus: 1 -%}
            {%- endunless -%}
            {% if media.media_type == 'image' %}
              <li
                class="grid__item carousel-cell{% if forloop.first %} is-active{% endif %}{% if variant_images contains media.src %} product__media-item--variant{% endif %}"
                data-media-id="{{ section.id }}-{{ media.id }}"
              >
                <div class="media media--square">
                  <img
                    srcset="
                      {% if media.width >= 288 %}{{ media | image_url: width: 288 }} 288w,{% endif %}
                      {% if media.width >= 576 %}{{ media | image_url: width: 576 }} 576w,{% endif %}
                      {% if media.width >= 750 %}{{ media | image_url: width: 750 }} 750w,{% endif %}
                      {% if media.width >= 1100 %}{{ media | image_url: width: 1100 }} 1100w,{% endif %}
                      {% if media.width >= 1500 %}{{ media | image_url: width: 1500 }} 1500w{% endif %}
                    "
                    src="{{ media | image_url: width: 1500 }}"
                    sizes="(min-width: 40em) 80px, 100vw"
                    loading="lazy"
                    width="{{ media.width }}"
                    height="{{ media.width | divided_by: media.aspect_ratio }}"
                    alt="{{ media.alt | escape }}"
                    class="image-magnify-hover"
                  >
                </div>
                
              </li>
            {% elsif media.media_type == 'video' %}
              <li
                class="grid__item carousel-cell{% if variant_images contains media.src %} product__media-item--variant{% endif %} product__media-item-video"
                data-media-id="{{ section.id }}-{{ media.id }}"
              >
                <div class="media--type-video">
                  <div class="media media--square mobile-only">
                    {% if media.sources[1] %}
                      {% assign video_source = media.sources[1] %}
                    {% else %}
                      {% assign video_source = media.sources[0] %}
                    {% endif %}
                    <video class="lazy" 
                      height="{{ video_source.height }}" 
                      width="{{ video_source.width }}" 
                      id="video-{{ section.id }}" playsinline controls loop autoplay muted preload="metadata">
                        <source data-src="{{ video_source.url }}">
                    </video>
                  </div>
                  <div class="desktop-only video-preview-image">
                    <img
                      srcset="
                        {% if media.width >= 288 %}{{ media.preview_image | image_url: width: 288 }} 288w,{% endif %}
                        {% if media.width >= 576 %}{{ media.preview_image | image_url: width: 576 }} 576w,{% endif %}
                        {% if media.width >= 750 %}{{ media.preview_image | image_url: width: 750 }} 750w,{% endif %}
                        {% if media.width >= 1100 %}{{ media.preview_image | image_url: width: 1100 }} 1100w,{% endif %}
                        {% if media.width >= 1500 %}{{ media.preview_image | image_url: width: 1500 }} 1500w{% endif %}
                      "
                      src="{{ media.preview_image | image_url: width: 1500 }}"
                      sizes="(min-width: 40em) 80px, 100vw"
                      loading="lazy"
                      width="{{ media.width }}"
                      height="{{ media.width | divided_by: media.aspect_ratio }}"
                      alt="{{ media.alt | escape }}"
                      class="image-magnify-hover"
                    >
                    <div class="play-icon"> 
                      {% render 'icon-play' %}
                    </div>
                  </div>
                  
                </div>
               
              </li>
            {% endif %}
          {%- endfor -%}

          {% assign cylindo_codes = product.metafields.custom.cylindo_product_codes.value %}
          {% if cylindo_codes and cylindo_codes.size > 0 %}
            <li
              class="grid__item cylindo-viewer carousel-cell{% if variant_images contains media.src %} product__media-item--variant{% endif %}"
              data-media-id="{{ section.id }}-{{ media.id }}"
            >
              <cylindo-viewer
                customer-id="8142"
                show-zoom-controls-on-touch="true"
                code="{{ cylindo_codes.first.code }}"
                configuration=""
              ></cylindo-viewer>
              <span class='svg-wrapper rotate-icon'></span>
            </li>
          {% endif %}

          {% unless cylindo_codes and cylindo_codes.size > 0  %}
            {%- liquid
              if product.metafields.pepper.trim_images.value
                paginate product.metafields.pepper.trim_images.value by 150
                  for media in product.metafields.pepper.trim_images.value
                    assign image_count = image_count | plus: 1
                    render 'furniture-additional-thumbnail', media: media, media_title_array: media, image_count: image_count, type: product_type, thumbnail: true
                  endfor
                endpaginate
              endif
            -%}
          {% endunless %}
        </ul>
        
        <div class="slider-dots no-js-hidden">
          {% assign media_size = product.media | size %}
          {% for media in product.media %}
            <button
              type="button"
              data-index="{{ forloop.index }}"
              class="slider-dot{% if forloop.index0 == 0 %} is-active{% endif %}{% if variant_images contains media.src %} product__media-item--variant{% endif %}"
              name="index"
              aria-label="{{ 'accessibility.slide_index' | t: index: forloop.index }}"
            ></button>
          {% endfor %}
          <button
            type="button"
            data-index="{{ media_size | plus: 1 }}"
            class="slider-dot product__media-item--extra"
            name="index"
            aria-label="{{ 'accessibility.slide_index' | t: index: media_size | plus: 1 }}"
          ></button>
          {%- for media in product.metafields.pepper.trim_images.value -%}
            {%- assign image_count = image_count | plus: 1 -%}
            <button
              type="button"
              data-index="{{ image_count }}"
              class="slider-dot product__media-item--trim-image"
              name="index"
              aria-label="{{ 'accessibility.slide_index' | t: index: image_count }}"
            ></button>
          {%- endfor -%}
        </div>

        <div class="slider-buttons no-js-hidden">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'accessibility.previous_slide' | t }}"
          >
            {% render 'icon-arrow-left' %}
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'accessibility.of' | t }}</span>
            <span class="slider-counter--total">{{ product.images.size }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'accessibility.next_slide' | t }}"
          >
            {% render 'icon-arrow-right' %}
          </button>
        </div>
      </slider-component>

      {% comment %}
        selected_or_first_available_variant.featured_image
      {% endcomment %}

      <slider-component class="main-images-slider slider-hide-buttons slider-hide-dots {% if section.settings.enable_zoom %} enable-zoom{% endif %}">
        <ul tabindex="0"
          class="list-unstyled slider grid grid-nowrap mobile-one desktop-one main-images-slider-list"
          id="Slider-{{ section.id }}"
          role="list"
        >
          {%- for media in product.media -%}
            {% if media.media_type == 'image' %}
              <li
                class="grid__item carousel-cell{% if variant_images contains media.src %} product__media-item--variant{% endif %}"
                data-media-id="{{ section.id }}-{{ media.id }}"
              >
                <div class="media media--square">
                  <img
                    srcset="
                      {% if media.width >= 288 %}{{ media | image_url: width: 288 }} 288w,{% endif %}
                      {% if media.width >= 576 %}{{ media | image_url: width: 576 }} 576w,{% endif %}
                      {% if media.width >= 750 %}{{ media | image_url: width: 750 }} 750w,{% endif %}
                      {% if media.width >= 1100 %}{{ media | image_url: width: 1100 }} 1100w,{% endif %}
                      {% if media.width >= 1500 %}{{ media | image_url: width: 1500 }} 1500w{% endif %}
                    "
                    src="{{ media | image_url: width: 1500 }}"
                    sizes="100vw"
                    loading="lazy"
                    width="{{ media.width }}"
                    height="{{ media.width | divided_by: media.aspect_ratio }}"
                    alt="{{ media.alt | escape }}"
                    class="image-magnify-hover"
                  >
                </div>
                {% assign media_alt_text = media.alt | downcase %}
                {% if media_alt_text contains "featured" %}
                  <p class="image-alt-text">{{ media.alt |  remove: 'Featured: ' |  remove: 'FEATURED: ' }}</p>
                {% endif %}
              </li>
            {% elsif media.media_type == 'video' %}
              <li
                class="grid__item carousel-cell{% if variant_images contains media.src %} product__media-item--variant{% endif %} product__media-item-video"
                data-media-id="{{ section.id }}-{{ media.id }}"
              >
                <div class="media--type-video">
                  <div class="media media--square">
                    {% if media.sources[1] %}
                      {% assign video_source = media.sources[1] %}
                    {% else %}
                      {% assign video_source = media.sources[0] %}
                    {% endif %}
                    <video class="lazy" 
                      height="{{ video_source.height }}" 
                      width="{{ video_source.width }}" 
                      id="video-{{ section.id }}" playsinline controls loop autoplay muted preload="metadata">
                        <source data-src="{{ video_source.url }}">
                    </video>
                  </div>
                </div>
                {% assign media_alt_text = media.alt | downcase %}
                {% if media_alt_text contains "featured" %}
                  <p class="image-alt-text">{{ media.alt |  remove: 'Featured: ' |  remove: 'FEATURED: ' }}</p>
                {% endif %}
              </li>
            {% endif %}
          {%- endfor -%}

          {% if cylindo_codes and cylindo_codes.size > 0 %}
            <li
              class="grid__item cylindo-viewer carousel-cell{% if variant_images contains media.src %} product__media-item--variant{% endif %}"
              data-media-id="{{ section.id }}-{{ media.id }}"
            >
              <cylindo-viewer
                customer-id="8142"
                show-zoom-controls-on-touch="true"
                code="{{ cylindo_codes.first.code }}"
                configuration=""
              ></cylindo-viewer>
              <span class='svg-wrapper rotate-icon'>

              </span>
            </li>
          {% endif %}
          {% unless cylindo_codes and cylindo_codes.size > 0 %}
            {%- liquid
              if product.metafields.pepper.trim_images.value
                paginate product.metafields.pepper.trim_images.value by 150
                  for media in product.metafields.pepper.trim_images.value
                    assign image_count = image_count | plus: 1
                    render 'furniture-additional-thumbnail', media: media, media_title_array: media, image_count: image_count, type: product_type
                  endfor
                endpaginate
              endif

              assign product_type_model = ''
              if product.metafields.custom.model_type_filter
                for model in product.metafields.custom.model_type_filter.value
                  assign product_type_model = model.label | handle | prepend: '-'
                  break
                endfor
              endif

              if product.has_only_default_variant == false and product.metafields.custom.leg_options
                assign rendered_handles = '' | split: ''
                assign metaobject_leg_color = metaobjects.bed_leg_color

                if product.metafields.custom.furniture_leg_metaobject
                  assign metaobject_leg_color = metaobjects[product.metafields.custom.furniture_leg_metaobject.value]
                endif

                paginate metaobject_leg_color.values by 200
                  for meta_bed_leg in metaobject_leg_color.values
                    assign meta_bed_leg_handle = meta_bed_leg.leg_color_name | handle
                    assign media_image = meta_bed_leg.leg_color_image

                    unless rendered_handles contains meta_bed_leg_handle
                      if product.metafields.custom.leg_options
                        for base_size in product.options_by_name.Base.values
                          assign base_option_handle = base_size | handle

                          if product_type contains 'bed' or product_type contains 'bench'
                            for size_option in product.options_by_name.Size.values
                              assign size_option_handle = size_option | handle

                              for leg_option in product.metafields.custom.leg_options.value
                                assign leg_handle = leg_option.name | handle
                                assign leg_option_handle = product_type | append: product_type_model | append: '-' | append: size_option_handle | append: '-' | append: base_option_handle | append: '-' | append: leg_handle

                                if meta_bed_leg_handle == leg_option_handle
                                  assign image_count = image_count | plus: 1
                                  assign media_title_array = 'files-' | append: leg_option_handle
                                  render 'furniture-additional-thumbnail', media: media_image, media_title_array: media_title_array, image_count: image_count, type: product_type, base: base_option_handle, leg_color: leg_handle
                                  assign rendered_handles = rendered_handles | append: leg_option_handle | append: ','
                                endif
                              endfor
                            endfor
                          else
                            for leg_option in product.metafields.custom.leg_options.value
                              assign leg_handle = leg_option.name | handle
                              assign leg_option_handle = product_type | append: product_type_model | append: '-' | append: base_option_handle | append: '-' | append: leg_handle

                              if meta_bed_leg_handle == leg_option_handle
                                assign image_count = image_count | plus: 1
                                assign media_title_array = 'files-' | append: leg_option_handle
                                render 'furniture-additional-thumbnail', media: media_image, media_title_array: media_title_array, image_count: image_count, type: product_type, base: base_option_handle, leg_color: leg_handle
                                assign rendered_handles = rendered_handles | append: leg_option_handle | append: ','
                              endif
                            endfor
                          endif
                        endfor
                      endif
                    endunless
                  endfor
                endpaginate
              endif

              if product.has_only_default_variant == false and product.metafields.custom.welt_options.value.size > 0
                assign rendered_handles_welt = '' | split: ''

                assign metaobject_welt_color = metaobjects.bed_welt
                if product.metafields.custom.furniture_welt_metaobject
                  assign metaobject_welt_color = metaobjects[product.metafields.custom.furniture_welt_metaobject.value]
                endif

                paginate metaobject_welt_color.values by 300
                  for meta_bed_welt in metaobject_welt_color.values
                    if product_type contains 'headboard'
                      assign meta_bed_welt_handle = meta_bed_welt.headboard_welt_name | handle | remove_last: '-welt'
                    elsif product_type contains 'bed'
                      if product_type_model contains 'regina'
                        assign meta_bed_welt_handle = meta_bed_welt.welt_color_name | handle | remove_last: '-welt'
                      else
                        assign meta_bed_welt_handle = meta_bed_welt.bed_welt_name | handle | remove_last: '-welt'
                      endif
                    else
                      assign meta_bed_welt_handle = meta_bed_welt.welt_color_name | handle | remove_last: '-welt'
                    endif

                    unless rendered_handles_welt contains meta_bed_welt_handle
                      if product.metafields.custom.welt_options
                        if product_type == 'chair' or product_type == 'ottoman'
                          for base_size in product.options_by_name.Base.values
                            assign base_size_handle = base_size | handle

                            for welt_option in product.metafields.custom.welt_options.value
                              assign welt_handle = welt_option | handle
                              assign welt_option_handle = product_type | append: product_type_model | append: '-' | append: base_size_handle | append: '-' | append: welt_handle

                              if meta_bed_welt_handle == welt_option_handle
                                assign image_count = image_count | plus: 1
                                assign media_title_array = 'files-' | append: welt_option_handle
                                render 'furniture-additional-thumbnail', media: meta_bed_welt.welt_color_image, media_title_array: media_title_array, image_count: image_count, type: product_type, base: base_size_handle, welt: welt_handle
                                assign rendered_handles_welt = rendered_handles_welt | append: welt_option_handle | append: ','
                              endif
                            endfor
                          endfor
                        elsif product_type == 'bench'
                          for base_size in product.options_by_name.Size.values
                            assign base_size_handle = base_size | handle

                            for welt_option in product.metafields.custom.welt_options.value
                              assign welt_handle = welt_option | handle
                              assign welt_option_handle = product_type | append: product_type_model | append: '-' | append: base_size_handle | append: '-' | append: welt_handle

                              if meta_bed_welt_handle == welt_option_handle
                                assign image_count = image_count | plus: 1
                                assign media_title_array = 'files-' | append: welt_option_handle
                                render 'furniture-additional-thumbnail', media: meta_bed_welt.welt_color_image, media_title_array: media_title_array, image_count: image_count, type: product_type, welt: welt_handle
                                assign rendered_handles_welt = rendered_handles_welt | append: welt_option_handle | append: ','
                              endif
                            endfor
                          endfor
                        else
                          for base_size in product.options_by_name.Size.values
                            assign base_size_handle = base_size | handle
                            assign detail_handle = 'flat'
                            for detail in product.options_by_name.Detail.values
                              if detail contains 'Channel'
                                assign detail_handle = 'channel'
                              endif
                              for welt_option in product.metafields.custom.welt_options.value
                                assign welt_handle = welt_option | handle
                                assign welt_option_handle = product_type | append: product_type_model | append: '-' | append: detail_handle | append: '-' | append: base_size_handle | append: '-' | append: welt_handle

                                if meta_bed_welt_handle == welt_option_handle
                                  assign image_count = image_count | plus: 1
                                  assign media_title_array = 'files-' | append: welt_option_handle
                                  if product_type contains 'headboard'
                                    assign meta_welt_media = meta_bed_welt.headboard_welt_image
                                  else
                                    if product_type_model contains 'regina'
                                      assign meta_welt_media = meta_bed_welt.welt_color_image
                                    else
                                      assign meta_welt_media = meta_bed_welt.bed_welt_image
                                    endif
                                  endif
                                  render 'furniture-additional-thumbnail', media: meta_welt_media, media_title_array: media_title_array, image_count: image_count, type: product_type
                                  assign rendered_handles_welt = rendered_handles_welt | append: welt_option_handle | append: ','
                                endif
                              endfor
                            endfor
                          endfor
                        endif
                      endif
                    endunless
                  endfor
                endpaginate
              endif
            -%}
          {% endunless %}
        </ul>

        {% if section.settings.enable_zoom_mobile %}
          <div class="zoom-wrapper">
            <button class="zoom-in zoom-btn" aria-label="Zoom in">{% render 'icon-zoom-in-new' %}</button>
            <button class="zoom-out zoom-btn hidden" aria-label="Zoom out">{% render 'icon-zoom-out-new' %}</button>
          </div>
        {% endif %}

        <div class="slider-dots no-js-hidden">
          {% for media in product.media %}
            <button
              type="button"
              data-index="{{ forloop.index }}"
              class="slider-dot{% if forloop.index0 == 0 %} is-active{% endif %}{% if variant_images contains media.src %} product__media-item--variant{% endif %}"
              name="index"
              aria-label="{{ 'accessibility.slide_index' | t: index: forloop.index }}"
            ></button>
          {% endfor %}
        </div>
        <div class="slider-buttons no-js-hidden">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'accessibility.previous_slide' | t }}"
          >
            {% render 'icon-arrow-left' %}
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'accessibility.of' | t }}</span>
            <span class="slider-counter--total">{{ product.images.size }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'accessibility.next_slide' | t }}"
          >
            {% render 'icon-arrow-right' %}
          </button>
        </div>
      </slider-component>
    </div>
    <div class="grid__item mobile-one desktop-one-third product-info-wrapper">
      <div id="ProductInfo-{{ section.id }}">
        {%- assign product_form_id = 'product-form-' | append: section.id -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'title' -%}
              <h1 class="display product__title" {{ block.shopify_attributes }}>
                {{ product.title | escape }}
                {{ product.metafields.pepper.type.value }}
              </h1>
            {%- when 'price' -%}
              {% render 'block-price', block: block, section: section %}
            {%- when 'description' -%}
              <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
              {%- if product.description != blank -%}
                <div class="product-description-wrapper parent-display" id="Show-More-Description">
                  <div class="product__description rte parent-wrap">
                    {{ product.description }}
                  </div>
                  <show-more-button class="rte">
                    <button
                      class="button-show-more link underlined-link"
                      id="Show-More-{{ forloop.index }}-{{ section.id }}"
                      type="button"
                    >
                      <span class="label-show-more label-text"
                        ><span aria-hidden="true">+ </span>{{ 'products.facets.show_more' | t -}}
                      </span>
                      <span class="label-show-less label-text hidden"
                        ><span aria-hidden="true">- </span>{{ 'products.facets.show_less' | t -}}
                      </span>
                    </button>
                  </show-more-button>
                </div>
              {%- endif -%}
            {%- when 'spacer_block' -%}
              <div
                {{ block.shopify_attributes }}
                style="margin-top: {{ block.settings.spacing | divided_by: 10 }}rem"
              ></div>
            {%- when 'switch_option' %}
              {%- render 'switch-option' -%}
            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                {%- if block.settings.picker_type == 'button' -%}
                  <variant-radios
                    class="no-js-hidden"
                    data-section="{{ section.id }}"
                    data-url="{{ product.url }}"
                    {{ block.shopify_attributes }}
                  >
                    {%- for option in product.options_with_values -%}
                      {% assign option_name_handle = option.name | handle %}
                      
                      <fieldset class="js product-form__input product-form__input-{{ option_name_handle }}{% if option.values.size == 1 %} hidden only-option{% endif %}">
                        <option-dropdown data-dropdown-key="{{ option_name_handle }}">
                          <button type="button" data-dropdown-trigger aria-expanded="false">
                            <legend class="form__label">
                              {{ option.name }}:
                              <span id="{{ section.id }}-option-{{ forloop.index0 }}"{% if product.tags contains 'silhouette:waverly' and option_name_handle == 'base' %} data-waverly-label{% endif %}>
                                {%- if option.name == 'Size' %}
                                  <span class="option-not-selected">{{ 'products.product.select_size' | t }}</span>
                                {% elsif option.name == 'Base' %}
                                  <span class="option-not-selected">{{ 'products.product.select_base' | t }}</span>
                                {% elsif option.name == 'Swivel' %}
                                  <span class="option-not-selected">{{ 'products.product.select_swivel' | t }}</span>
                                {% elsif option.name == 'Detail' %}
                                  <span class="option-not-selected">{{ 'products.product.select_detail' | t }}</span>
                                {% elsif option.name == 'Configuration' %}
                                  <span class="option-not-selected">{{ 'products.product.select_configuration' | t }}</span>
                                {% elsif option.name == 'Seat' %}
                                  <span class="option-not-selected">{{ 'products.product.select_seat' | t }}</span>
                                {% elsif option.name == 'Leg' %}
                                  <span class="option-not-selected">{{ 'products.product.select_leg' | t }}</span>
                                {% else -%}
                                  {{ option.values.first }}
                                {% endif -%}
                              </span>
                            </legend>
                            {% render 'icon-chevron-up' %}
                            {% render 'icon-chevron-down-pdp' %}
                          </button>
                          <div data-dropdown-panel>
                            {%- for value in option.values -%}
                              {% assign value_handle = value | handle %}
                              {% assign size_image = '' %}
                              {% if option_name_handle == 'size' %}
                                {% if product.metafields.custom.furniture_size %}
                                  {% for furniture_size in product.metafields.custom.furniture_size.value %}
                                    {% assign size_name_handle = furniture_size.name | handle %}
                                    {% if value_handle == size_name_handle %}
                                      {% assign size_image = furniture_size.image %}
                                      {% break %}
                                    {% endif %}
                                  {% endfor %}
                                {% endif %}
                              {% endif %}
                              {% assign base_image = '' %}
                              {% if option_name_handle == 'base' %}
                                {% if product.metafields.custom.furniture_base_image %}
                                  {% for furniture_base in product.metafields.custom.furniture_base_image.value %}
                                    {% assign base_name_handle = furniture_base.name | handle %}
                                    {% if value_handle == base_name_handle %}
                                      {% assign base_image = furniture_base.image %}
                                      {% break %}
                                    {% endif %}
                                  {% endfor %}
                                {% endif %}
                              {% endif %}

                              {% assign configuration_image = '' %}
                              {% if option_name_handle == 'configuration' %}
                                {% if product.metafields.custom.configuration_chase %}
                                  {% for configuration_base in product.metafields.custom.configuration_chase.value %}
                                    {% assign configuration_name_handle = configuration_base.name | handle %}
                                    {% if value_handle == configuration_name_handle %}
                                      {% assign configuration_image = configuration_base.image %}
                                      {% break %}
                                    {% endif %}
                                  {% endfor %}
                                {% endif %}
                              {% endif %}

                              {% assign product_custom_type = product.metafields.pepper.type | handle %}
                              <input
                                type="radio"
                                id="{{ section.id }}-{{ option.name }}-{{ forloop.index0 }}"
                                name="{{ option.name }}"
                                value="{{ value | escape }}"
                                data-handle="{{ value | handle }}"
                                form="product-form-{{ section.id }}"
                                data-product-type="{{ product.type | handle }}"
                                data-product-custom-type="{{ product_custom_type }}"
                                class="input-{{ option.name | handleize }}
                                {% if option_name_handle == 'size' or option_name_handle == 'base' %} required{% endif %}"
                                {% comment %} {% if product.selected_variant %}
                                  {% if option.selected_value == value %}
                                    checked
                                  {% endif %}
                                {% else %}
                                  {% assign set_checked = false %}
                                  {% assign skip_auto_check = false %}
                                  {% if product_type == 'sofa' or product_type == 'sleeper' %}
                                    {% if option_name_handle == 'base' or option_name_handle == 'detail' or option_name_handle == 'seat' %}
                                      {% assign skip_auto_check = true %}
                                    {% endif %}
                                  {% endif %}
                                  {% if product_type != 'chair' and product_type != 'ottoman' %}
                                    {% if option.selected_value == value and option.values.size == 1 %}
                                      {% assign set_checked = true %}
                                    {% elsif option.selected_value == value and option_name_handle != 'size' and option_name_handle != 'configuration' and option.values.size > 1 and skip_auto_check == false %}
                                      {% assign set_checked = true %}
                                    {% endif %}
                                  {% else %}
                                    {% if option.selected_value == value and option_name_handle != 'base' %}
                                      {% assign set_checked = true %}
                                    {% endif %}
                                  {% endif %}
                                  {% if set_checked %}
                                    checked
                                  {% endif %}
                                {% endif %} {% endcomment %}

                                {% comment %} {% if forloop.first %}
                                  checked
                                {% endif %} {% endcomment %}

                                {% if option.values.size == 1 %}
                                  checked
                                {% endif %}
                                {% if option.selected_value == value and product.selected_variant != nil %}
                                  checked
                                {% endif %}
                                
                                {%- if option_name_handle == 'size' or option_name_handle == 'configuration' -%}
                                  required
                                {%- elsif option_name_handle == 'base' -%}
                                  {%- if product_type == 'chair' or product_type == 'ottoman' or product_type == 'sofa' or product_type == 'sleeper' -%}
                                    required
                                  {%- endif -%}
                                {%- elsif option_name_handle == 'detail' or option_name_handle == 'seat' -%}
                                  {%- if product_type == 'sofa' or product_type == 'sleeper' -%}
                                    required
                                  {%- endif -%}
                                {%- endif -%}

                              >
                              <label
                                for="{{ section.id }}-{{ option.name }}-{{ forloop.index0 }}"
                                class="{{ option.name | handleize }}-radio {{ option.name | handleize }}-{{ value | handleize }} {{ product_custom_type }} {{ current_variant_title_handle }}
                                        {% if option.name == 'Length' or option.name == 'Trim' %} visually-hidden{% endif %} {{ option.name | handleize }}-radio-{{ product.type | handleize }}
                                        {% if size_image != '' or base_image != '' or configuration_image != '' %} size-custom{%- endif -%}
                                        {% comment %} {% if current_variant_title_handle contains 'legs' and option_name_handle == 'swivel' and value != 'No Swivel' and product_custom_type contains 'marlow' %} hidden{% endif %}
                                        {% if current_variant_title_handle contains 'upholstered' and option_name_handle == 'swivel' and value == 'No Swivel' and product_custom_type contains 'marlow' %} hidden{% endif %}" {% endcomment %}"
                                        {% if size_image != '' or base_image != '' or configuration_image != '' %}
                                          style="--size-image: url({% if size_image != '' %}{{ size_image | image_url: width: 300 }}{% elsif base_image != '' %}{{ base_image | image_url: width: 300 }}{% else %}{{ configuration_image | image_url: width: 300 }}{% endif %})"
                                        {% endif %}
                              >
                                {% assign value_handle = value | handle %}
                                {%- if option_name_handle == 'base' and value_handle contains 'casters' and product.tags contains 'silhouette:waverly' %}
                                  {{ value | replace: 'with Casters', '' }}
                                {% else %}
                                  {{ value }}
                                {% endif %}
                              </label>
                            {%- endfor -%}
                          </div>
                        </option-dropdown>
                      </fieldset>

                      {% assign show_leg_options = false %} 
                      {% assign is_henry_chair = false %}
                      {% if product.tags contains 'silhouette:henry' and product_type == 'chair' %}
                        {% assign is_henry_chair = true %}
                      {% endif %}
                      {%- if option_name_handle == 'base' and is_henry_chair == false -%}
                        {% assign show_leg_options = true %}
                      {%- elsif is_henry_chair and option_name_handle == 'leg' -%}
                        {% assign show_leg_options = true %}
                      {%- endif -%}

                      {%- if show_leg_options -%}
                        {% assign leg_options = product.metafields.custom.leg_options %}
                        {%- if leg_options -%}
                          <leg-radios
                            class="{{ option_name_handle }} no-js-hidden{% if current_variant_title_handle contains 'kick-pleat-skirt' or current_variant_title_handle contains 'upholstered base' %} hidden{% endif %}"
                            data-section="{{ section.id }}"
                          >
                            <div class="js product-form__input product-form__input-wood-finish">
                              <option-dropdown data-dropdown-key="leg">
                                <button type="button" data-dropdown-trigger aria-expanded="false">
                                  <legend class="form__label">
                                    <div class="contruction-wrapper leg">
                                      {{ 'products.product.wood_finish' | t }}:
                                      <div class="option-link leg-modal-trigger" data-modal="legModal">?</div>
                                    </div>
                                    <span id="{{ section.id }}-option-{{ forloop.index0 }}">
                                      {% comment %} {% assign first_leg = leg_options.value | first %}
                                      {{ first_leg.name }} {% endcomment %}
                                      <span class="option-not-selected">{{ 'products.product.select_wood_finish' | t }}</span>
                                    </span>
                                    {% comment %} {% if block.settings.leg_hover_image != blank %}
                                      <div class="option-link option-tooltip--wrapper">
                                        ?
                                        <div class="option-tooltip">
                                          <img src="{{ block.settings.leg_hover_image | image_url: width: 500 }}" alt="Leg Options" width="500" height="500" alt="{{ block.settings.leg_hover_image.alt }}">
                                        </div>
                                      </div>
                                    {% endif %} {% endcomment %}
                                  </legend>
                                  {% render 'icon-chevron-up' %}
                                  {% render 'icon-chevron-down-pdp' %}
                                </button>
                                <div data-dropdown-panel>
                                  <div class="js product-form__input">
                                    {% for leg in leg_options.value %}
                                      <input
                                        type="radio"
                                        id="{{ section.id }}-leg-option-{{ leg.name | handle }}"
                                        {% comment %} {% unless current_variant_title_handle contains 'kick-pleat-skirt' or current_variant_title_handle contains 'upholstered base' %} required{% else %} disabled{% endunless %} {% endcomment %}
                                        name="properties[Wood Finish]"
                                        value="{{ leg.name }}"
                                        form="product-form-{{ section.id }}"
                                        {% comment %} {% if forloop.first %}checked{% endif %} {% endcomment %}
                                        class="{% unless current_variant_title_handle contains 'kick-pleat-skirt' or current_variant_title_handle contains 'upholstered base' %}required {% endunless %}input-leg-option input-trim-option"
                                      >
                                      <label
                                        for="{{ section.id }}-leg-option-{{ leg.name | handle }}"
                                        class="trim-option-radio trim-leg-option trim-leg-{{ leg.name | handle }}"
                                        style="--leg-image: url({{ leg.background_image | image_url: width: 300 }}); --leg-color: {{ leg.color }}"
                                      >
                                        {{ leg.name }}
                                      </label>
                                    {% endfor %}
                                  </div>
                                </div>
                              </option-dropdown>
                              {% render 'leg-modal' %}
                              <script>
                                document.addEventListener('click', function(e) {
                                  const trigger = e.target.closest('.leg-modal-trigger');
                                  if (!trigger) return;

                                  e.preventDefault();
                                  e.stopPropagation();

                                  const modal = document.getElementById('legModal');

                                  if (!modal) return;

                                  const summary = modal.querySelector('summary');

                                  summary?.click();
                                });
                              </script>
                            </div>
                          </leg-radios>
                        {%- endif -%}
                      {%- endif -%}
                      {%- if forloop.last -%}
                        {%- render 'welt-radios' -%}
                      {%- endif -%}
                    {%- endfor -%}
                    <script type="application/json" data-variants>
                      {{ product.variants | json }}
                    </script>
                  </variant-radios>
                {%- else -%}
                  <variant-selects
                    class="no-js-hidden"
                    data-section="{{ section.id }}"
                    data-url="{{ product.url }}"
                    {{ block.shopify_attributes }}
                  >
                    {%- for option in product.options_with_values -%}
                      <fieldset class="product-form__input product-form__input--dropdown">
                        <label class="form__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
                          {{ option.name }}:
                          <span id="{{ section.id }}-option-{{ forloop.index0 }}">{{ option.selected_value }}</span>
                        </label>
                        <div class="select">
                          <select
                            id="Option-{{ section.id }}-{{ forloop.index0 }}"
                            class="select__select"
                            name="options[{{ option.name | escape }}]"
                            form="product-form-{{ section.id }}"
                          >
                            {%- if option.name == 'Yards' -%}
                              <option value="{{ option.values | first | escape }}" selected="selected">
                                {{ 'products.product.yard_dropdown_label' | t }}
                              </option>
                            {%- endif -%}
                            {%- for value in option.values -%}
                              <option
                                value="{{ value | escape }}"
                                {% if option.selected_value == value and option.name != 'Yards' %}
                                  selected="selected"
                                {% endif %}
                              >
                                {{ value }}
                              </option>
                            {%- endfor -%}
                          </select>
                        </div>
                      </fieldset>
                    {%- endfor -%}
                    <script type="application/json" data-variants>
                      {{ product.variants | json }}
                    </script>
                  </variant-selects>
                {%- endif -%}
              {% else %}
                <script type="application/json" data-variants>
                  {{ product.variants | json }}
                </script>
              {%- endunless -%}

              

              {%- if product.vendor == 'Kassatex' and product.type == 'Bath Towel' -%}
                {{ 'component-kassatex-personalization.css' | asset_url | stylesheet_tag }}
                <script src="{{ 'component-kassatex-personalization.js' | asset_url }}" defer="defer"></script>
                <kassatex-personalization class="no-js-hidden">
                  <div class="product-form__input product-form__input-embroidery">
                    <input type="hidden" name="properties[_Embroidery]" value="None" form="{{ product_form_id }}">
                    <label class="form__label" for="embroidery-true">
                      <input
                        type="checkbox"
                        name="properties[_Embroidery]"
                        value="true"
                        id="embroidery-true"
                        form="{{ product_form_id }}"
                        data-embroidery-Id="{{ all_products['monogramming-fee'].selected_or_first_available_variant.id }}"
                      >
                      Add Embroidery (+
                      {{-
                        all_products['monogramming-fee'].selected_or_first_available_variant.price
                        | money_without_trailing_zeros
                      -}}
                      )
                    </label>
                  </div>
                  <div class="product-form__input product-form__input-ks-type">
                    <input
                      type="radio"
                      name="properties[_Embroidery Type]"
                      id="monogram"
                      value="Monogram"
                      form="{{ product_form_id }}"
                    >
                    <label for="monogram">Monogram</label>
                    <input
                      type="radio"
                      name="properties[_Embroidery Type]"
                      id="text"
                      value="Text"
                      form="{{ product_form_id }}"
                    >
                    <label for="text">Text</label>
                  </div>
                  <div class="product-form__input product-form__input-thread-color">
                    {%- assign thread_colors = 'Sand,Sage,Navy,Light Blue,Coral' | split: ',' -%}
                    <div class="form__label">
                      {{ 'products.product.embroidery_color_name' | t }}: <span id="embroidery-color-legend"></span>
                    </div>
                    {%- for color in thread_colors -%}
                      <input
                        type="radio"
                        name="properties[Thread Color]"
                        id="{{ color | downcase }}"
                        value="{{ color }}"
                        form="{{ product_form_id }}"
                        class="embroidery-thread-color-input input-trim-option"
                      >
                      <label
                        for="{{ color | downcase }}"
                        class="embroidery-color trim-option-radio color-ks-{{ color | handle }}"
                      >
                        {{- color -}}
                      </label>
                    {%- endfor -%}
                  </div>
                  <div class="product-form__input ks-type-options">
                    {%- assign typefaces = 'English Script, Felix Tilting, Point Monogram' | split: ', ' -%}
                    <div class="form__label">Typeface: <span id="type-option-legend"></span></div>
                    <div class="ks-type-options-wrapper">
                      {%- for typeface in typefaces -%}
                        <div
                          class="typeface-wrapper{% if typeface contains 'Monogram' %} hidden{% endif %}"
                          {% if typeface contains 'Monogram' %}
                            data-monogram
                          {% else %}
                            data-text
                          {% endif %}
                        >
                          <input
                            type="radio"
                            name="properties[Typeface]"
                            id="{{ typeface | downcase }}"
                            value="{{ typeface }}"
                            form="{{ product_form_id }}"
                            class="embroidery-type-radio"
                          >
                          <label
                            for="{{ typeface | downcase }}"
                            class="embroidery-type-radio embroidery-text type-option-{{ typeface | handle }}"
                          >
                            {{- typeface -}}
                          </label>
                        </div>
                      {%- endfor -%}
                    </div>
                  </div>
                  <div class="product-form__input">
                    <label for="personalization" class="form__label">Personalization</label>
                    <input
                      type="text"
                      name="properties[Personalization]"
                      id="personalization"
                      class="additional-input kassatex"
                      form="{{ product_form_id }}"
                    >
                    <div id="Helper-Monogram" class="hidden form__label personalization-helper">
                      3 Letters—First Initial, Last Initial, Middle Initial
                    </div>
                    <div id="Helper-Text" class="hidden form__label personalization-helper">
                      1-16 Characters—letters, numbers, or keyboard symbols
                    </div>
                  </div>
                </kassatex-personalization>
              {%- endif -%}

              <noscript>
                <div class="product-form__input{% if product.has_only_default_variant %} hidden{% endif %}">
                  <label class="form__label" for="Variants-{{ section.id }}">
                    {{- 'products.product.product_variants' | t -}}
                  </label>
                  <div class="select">
                    <select name="id" id="Variants-{{ section.id }}" class="select__select" form="product-form">
                      {%- for variant in product.variants -%}
                        <option
                          {% if variant == product.selected_or_first_available_variant %}
                            selected="selected"
                          {% endif %}
                          {% if variant.available == false %}
                            disabled
                          {% endif %}
                          value="{{ variant.id }}"
                        >
                          {{ variant.title }}
                          {%- if variant.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}
                          - {{ variant.price | money | strip_html }}
                        </option>
                      {%- endfor -%}
                    </select>
                  </div>
                </div>
              </noscript>
            {%- when 'wallpaper_calculator' -%}
              <details-modal class="product__modal wallpaper-calc-modal" {{ block.shopify_attributes }}>
                <details>
                  <summary
                    class="modal__toggle"
                    aria-haspopup="dialog"
                    aria-label="{{ block.settings.content }} Calculate yardage"
                  >
                    {{ block.settings.content }}
                    <div class="wrapper-content">
                      {%- if block.settings.icon != blank -%}
                        <span class="svg-wrapper">
                          <img src="{{ block.settings.icon | image_url: width: 50 }}" width="30" height="30" alt="{{ block.settings.text_link }}">
                        </span>
                      {%- endif -%}
                      <span class="text-link">{{ block.settings.text_link }} </span>
                    </div>
                  </summary>
                  <div
                    class="product-modal modal__content"
                    role="dialog"
                    aria-modal="true"
                    aria-label="{{ block.settings.content }} {{ block.settings.text_link }}"
                  >
                    <div class="modal-overlay"></div>
                    <div class="product-modal__content" tabindex="-1">
                      <link
                        rel="stylesheet"
                        href="{{ 'wallpaper-calculator.css' | asset_url }}"
                        media="print"
                        onload="this.media='all'"
                      >
                      <noscript>{{ 'wallpaper-calculator.css' | asset_url | stylesheet_tag }}</noscript>
                      <script src="{{ 'wallpaper-calculator.js' | asset_url }}" defer="defer"></script>
                      <div id="wallpaper-calculator"></div>
                      <button
                        type="button"
                        class="modal__close-button link button-unstyled focus-inset"
                        aria-label="{{ 'accessibility.close' | t }}"
                      >
                        <i class="fas fa-xmark icon"></i>
                      </button>
                    </div>
                  </div>
                </details>
              </details-modal>
            {%- when 'furniture_calculator' -%}
              <details-modal class="product__modal wallpaper-calc-modal furniture-calculator" {{ block.shopify_attributes }}>
                <details>
                  <summary
                    class="modal__toggle"
                    aria-haspopup="dialog"
                    aria-label="{{ block.settings.content }} Calculate yardage"
                  >
                    {{ block.settings.content }}
                    <div class="wrapper-content">
                      {%- if block.settings.icon != blank -%}
                        <span class="svg-wrapper">
                          <img src="{{ block.settings.icon | image_url: width: 50 }}" width="30" height="30" alt="{{ block.settings.text_link }}">
                        </span>
                      {%- endif -%}
                      <span class="text-link">{{ block.settings.text_link }} </span>
                    </div>
                  </summary>
                  <div
                    class="product-modal modal__content furniture_calculator "
                    role="dialog"
                    aria-modal="true"
                    aria-label="{{ block.settings.content }} {{ block.settings.text_link }}"
                  >
                    <div class="modal-overlay"></div>
                    <div class="product-modal__content" tabindex="-1">
                       {%- if block.settings.popup_content_image != blank -%}
                        <img src="{{ block.settings.popup_content_image | image_url: width: 1000 }}" width="1000" height="1000">
                        {%- endif -%}
                      <button
                        type="button"
                        class="modal__close-button link button-unstyled focus-inset"
                        aria-label="{{ 'accessibility.close' | t }}"
                      >
                        <i class="fas fa-xmark icon"></i>
                      </button>
                    </div>
                  </div>
                </details>
              </details-modal>
            {%- when 'curtain_calculator' -%}
              <details-modal class="product__modal" {{ block.shopify_attributes }}>
                <details>
                  <summary
                    class="modal__toggle"
                    aria-haspopup="dialog"
                    aria-label="{{ block.settings.content }} Calculate dimensions"
                  >
                    {{ block.settings.content }}
                    <span class="text-link">Calculate dimensions</span>
                  </summary>
                  <div
                    class="product-modal modal__content"
                    role="dialog"
                    aria-modal="true"
                    aria-label="{{ block.settings.content }} Calculate dimensions"
                  >
                    <div class="modal-overlay"></div>
                    <div class="product-modal__content" tabindex="-1">
                      <link
                        rel="stylesheet"
                        href="{{ 'curtain-calculator.css' | asset_url }}"
                        media="print"
                        onload="this.media='all'"
                      >
                      <noscript>{{ 'curtain-calculator.css' | asset_url | stylesheet_tag }}</noscript>
                      <script src="{{ 'curtain-calculator.js' | asset_url }}" defer="defer"></script>
                      <div id="curtain-calculator"></div>
                      <button
                        type="button"
                        class="modal__close-button link button-unstyled focus-inset"
                        aria-label="{{ 'accessibility.close' | t }}"
                      >
                        {%- render 'icon-close' -%}
                      </button>
                    </div>
                  </div>
                </details>
              </details-modal>
            {%- when 'quantity_selector' -%}
              <div
                class="product-form__input product-form__quantity product-form__furniture{% if product.metafields.pepper.external_product_page_link != blank %} product-form__quantity-hidden{% endif %}"
                {{ block.shopify_attributes }}
              >
                <label class="form__label" for="Quantity-{{ section.id }}">
                  {% if product.type == 'Curtain' %}
                    {{ 'products.product.quantity.curtain_label' | t }}
                  {% elsif product.type == 'Wallpaper' and product.tags contains 'solid grasscloth' %}
                    {{ 'products.product.quantity.rolls_label' | t }}
                  {% else %}
                    {{ 'products.product.quantity.label' | t }}
                  {% endif %}
                </label>

                <quantity-input class="quantity" data-section="{{ section.id }}">
                  <button
                    class="quantity__button no-js-hidden{% if product.type == 'Fabric By The Yard' or product.type == 'Wallpaper' or product.type == 'Artwork' %}{% unless product.type == 'Wallpaper' and product.tags contains 'solid grasscloth' %} visually-hidden{% endunless %}{% endif %}"
                    name="minus"
                    type="button"
                    {% if product.type == 'Fabric By The Yard' or product.type == 'Wallpaper' %}
                      {% unless product.type == 'Wallpaper' and product.tags contains 'solid grasscloth' %}
                        disabled
                      {% endunless %}
                    {% endif %}
                  >
                    <span class="visually-hidden">
                      {{- 'products.product.quantity.decrease' | t: product: product.title | escape -}}
                    </span>
                    <span class="minus"></span>
