<script>
  (function() {
    var fixInterval = null;
    var isFullscreen = false;

    function forceFullscreen() {
      var viewer = document.querySelector('.main-images-slider cylindo-viewer');
      if (!viewer || !viewer.shadowRoot) return;
      
      var root = viewer.shadowRoot.querySelector('.root');
      if (!root) return;

      var style = root.getAttribute('style') || '';
      if (style.includes('position: fixed')) {
        root.style.setProperty('z-index', '2147483647', 'important');
      }
    }

    function enterFullscreen() {
      if (isFullscreen) return;
      isFullscreen = true;

      var viewer = document.querySelector('.main-images-slider cylindo-viewer');
      if (!viewer) return;

      var targets = [
        viewer,
        viewer.closest('li'),
        viewer.closest('ul'),
        viewer.closest('slider-component'),
        viewer.closest('.main-images-slider')
      ].filter(Boolean);

      targets.forEach(function(el) {
        el.classList.add('cylindo-fs-active');
      });

      if (!fixInterval) {
        fixInterval = setInterval(forceFullscreen, 50);
      }
    }

    function exitFullscreen() {
      if (!isFullscreen) return;
      isFullscreen = false;

      var targets = document.querySelectorAll('.cylindo-fs-active');
      targets.forEach(function(el) {
        el.classList.remove('cylindo-fs-active');
      });

      if (fixInterval) {
        clearInterval(fixInterval);
        fixInterval = null;
      }
    }

    function startObserver() {
      var viewer = document.querySelector('.main-images-slider cylindo-viewer');
      if (!viewer || !viewer.shadowRoot) {
        setTimeout(startObserver, 500);
        return;
      }

      var root = viewer.shadowRoot.querySelector('.root');
      if (!root) {
        setTimeout(startObserver, 500);
        return;
      }

      var observer = new MutationObserver(function() {
        var style = root.getAttribute('style') || '';
        if (style.includes('position: fixed')) {
          enterFullscreen();
        } else {
          exitFullscreen();
        }
      });

      observer.observe(viewer.shadowRoot, { 
        attributes: true,
        subtree: true,
        attributeFilter: ['style']
      });
    }

    document.addEventListener('DOMContentLoaded', startObserver);
  })();
</script>

