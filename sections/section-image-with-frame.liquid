<link rel="stylesheet" href="{{ 'section-image-content.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'section-image-with-text-column.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>{{ 'section-image-content.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'section-image-with-text-column.css' | asset_url | stylesheet_tag }}</noscript>

{%- assign grid_mobile_column = 'one' -%}
{%- assign grid_desktop_column = 'one-half' -%}

<div data-section-id="{{ section.id }}" class="section-outer section-image-with-frame section-image-content-full-w section-image-with-text-column section-color-{{ section.settings.color_scheme }} center" style="--background-color: {{ section.settings.background_color }}">
  <div class="grid mobile-{{ grid_mobile_column }} desktop-{{ grid_desktop_column }}">
    <div class="grid__item has-background-image text-column-wrapper">
      <div class="section-content {{ section.settings.text_alignment }}">
        {%- if section.settings.heading != blank -%}
          <h2 class="{{ section.settings.heading_size }} section-heading">
            {% render 'no-widows', content: section.settings.heading %}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="rte section-subheading">
            {% render 'no-widows', content: section.settings.subheading %}
          </div>
        {%- endif -%}
        {%- if section.settings.content != blank -%}
          <div class="rte rte-content">
            {%- assign content = section.settings.content -%}
            {% render 'no-widows', content: content -%}
          </div>
        {%- endif -%}
        {% if section.settings.link != blank %}
          <a href="{{ section.settings.link }}" class="button button--secondary">{{ section.settings.label }}</a>
        {% endif %}
      </div>
    </div>
    <div class="grid__item mobile-align-{{ section.settings.mobile_alignment }} desktop-align-{{ section.settings.desktop_alignment }} media--type-image">
      <div
        class="img-wrapper"
      >
        <img
          srcset="
            {%- if section.settings.image.width >= 375 -%}{{ 'photo-frame.png' | asset_img_url: '375x' }} 375w,{%- endif -%}
            {%- if section.settings.image.width >= 750 -%}{{ 'photo-frame.png' | asset_img_url: '750x' }} 750w,{%- endif -%}
            {%- if section.settings.image.width >= 1100 -%}{{ 'photo-frame.png' | asset_img_url: '1100x' }} 1100w,{%- endif -%}
            {%- if section.settings.image.width >= 1500 -%}{{ 'photo-frame.png' | asset_img_url: '1500x' }} 1500w,{%- endif -%}
            {%- if section.settings.image.width >= 1780 -%}{{ 'photo-frame.png' | asset_img_url: '1780x' }} 1780w,{%- endif -%}
            {%- if section.settings.image.width >= 2000 -%}{{ 'photo-frame.png' | asset_img_url: '2000x' }} 2000w,{%- endif -%}
            {%- if section.settings.image.width >= 3000 -%}{{ 'photo-frame.png' | asset_img_url: '3000x' }} 3000w,{%- endif -%}
            {%- if section.settings.image.width >= 3840 -%}{{ 'photo-frame.png' | asset_img_url: '3840x' }} 3840w,{%- endif -%}
          "
          sizes="(min-width: 40em) 40vw, 90vw"
          src="{{ 'photo-frame.png' | asset_img_url: '2000x' }}"
          loading="lazy"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.width | divided_by: section.settings.image.aspect_ratio }}"
          class="image-frame"
        >
      </div>
      
      {%- if section.settings.video != blank -%}
        <div class="media--type-video {% if section.settings.video_mobile != blank %}hide-mobile{% endif %} {% if section.settings.square_video_mobile %}square-video{% endif %}">
          <div class="media media--square">
            <video class="lazy" 
              height="{{ section.settings.video.sources[1].height }}" 
              width="{{ section.settings.video.sources[1].width }}" 
              id="video-{{ section.id }}" playsinline controls loop autoplay muted preload="metadata">
                <source data-src="{{ section.settings.video.sources[1].url }}">
            </video>
          </div>
        </div>
        {%- if section.settings.video_mobile != blank -%}
          <div class="media--type-video hide-desktop {% if section.settings.square_video_mobile %}square-video{% endif %}">
            <div class="media media--square">
              <video class="lazy" 
                height="{{ section.settings.video_mobile.sources[1].height }}" 
                width="{{ section.settings.video_mobile.sources[1].width }}" 
                id="video-{{ section.id }}-mobile" playsinline controls loop autoplay muted preload="metadata">
                  <source data-src="{{ section.settings.video_mobile.sources[1].url }}">
              </video>
            </div>
          </div>
        {%- endif -%}
      {% elsif section.settings.image != blank %}
        <img
          srcset="
            {%- if section.settings.image.width >= 375 -%}{{ section.settings.image | image_url: width: 375 }} 375w,{%- endif -%}
            {%- if section.settings.image.width >= 750 -%}{{ section.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if section.settings.image.width >= 1100 -%}{{ section.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
            {%- if section.settings.image.width >= 1500 -%}{{ section.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
            {%- if section.settings.image.width >= 1780 -%}{{ section.settings.image | image_url: width: 1780 }} 1780w,{%- endif -%}
            {%- if section.settings.image.width >= 2000 -%}{{ section.settings.image | image_url: width: 2000 }} 2000w,{%- endif -%}
            {%- if section.settings.image.width >= 3000 -%}{{ section.settings.image | image_url: width: 3000 }} 3000w,{%- endif -%}
            {%- if section.settings.image.width >= 3840 -%}{{ section.settings.image | image_url: width: 3840 }} 3840w,{%- endif -%}
          "
          sizes="(min-width: 40em) 40vw, 90vw"
          src="{{ section.settings.image | image_url: width: 400 }}"
          loading="lazy"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.width | divided_by: section.settings.image.aspect_ratio }}"
          class="image-inside"
        >
      {% elsif request.design_mode %}
        {{ 'collection-6' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>
  </div>
</div>

{% if section.settings.video != blank %}
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var lazyVideos = [].slice.call(document.querySelectorAll("[data-section-id='{{ section.id }}'] video.lazy"));

      if ("IntersectionObserver" in window) {
        var lazyVideoObserver = new IntersectionObserver(function (entries, observer) {
          entries.forEach(function (video) {
            if (video.isIntersecting) {
              for (var source in video.target.children) {
                var videoSource = video.target.children[source];
                if (typeof videoSource.tagName === "string" && videoSource.tagName === "SOURCE") {
                  videoSource.src = videoSource.dataset.src;
                }
              }

              video.target.load();
              video.target.classList.remove("lazy");
              lazyVideoObserver.unobserve(video.target);
              video.target.play();
            }
          });
        });

        lazyVideos.forEach(function (lazyVideo) {
          lazyVideoObserver.observe(lazyVideo);
        });
      }
    });
  </script>
{% endif %}

{% schema %}
{
  "name": "Image with a frame",
  "tag": "section",
  "class": "section-image-content-wrapper",
  "settings": [
    {
      "type": "color",
      "label": "Background color",
      "id": "background_color"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h1",
          "label": "Heading 1"
        },
        {
          "value": "h2",
          "label": "Heading 2"
        },
        {
          "value": "h3",
          "label": "Heading 3"
        },
        {
          "value": "h4",
          "label": "Heading 4"
        }
      ],
      "default": "h3"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p></p>"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
     {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Video Mobile",
      "info": "If this setting is blank, on mobile it will display the default video"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "desktop_alignment",
      "label": "Desktop image alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "Mobile image order",
      "options": [
        {
          "value": "first",
          "label": "First"
        },
        {
          "value": "last",
          "label": "Last"
        }
      ],
      "default": "first"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "background-primary",
          "label": "Primary"
        },
        {
          "value": "background-secondary",
          "label": "Secondary"
        }
      ],
      "default": "background-primary"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label"
    }
  ],
  "presets": [
    {
      "name": "Image with a frame"
    }
  ]
}
{% endschema %}
