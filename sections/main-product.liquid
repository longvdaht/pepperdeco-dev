{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-rte.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>{{ 'component-price.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-rte.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script>
  var preorder_eta_pom_pom = {{ product.metafields.custom.pre_order_eta.value | json }}
</script>
{% if section.settings.enable_zoom or section.settings.enable_zoom_mobile %}
  <script src="{{ 'pinch-zoom.umd.js' | asset_url }}" defer="defer"></script>
  <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
{% endif %}
{%- assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' -%}

{% render 'breadcrumb-pdp' %}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 992px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="section-outer page-width section-{{ section.id }}-padding">
  <div class="grid product-template-grid">
    <div class="mobile-top__content grid__item mobile-one product-info-wrapper">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
          {%- when 'title' -%}
            <h1 class="display product__title" {{ block.shopify_attributes }}>
              {{ product.title | escape }}
              {{ product.metafields.pepper.type.value }}
            </h1>
          {%- when 'price' -%}
            {% render 'block-price', block: block, section: section %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
    <div class="grid__item mobile-one desktop-two-thirds product-media-wrapper product-media-{{ section.settings.media_thumbnail }}">
      <a class="skip-to-content-link visually-hidden" href="#ProductInfo-{{ section.id }}">
        {{ 'accessibility.skip_to_product_info' | t }}
      </a>
      <slider-component class="{% unless section.settings.show_buttons %} slider-hide-buttons{% endunless %}{% unless section.settings.show_dots %} slider-hide-dots{% endunless %} thumbnail-slider">
        <ul tabindex="0"
          class="list-unstyled slider grid grid-nowrap mobile-one desktop-one"
          id="Slider-{{ section.id }}"
          role="list"
        >
          {%- assign image_count = 0 -%}
          {%- for media in product.media -%}
            {% if media.media_type == 'image' %}
              {%- unless variant_images contains media.src -%}
                {%- assign image_count = image_count | plus: 1 -%}
              {%- endunless -%}
              <li
                class="grid__item carousel-cell{% if forloop.first %} is-active{% endif %}{% if variant_images contains media.src %} product__media-item--variant{% endif %}"
                data-media-id="{{ section.id }}-{{ media.id }}"
              >
                <div class="media media--square">
                  <img
                    srcset="
                      {% if media.width >= 288 %}{{ media | image_url: width: 288 }} 288w,{% endif %}
                      {% if media.width >= 576 %}{{ media | image_url: width: 576 }} 576w,{% endif %}
                      {% if media.width >= 750 %}{{ media | image_url: width: 750 }} 750w,{% endif %}
                      {% if media.width >= 1100 %}{{ media | image_url: width: 1100 }} 1100w,{% endif %}
                      {% if media.width >= 1500 %}{{ media | image_url: width: 1500 }} 1500w{% endif %}
                    "
                    src="{{ media | image_url: width: 1500 }}"
                    sizes="(min-width: 40em) 80px, 100vw"
                    loading="lazy"
                    width="{{ media.width }}"
                    height="{{ media.width | divided_by: media.aspect_ratio }}"
                    alt="{{ media.alt | escape }}"
                    class="image-magnify-hover"
                  >
                </div>
              </li>
            {% elsif media.media_type == 'video' %}
              <li
                class="grid__item carousel-cell{% if variant_images contains media.src %} product__media-item--variant{% endif %} product__media-item-video"
                data-media-id="{{ section.id }}-{{ media.id }}"
              >
                <div class="media--type-video">
                  <div class="media media--square mobile-only">
                    {% if media.sources[1] %}
                      {% assign video_source = media.sources[1] %}
                    {% else %}
                      {% assign video_source = media.sources[0] %}
                    {% endif %}
                    <video class="lazy" 
                      height="{{ video_source.height }}" 
                      width="{{ video_source.width }}" 
                      id="video-{{ section.id }}" playsinline controls loop autoplay muted preload="metadata">
                        <source data-src="{{ video_source.url }}">
                    </video>
                  </div>
                  <div class="desktop-only video-preview-image">
                    <img
                      srcset="
                        {% if media.width >= 288 %}{{ media.preview_image | image_url: width: 288 }} 288w,{% endif %}
                        {% if media.width >= 576 %}{{ media.preview_image | image_url: width: 576 }} 576w,{% endif %}
                        {% if media.width >= 750 %}{{ media.preview_image | image_url: width: 750 }} 750w,{% endif %}
                        {% if media.width >= 1100 %}{{ media.preview_image | image_url: width: 1100 }} 1100w,{% endif %}
                        {% if media.width >= 1500 %}{{ media.preview_image | image_url: width: 1500 }} 1500w{% endif %}
                      "
                      src="{{ media.preview_image | image_url: width: 1500 }}"
                      sizes="(min-width: 40em) 80px, 100vw"
                      loading="lazy"
                      width="{{ media.width }}"
                      height="{{ media.width | divided_by: media.aspect_ratio }}"
                      alt="{{ media.alt | escape }}"
                      class="image-magnify-hover"
                    >
                    <div class="play-icon"> 
                      {% render 'icon-play' %}
                    </div>
                  </div>
                  
                </div>
                {% assign media_alt_text = media.alt | downcase %}
                {% if media_alt_text contains "featured" %}
                  <p class="image-alt-text">{{ media.alt |  remove: 'Featured: ' |  remove: 'FEATURED: ' }}</p>
                {% endif %}
              </li>
            {% endif %}
          {%- endfor -%}
          {%- liquid
            if product.metafields.pepper.trim_images.value
              paginate product.metafields.pepper.trim_images.value by 150
                for media in product.metafields.pepper.trim_images.value
                  assign image_count = image_count | plus: 1
                  render 'additional-thumbnail', media: media, media_title_array: media, image_count: image_count
                endfor
              endpaginate
            endif
          -%}
        </ul>
        
        <div class="slider-dots no-js-hidden">
          {% for media in product.media %}
            <button
              type="button"
              data-index="{{ forloop.index }}"
              class="slider-dot{% if forloop.index0 == 0 %} is-active{% endif %}{% if variant_images contains media.src %} product__media-item--variant{% endif %}"
              name="index"
              aria-label="{{ 'accessibility.slide_index' | t: index: forloop.index }}"
            ></button>
          {% endfor %}
          {%- for media in product.metafields.pepper.trim_images.value -%}
            {%- assign image_count = image_count | plus: 1 -%}
            <button
              type="button"
              data-index="{{ image_count }}"
              class="slider-dot product__media-item--trim-image"
              name="index"
              aria-label="{{ 'accessibility.slide_index' | t: index: image_count }}"
            ></button>
          {%- endfor -%}
        </div>

        <div class="slider-buttons no-js-hidden">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'accessibility.previous_slide' | t }}"
          >
            {% render 'icon-arrow-left' %}
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'accessibility.of' | t }}</span>
            <span class="slider-counter--total">{{ product.images.size }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'accessibility.next_slide' | t }}"
          >
            {% render 'icon-arrow-right' %}
          </button>
        </div>
      </slider-component>

      {% comment %}
        selected_or_first_available_variant.featured_image
      {% endcomment %}
      <slider-component class="main-images-slider slider-hide-buttons slider-hide-dots {% if section.settings.enable_zoom %} enable-zoom{% endif %}">
        <ul tabindex="0"
          class="list-unstyled slider grid grid-nowrap mobile-one desktop-one main-images-slider-list"
          id="Slider-{{ section.id }}"
          role="list"
        >
          {%- for media in product.media -%}
            {% if media.media_type == 'image' %}
              <li
                class="grid__item carousel-cell{% if variant_images contains media.src %} product__media-item--variant{% endif %}"
                data-media-id="{{ section.id }}-{{ media.id }}"
              >
                <div class="media media--square">
                  <img
                    srcset="
                      {% if media.width >= 288 %}{{ media | image_url: width: 288 }} 288w,{% endif %}
                      {% if media.width >= 576 %}{{ media | image_url: width: 576 }} 576w,{% endif %}
                      {% if media.width >= 750 %}{{ media | image_url: width: 750 }} 750w,{% endif %}
                      {% if media.width >= 1100 %}{{ media | image_url: width: 1100 }} 1100w,{% endif %}
                      {% if media.width >= 1500 %}{{ media | image_url: width: 1500 }} 1500w{% endif %}
                    "
                    src="{{ media | image_url: width: 1500 }}"
                    sizes="100vw"
                    loading="lazy"
                    width="{{ media.width }}"
                    height="{{ media.width | divided_by: media.aspect_ratio }}"
                    alt="{{ media.alt | escape }}"
                    class="image-magnify-hover"
                  >
                </div>
                {% assign media_alt_text = media.alt | downcase %}
                {% if media_alt_text contains "featured" %}
                  <p class="image-alt-text">{{ media.alt |  remove: 'Featured: ' |  remove: 'FEATURED: ' }}</p>
                {% endif %}
              </li>
            {% elsif media.media_type == 'video' %}
              <li
                class="grid__item carousel-cell{% if variant_images contains media.src %} product__media-item--variant{% endif %} product__media-item-video"
                data-media-id="{{ section.id }}-{{ media.id }}"
              >
                <div class="media--type-video">
                  <div class="media media--square">
                    {% if media.sources[1] %}
                      {% assign video_source = media.sources[1] %}
                    {% else %}
                      {% assign video_source = media.sources[0] %}
                    {% endif %}
                    <video class="lazy" 
                      height="{{ video_source.height }}" 
                      width="{{ video_source.width }}" 
                      id="video-{{ section.id }}" playsinline controls loop autoplay muted preload="metadata">
                        <source data-src="{{ video_source.url }}">
                    </video>
                  </div>
                </div>
                {% assign media_alt_text = media.alt | downcase %}
                {% if media_alt_text contains "featured" %}
                  <p class="image-alt-text">{{ media.alt |  remove: 'Featured: ' |  remove: 'FEATURED: ' }}</p>
                {% endif %}
              </li>
            {% endif %}
          {%- endfor -%}
          {%- liquid
            if product.metafields.pepper.trim_images.value
              paginate product.metafields.pepper.trim_images.value by 150
                for media in product.metafields.pepper.trim_images.value
                  assign image_count = image_count | plus: 1
                  render 'additional-thumbnail', media: media, media_title_array: media, image_count: image_count
                endfor
              endpaginate
            endif

            if product.has_only_default_variant == false and product.metafields.pepper.piping_options.value.size > 0 and product.metafields.pepper.show_metaobject_trim_piping_images
              assign rendered_handles = '' | split: ''
              paginate metaobjects['trim_piping'].values by 600
                for trim_piping_option in metaobjects['trim_piping'].values
                  assign trim_piping_option_handle = trim_piping_option.name | handle
                  unless rendered_handles contains trim_piping_option_handle
                    for trim_option in product.options_by_name['Trim'].values
                      assign trim_option_handle = trim_option | handle
                      if trim_option_handle == 'none'
                        continue
                      endif
                      if section.settings.enable_pillow_ruffle == false and trim_option_handle contains 'ruffle'
                        continue
                      endif 
                      for trim_size in product.options_by_name['Size'].values
                        for piping_option in product.metafields.pepper.piping_options.value
                          assign piping_option_handle = trim_size | append: ' ' | append: piping_option
                          if piping_option contains 'Fringe' or piping_option contains 'Pom Pom' or piping_option contains 'Ruffle'
                            if piping_option contains 'Fringe'
                              assign type = 'Fringe'
                            elsif piping_option contains 'Ruffle'
                              assign type = 'Ruffle'
                            else
                              assign type = 'Pom Pom'
                            endif
                            assign piping_option_handle = trim_size | append: ' ' | append: piping_option | handle
                          else
                            assign type = 'Piping'
                            assign piping_option_handle = trim_size | append: ' ' | append: piping_option | append: ' Piping' | handle
                          endif
                          if piping_option_handle == trim_piping_option_handle
                            assign image_count = image_count | plus: 1
                            assign media_title_array = 'files-' | append: piping_option_handle
                            render 'additional-thumbnail', media: trim_piping_option.image, media_title_array: media_title_array, image_count: image_count, type: type
                            assign rendered_handles = rendered_handles | append: trim_piping_option_handle | append: ','
                            break
                          endif
                        endfor
                        if rendered_handles contains trim_piping_option_handle
                          break
                        endif
                      endfor
                      if rendered_handles contains trim_piping_option_handle
                        break
                      endif
                    endfor
                  endunless
                endfor
              endpaginate
            endif
           
          -%} 
        </ul>
        {% if section.settings.enable_zoom_mobile %}
          <div class="zoom-wrapper">
            <button class="zoom-in zoom-btn" aria-label="Zoom in">{% render 'icon-zoom-in-new' %}</button>
            <button class="zoom-out zoom-btn hidden" aria-label="Zoom out">{% render 'icon-zoom-out-new' %}</button>            <button class="zoom-out zoom-btn hidden" aria-label="Zoom out">{% render 'icon-zoom-out' %}</button>
          </div>
        {% endif %}
        <div class="slider-dots no-js-hidden">
          {% for media in product.media %}
            <button
              type="button"
              data-index="{{ forloop.index }}"
              class="slider-dot{% if forloop.index0 == 0 %} is-active{% endif %}{% if variant_images contains media.src %} product__media-item--variant{% endif %}"
              name="index"
              aria-label="{{ 'accessibility.slide_index' | t: index: forloop.index }}"
            ></button>
          {% endfor %}
        </div>
        <div class="slider-buttons no-js-hidden">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'accessibility.previous_slide' | t }}"
          >
            {% render 'icon-arrow-left' %}
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'accessibility.of' | t }}</span>
            <span class="slider-counter--total">{{ product.images.size }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'accessibility.next_slide' | t }}"
          >
            {% render 'icon-arrow-right' %}
          </button>
        </div>
      </slider-component>
    </div>
    <div class="grid__item mobile-one desktop-one-third product-info-wrapper">
      <div id="ProductInfo-{{ section.id }}">
        {%- assign product_form_id = 'product-form-' | append: section.id -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'title' -%}
              <h1 class="display product__title" {{ block.shopify_attributes }}>
                {{ product.title | escape }}
                {{ product.metafields.pepper.type.value }}
              </h1>
            {%- when 'price' -%}
              {% render 'block-price', block: block, section: section %}
            {%- when 'description' -%}
              <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
              {%- if product.description != blank -%}
                <div class="product-description-wrapper parent-display" id="Show-More-Description">
                  <div class="product__description rte parent-wrap">
                    {{ product.description }}
                  </div>
                  <show-more-button class="rte">
                    <button
                      class="button-show-more link underlined-link"
                      id="Show-More-{{ forloop.index }}-{{ section.id }}"
                      type="button"
                    >
                      <span class="label-show-more label-text"
                        ><span aria-hidden="true">+ </span>{{ 'products.facets.show_more' | t -}}
                      </span>
                      <span class="label-show-less label-text hidden"
                        ><span aria-hidden="true">- </span>{{ 'products.facets.show_less' | t -}}
                      </span>
                    </button>
                  </show-more-button>
                </div>
              {%- endif -%}
            {%- when 'spacer_block' -%}
              <div
                {{ block.shopify_attributes }}
                style="margin-top: {{ block.settings.spacing | divided_by: 10 }}rem"
              ></div>
            {%- when 'switch_option' %}
              {%- render 'switch-option' -%}
            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                {%- if block.settings.picker_type == 'button' -%}
                  <variant-radios
                    class="no-js-hidden"
                    data-section="{{ section.id }}"
                    data-url="{{ product.url }}"
                    {{ block.shopify_attributes }}
                  >
                    {%- for option in product.options_with_values -%}
                      <fieldset class="js product-form__input product-form__input-{{ option.name | handleize }}">
                        <option-dropdown data-dropdown-key="{{ option.name | handleize }}">
                          <button type="button" data-dropdown-trigger aria-expanded="false">
                            <legend class="form__label">
                              {{ option.name }}:
                              {% if option.name == 'Trim' %}
                                <div class="trim-select-option">
                                  <span id="{{ section.id }}-option-{{ forloop.index0 }}" data-trim-selected><span class="option-not-selected">{{ 'products.product.select_trim' | t }}</span></span>
                                  <span class="trigger-swatch" data-trim-swatch></span>
                                </div>
                              {% else %}
                                <span id="{{ section.id }}-option-{{ forloop.index0 }}">
                                  {% if option.name == 'Size' %}
                                    <span class="option-not-selected">{{ 'products.product.select_size' | t }}</span>
                                  {% elsif option.name contains 'Insert' %}
                                    <span class="option-not-selected">{{ 'products.product.select_insert' | t }}</span>
                                  {% elsif option.name != 'Length' %}
                                    {{ option.selected_value }}
                                  {% endif %}
                                  {% comment %} {%- unless option.name == 'Length' %}{{ option.selected_value }}{% endunless -%} {% endcomment %}
                                </span>
                              {% endif %}
                              {%- if option.name == 'Construction' -%}
                                <a href="#additional-construction-options" class="option-link">?</a>
                              {%- endif %}
                            </legend>
                            {% render 'icon-chevron-up' %}
                            {% render 'icon-chevron-down-pdp' %}
                          </button>
                          <div data-dropdown-panel>
                            {%- for value in option.values -%}
                              <input
                                type="radio"
                                id="{{ section.id }}-{{ option.name }}-{{ forloop.index0 }}"
                                name="{{ option.name }}"
                                value="{{ value | escape }}"
                                form="product-form-{{ section.id }}"
                                class="input-{{ option.name | handleize }}"
                                {% if option.selected_value == value and product.selected_variant != nil %}
                                  checked
                                  
                                {% endif %}
                                {% if option.values.size <= 1 %}
                                  checked 
                                {% endif %}
                              >
                              <label
                                for="{{ section.id }}-{{ option.name }}-{{ forloop.index0 }}"
                                class="{{ option.name | handleize }}-radio {{ option.name | handleize }}-{{ value | handleize }}{% if option.name == 'Length' or option.name == 'Trim' %} visually-hidden{% endif %} {{ option.name | handleize }}-radio-{{ product.type | handleize }}"
                              >
                                {{ value }}
                              </label>
                            {%- endfor -%}
                            {% if option.name == 'Length' %}
                              <div class="line-item-property__field">
                                <input
                                  required
                                  class="required length-input"
                                  type="text"
                                  id="length"
                                  placeholder="Enter length"
                                  id="length"
                                  name="properties[Length]"
                                  inputmode="numeric"
                                  form="product-form-{{ section.id }}"
                                >
                              </div>
                            {% endif %}
                            {% if option.name == 'Trim' %}
                              {% render 'piping-radios' %}
                            {% endif %}
                          </div>
                        </option-dropdown>
                      </fieldset>
                      {% if option.name == 'Length' %}
                        <div class="product-form__input">
                          <div class="form__label">Lining: <span id="option-lining-legend">Privacy</span></div>

                          <input
                            type="radio"
                            id="{{ section.id }}-Lining-privacy"
                            required
                            name="properties[Lining]"
                            value="Privacy"
                            form="product-form-{{ section.id }}"
                            class="required input-lining"
                            checked
                          >
                          <label for="{{ section.id }}-Lining-privacy" class="lining-radio lining-privacy">
                            Privacy
                          </label>
                          <input
                            type="radio"
                            id="{{ section.id }}-Lining-blackout"
                            required
                            name="properties[Lining]"
                            value="Blackout"
                            form="product-form-{{ section.id }}"
                            class="required input-lining"
                          >
                          <label for="{{ section.id }}-Lining-blackout" class="lining-radio lining-blackout">
                            Blackout
                          </label>
                        </div>
                      {% endif %}
                    {%- endfor -%}
                    <script type="application/json" data-variants>
                      {{ product.variants | json }}
                    </script>
                  </variant-radios>
                {%- else -%}
                  <variant-selects
                    class="no-js-hidden"
                    data-section="{{ section.id }}"
                    data-url="{{ product.url }}"
                    {{ block.shopify_attributes }}
                  >
                    {%- for option in product.options_with_values -%}
                      <fieldset class="product-form__input product-form__input--dropdown">
                        <option-dropdown data-dropdown-key="{{ option.name | handleize }}">
                          <button type="button" data-dropdown-trigger aria-expanded="false">
                            <legend class="form__label">
                              <div class="contruction-wrapper">
                                {{ option.name }}:
                              </div>
                              <span id="{{ section.id }}-option-{{ forloop.index0 }}">
                                {%- if product.selected_variant == nil %}
                                  <span class="option-not-selected">Select {{ option.name | downcase }}</span>
                                {% else %}
                                  {{ option.selected_value }}
                                {% endif %}
                                {% comment %} {%- if option.name == 'Length' %}
                                  72" (standard)
                                {% endif -%} {% endcomment %}

                              </span>
                            </legend>
                            {% render 'icon-chevron-up' %}
                            {% render 'icon-chevron-down-pdp' %}
                          </button>
                          <div data-dropdown-panel>
                            <div class="select">
                              <select
                                id="Option-{{ section.id }}-{{ forloop.index0 }}"
                                class="select__select"
                                name="options[{{ option.name | escape }}]"
                                form="product-form-{{ section.id }}"
                              >
                                
                                {%- if option.name == 'Yards' -%}
                                  <option value="{{ option.values | first | escape }}" selected="selected">
                                    {{ 'products.product.yard_dropdown_label' | t }}
                                  </option>
                                {% else %}
                                  <option value selected="selected" disabled> Select {{ option.name | downcase }}</option>
                                {%- endif -%}
                                {%- for value in option.values -%}
                                  <option
                                    value="{{ value | escape }}"
                                    {% if option.selected_value == value and product.selected_variant != nil %}
                                      selected="selected"
                                    {% endif %}
                                  >
                                    {{ value }}
                                  </option>
                                {%- endfor -%}
                              </select>
                            </div>
                          </div>
                        </option-dropdown>
                      </fieldset>
                    {%- endfor -%}

                    <script type="application/json" data-variants>
                      {{ product.variants | json }}
                    </script>
                  </variant-selects>
                {%- endif -%}
              {%- endunless -%}

              {%- if product.vendor == 'Kassatex' and product.type == 'Bath Towel' -%}
                {{ 'component-kassatex-personalization.css' | asset_url | stylesheet_tag }}
                <script src="{{ 'component-kassatex-personalization.js' | asset_url }}" defer="defer"></script>
                <kassatex-personalization class="no-js-hidden">
                  <div class="product-form__input product-form__input-embroidery">
                    <input type="hidden" name="properties[_Embroidery]" value="None" form="{{ product_form_id }}">
                    <label class="form__label" for="embroidery-true">
                      <input
                        type="checkbox"
                        name="properties[_Embroidery]"
                        value="true"
                        id="embroidery-true"
                        form="{{ product_form_id }}"
                        data-embroidery-Id="{{ all_products['monogramming-fee'].selected_or_first_available_variant.id }}"
                      >
                      Add Embroidery (+
                      {{-
                        all_products['monogramming-fee'].selected_or_first_available_variant.price
                        | money_without_trailing_zeros
                      -}}
                      )
                    </label>
                  </div>
                  <div class="product-form__input product-form__input-ks-type">
                    <input
                      type="radio"
                      name="properties[_Embroidery Type]"
                      id="monogram"
                      value="Monogram"
                      form="{{ product_form_id }}"
                    >
                    <label for="monogram">Monogram</label>
                    <input
                      type="radio"
                      name="properties[_Embroidery Type]"
                      id="text"
                      value="Text"
                      form="{{ product_form_id }}"
                    >
                    <label for="text">Text</label>
                  </div>
                  <div class="product-form__input product-form__input-thread-color">
                    {%- assign thread_colors = 'Sand,Sage,Navy,Light Blue,Coral' | split: ',' -%}
                    <div class="form__label">{{ 'products.product.embroidery_color_name' | t }}: <span id="embroidery-color-legend"></span></div>
                    {%- for color in thread_colors -%}
                      <input
                        type="radio"
                        name="properties[Thread Color]"
                        id="{{ color | downcase }}"
                        value="{{ color }}"
                        form="{{ product_form_id }}"
                        class="embroidery-thread-color-input input-trim-option"
                      >
                      <label
                        for="{{ color | downcase }}"
                        class="embroidery-color trim-option-radio color-ks-{{ color | handle }}"
                      >
                        {{- color -}}
                      </label>
                    {%- endfor -%}
                  </div>
                  <div class="product-form__input ks-type-options">
                    {%- assign typefaces = 'English Script, Felix Tilting, Point Monogram' | split: ', ' -%}
                    <div class="form__label">Typeface: <span id="type-option-legend"></span></div>
                    <div class="ks-type-options-wrapper">
                      {%- for typeface in typefaces -%}
                        <div
                          class="typeface-wrapper{% if typeface contains 'Monogram' %} hidden{% endif %}"
                          {% if typeface contains 'Monogram' %}
                            data-monogram
                          {% else %}
                            data-text
                          {% endif %}
                        >
                          <input
                            type="radio"
                            name="properties[Typeface]"
                            id="{{ typeface | downcase }}"
                            value="{{ typeface }}"
                            form="{{ product_form_id }}"
                            class="embroidery-type-radio field__input"
                          >
                          <label
                            for="{{ typeface | downcase }}"
                            class="embroidery-type-radio embroidery-text type-option-{{ typeface | handle }}"
                          >
                            {{- typeface -}}
                          </label>
                        </div>
                      {%- endfor -%}
                    </div>
                  </div>
                  <div class="product-form__input">
                    <label for="personalization" class="form__label">Personalization</label>
                    <input
                      type="text"
                      name="properties[Personalization]"
                      id="personalization"
                      class="additional-input kassatex"
                      form="{{ product_form_id }}"
                    >
                    <div id="Helper-Monogram" class="hidden form__label personalization-helper">
                      3 Letters—First Initial, Last Initial, Middle Initial
                    </div>
                    <div id="Helper-Text" class="hidden form__label personalization-helper">
                      1-16 Characters—letters, numbers, or keyboard symbols
                    </div>
                  </div>
                </kassatex-personalization>
              {%- endif -%}

              <noscript>
                <div class="product-form__input{% if product.has_only_default_variant %} hidden{% endif %}">
                  <label class="form__label" for="Variants-{{ section.id }}">
                    {{- 'products.product.product_variants' | t -}}
                  </label>
                  <div class="select">
                    <select name="id" id="Variants-{{ section.id }}" class="select__select" form="product-form">
                      {%- for variant in product.variants -%}
                        <option
                          {% if variant == product.selected_or_first_available_variant %}
                            selected="selected"
                          {% endif %}
                          {% if variant.available == false %}
                            disabled
                          {% endif %}
                          value="{{ variant.id }}"
                        >
                          {{ variant.title }}
                          {%- if variant.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}
                          - {{ variant.price | money | strip_html }}
                        </option>
                      {%- endfor -%}
                    </select>
                  </div>
                </div>
              </noscript>
            {%- when 'wallpaper_calculator' -%}
              <details-modal class="product__modal wallpaper-calc-modal" {{ block.shopify_attributes }}>
                <details>
                  <summary
                    class="modal__toggle{% if block.settings.icon != blank %} has-icon{% endif %}"
                    aria-haspopup="dialog"
                    aria-label="{{ block.settings.content }} Calculate yardage"
                  >
                    {{ block.settings.content }}
                    <div class="wrapper-content">
                      {%- if block.settings.icon != blank -%}
                        <span class="svg-wrapper">
                          <img src="{{ block.settings.icon | image_url: width: 50 }}" width="30" height="30" alt="{{ block.settings.text_link }}">
                        </span>
                      {%- endif -%}
                      <span class="text-link"
                        >Calculate {% if product.tags contains 'solid grasscloth' %}rolls{% else %}yardage{% endif -%}
                      </span>
                    </div>
                  </summary>
                  <div
                    class="product-modal modal__content"
                    role="dialog"
                    aria-modal="true"
                    aria-label="{{ block.settings.content }} Calculate {% if product.tags contains 'solid grasscloth' %}rolls{% else %}yardage{% endif -%}"
                  >
                    <div class="modal-overlay"></div>
                    <div class="product-modal__content" tabindex="-1">
                      <link
                        rel="stylesheet"
                        href="{{ 'wallpaper-calculator.css' | asset_url }}"
                        media="print"
                        onload="this.media='all'"
                      >
                      <noscript>{{ 'wallpaper-calculator.css' | asset_url | stylesheet_tag }}</noscript>
                      <script src="{{ 'wallpaper-calculator.js' | asset_url }}" defer="defer"></script>
                      <div id="wallpaper-calculator"></div>
                      <button
                        type="button"
                        class="modal__close-button link button-unstyled focus-inset"
                        aria-label="{{ 'accessibility.close' | t }}"
                      >
                        <i class="fas fa-xmark icon"></i>
                      </button>
                    </div>
                  </div>
                </details>
              </details-modal>
            {%- when 'tablecloth_calculator' -%}
              {% if block.settings.link != blank %}
                <div class="product__modal wallpaper-calc-modal furniture-calculator tablecloth-link" {{ block.shopify_attributes }}>
                  <div class="modal__toggle">
                    {{ block.settings.content }}
                    {%- if block.settings.icon != blank -%}
                      <span class="svg-wrapper">
                        <img src="{{ block.settings.icon | image_url: width: 50 }}" width="30" height="30" alt="{{ block.settings.text_link }}">
                      </span>
                    {%- endif -%}
                    <a class="text-link" target="_blank" href="{{ block.settings.link }}" title="{{ block.settings.text_link }}">{{ block.settings.text_link }}</a>
                  </div>
                </div>
              {% else %}
                <details-modal class="product__modal wallpaper-calc-modal furniture-calculator" {{ block.shopify_attributes }}>
                  <details>
                    <summary
                      class="modal__toggle"
                      aria-haspopup="dialog"
                      aria-label="{{ block.settings.content }} Calculate yardage"
                    >
                      {{ block.settings.content }}
                      <div class="wrapper-content">
                        {%- if block.settings.icon != blank -%}
                          <span class="svg-wrapper">
                            <img src="{{ block.settings.icon | image_url: width: 50 }}" width="30" height="30" alt="{{ block.settings.text_link }}">
                          </span>
                        {%- endif -%}
                        <span class="text-link">{{ block.settings.text_link }} </span>
                      </div>
                    </summary>
                    <div
                      class="product-modal modal__content furniture_calculator"
                      role="dialog"
                      aria-modal="true"
                      aria-label="{{ block.settings.content }} {{ block.settings.text_link }}"
                    >
                      <div class="modal-overlay"></div>
                      <div class="product-modal__content" tabindex="-1">
                        {%- if block.settings.popup_content_image != blank -%}
                          <img src="{{ block.settings.popup_content_image | image_url: width: 1000 }}" width="1000" height="1000">
                          {%- endif -%}
                        <button
                          type="button"
                          class="modal__close-button link button-unstyled focus-inset"
                          aria-label="{{ 'accessibility.close' | t }}"
                        >
                          <i class="fas fa-xmark icon"></i>
                        </button>
                      </div>
                    </div>
                  </details>
                </details-modal>
              {% endif %}
            {%- when 'curtain_calculator' -%}
              <details-modal class="product__modal{% if block.settings.icon != blank %} has-icon{% endif %}" {{ block.shopify_attributes }}>
                <details>
                  <summary
                    class="modal__toggle{% if block.settings.icon != blank %} has-icon{% endif %}"
                    aria-haspopup="dialog"
                    aria-label="{{ block.settings.content }} Calculate dimensions"
                  >
                    {{ block.settings.content }}
                    {%- if block.settings.icon != blank -%}
                      <span class="svg-wrapper">
                        <img src="{{ block.settings.icon | image_url: width: 50 }}" width="30" height="30" alt="{{ block.settings.text_link }}">
                      </span>
                    {%- endif -%}
                    <span class="text-link">Calculate dimensions</span>
                  </summary>
                  <div
                    class="product-modal modal__content"
                    role="dialog"
                    aria-modal="true"
                    aria-label="{{ block.settings.content }} Calculate dimensions"
                  >
                    <div class="modal-overlay"></div>
                    <div class="product-modal__content" tabindex="-1">
                      <link
                        rel="stylesheet"
                        href="{{ 'curtain-calculator.css' | asset_url }}"
                        media="print"
                        onload="this.media='all'"
                      >
                      <noscript>{{ 'curtain-calculator.css' | asset_url | stylesheet_tag }}</noscript>
                      <script src="{{ 'curtain-calculator.js' | asset_url }}" defer="defer"></script>
                      <div id="curtain-calculator"></div>
                      <button
                        type="button"
                        class="modal__close-button link button-unstyled focus-inset"
                        aria-label="{{ 'accessibility.close' | t }}"
                      >
                        {%- render 'icon-close' -%}
                      </button>
                    </div>
                  </div>
                </details>
              </details-modal>
            {%- when 'quantity_selector' -%}
              <div
                class="product-form__input product-form__quantity{% if product.type == 'Fabric By The Yard' or product.type == 'Wallpaper' or product.type == 'Artwork' %}{% unless product.type == 'Wallpaper' and product.tags contains 'solid grasscloth' %} product-form__quantity-hidden{% endunless %}{% endif %}{% if product.type contains 'Trim' or product.type contains 'Piping' %} product-form__quantity-hidden{% endif %}{% if product.metafields.pepper.external_product_page_link != blank %} product-form__quantity-hidden{% endif %}"
                {{ block.shopify_attributes }}
              >
                <label class="form__label" for="Quantity-{{ section.id }}">
                  {% if product.type == 'Curtain' %}
                    {{ 'products.product.quantity.curtain_label' | t }}:
                  {% elsif product.type == 'Wallpaper' and product.tags contains 'solid grasscloth' %}
                    {{ 'products.product.quantity.rolls_label' | t }}:
                  {% else %}
                    {{ 'products.product.quantity.label' | t }}:
                  {% endif %}
                </label>

                <quantity-input class="quantity" data-section="{{ section.id }}">
                  <button
                    class="quantity__button no-js-hidden{% if product.type == 'Fabric By The Yard' or product.type == 'Wallpaper' or product.type == 'Artwork' %}{% unless product.type == 'Wallpaper' and product.tags contains 'solid grasscloth' %} visually-hidden{% endunless %}{% endif %}"
                    name="minus"
                    type="button"
                    {% if product.type == 'Fabric By The Yard' or product.type == 'Wallpaper' %}
                      {% unless product.type == 'Wallpaper' and product.tags contains 'solid grasscloth' %}
                        disabled
                      {% endunless %}
                    {% endif %}
                  >
                    <span class="visually-hidden">
                      {{- 'products.product.quantity.decrease' | t: product: product.title | escape -}}
                    </span>
                    <span class="minus"></span>
                  </button>
                  <input
                    class="quantity-input"
                    type="number"
                    name="quantity"
                    id="Quantity-{{ section.id }}"
                    min="1"
                    {% if product.type == 'Sample Sale' %}
                      max="{{ product.selected_or_first_available_variant.inventory_quantity }}"
                    {% endif %}
                    value="1"
                    form="product-form-{{ section.id }}"
                    {% if product.type == 'Fabric By The Yard'
                      or product.type == 'Wallpaper'
                      or product.type == 'Artwork'
                    %}
                      {% unless product.type == 'Wallpaper' and product.tags contains 'solid grasscloth' %}
                        disabled
                      {% endunless %}
                    {% endif %}
                  >
                  <button
                    class="quantity__button no-js-hidden{% if product.type == 'Fabric By The Yard' or product.type == 'Wallpaper' or product.type == 'Artwork' %}{% unless product.type == 'Wallpaper' and product.tags contains 'solid grasscloth' %} visually-hidden{% endunless %}{% endif %}"
                    name="plus"
                    type="button"
                    {% if product.type == 'Fabric By The Yard' or product.type == 'Wallpaper' %}
                      {% unless product.type == 'Wallpaper' and product.tags contains 'solid grasscloth' %}
                        disabled
                      {% endunless %}
                    {% endif %}
                  >
                    <span class="visually-hidden">
                      {{- 'products.product.quantity.increase' | t: product: product.title | escape -}}
                    </span>
                    <span class="plus"></span>
                  </button>
                </quantity-input>
              </div>
            {%- when 'bundle_buy_buttons' -%}
              <script src="{{ 'bundle-button.js' | asset_url }} " defer="defer"></script>
              <bundle-button>
                {% for variant in product.variants %}
                  {% if variant.metafields.pepper.bundle_variants.value != blank %}
                    <script type="application/json" data-variant-id="{{ variant.id }}">
                      {%- for bundle_variants in variant.metafields.pepper.bundle_variants.value -%}
                        {%- if forloop.first %}[{%- endif -%}
                        {"id": "{{ bundle_variants.id }}", "quantity": "{{ variant.metafields.pepper.bundle_quantities.value | slice: forloop.index0 }}", "properties": { "Trim": "{{ variant.metafields.pepper.bundle_trims.value | slice: forloop.index0 }}", "_bundled": "true", "_Embroidery": "false", "Embroidery Color": "", "_customized_image": "", "Typeface": "", "_product_image": "", "_Max Width": "", "_Max Height": "", "_Embroidery Type": "", "Personalization": ""}
                        {%- unless forloop.last -%}},{%- endunless -%}
                        {%- if forloop.last -%}}]{%- endif -%}
                      {%- endfor -%}
                    </script>
                  {% endif %}
                {% endfor %}
                <div class="product-form__buttons">
                  <button
                    type="button"
                    name="bundle"
                    class="product-form__submit button button--primary"
                    {% if product.selected_or_first_available_variant.available == false %}
                      disabled
                    {% endif %}
                  >
                    {%- if product.selected_or_first_available_variant.available -%}
                      {% assign price = product.selected_or_first_available_variant.price
                        | money_without_trailing_zeros
                      %}
                      {{ 'products.product.add_to_cart_html' | t: price: price }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </button>
                </div>
              </bundle-button>
            {%- when 'buy_buttons' -%}
              <div class="product-form__buy" {{ block.shopify_attributes }}>
                <product-form class="product-form">
                  <div class="product-form__error-message-wrapper" role="alert" hidden>
                    <span class="product-form__error-message"></span>
                  </div>
                  {%- form 'product', product, id: product_form_id, class: 'form', data-type: 'add-to-cart-form' -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

                    {% assign product_type = product.type | downcase %}

                    {% unless product.template_suffix == 'swatch-and-samples'
                      or product.template_suffix == 'yardage'
                      or product_type == 'wallpaper'
                      or product_type == 'wallpaper swatch'
                    %}
                      {% if product.metafields.custom.fabric_type != blank %}
                        <input
                          type="hidden"
                          name="properties[Fabric Type]"
                          value="{{ product.metafields.custom.fabric_type | escape }}"
                        >
                      {% endif %}
                    {% endunless %}
  
                    {%- if section.settings.pompom_message != blank and section.settings.pompom_trims != blank -%}
                      <input type="hidden" name="properties[_pre_order_eta_message]" value="{{ section.settings.pompom_message | escape }}">
                      <input type="hidden" name="properties[_pre_order_eta_trims]" value="{{ section.settings.pompom_trims | escape }}">
                    {%- endif -%}

                    {% comment %} {%- if customer and customer.b2b? -%}
                      {%- liquid
                        assign company = customer.current_company
                        assign trade_tier = company.metafields.custom.trade_tier.value
                        case trade_tier
                          when 'TIER 2', 'Tier 2'
                            assign discount_percent = 20
                          when 'TIER 3', 'Tier 3'
                            assign discount_percent = 25
                          else
                            assign discount_percent = 15
                        endcase
                        assign discount_decimal = discount_percent | divided_by: 100.0
                        assign multiplier = 1.0 | minus: discount_decimal
                        assign original_price = product.selected_or_first_available_variant.price | times: 1.0 | divided_by: multiplier | round
                      -%}
                      <input type="hidden" 
                              name="properties[Original Price]" 
                              id="b2b-original-price-input"
                              value="{{ original_price | money_without_trailing_zeros }}">
                      <input type="hidden" 
                            name="properties[Trade Discount]" 
                            value="{{ discount_percent }}%">
                    {%- endif -%} {% endcomment %}

                    {%- if customer and customer.b2b? -%}
                      {%- liquid
                        # Check once whether this customer holds any trade tag
                        assign trade_tag_list = 'trade,trade15,trade20,trade30' | split: ','
                        assign is_trade_member = false
                        for tag in customer.tags
                          assign tag_clean = tag | downcase | strip
                          if trade_tag_list contains tag_clean
                            assign is_trade_member = true
                            break
                          endif
                        endfor

                        # Product tagged SAMPLESALE?
                        assign is_sample_sale = false
                        for tag in product.tags
                          assign tag_clean = tag | downcase | strip
                          if tag_clean == 'samplesale'
                            assign is_sample_sale = true
                            break
                          endif
                        endfor

                        # Skip trade properties only when a trade member buys a SAMPLESALE product
                        assign hide_trade_info = false
                        if is_trade_member and is_sample_sale
                          assign hide_trade_info = true
                        endif

                        assign company = customer.current_company
                        assign trade_tier = company.metafields.custom.trade_tier.value
                        case trade_tier
                          when 'TIER 2', 'Tier 2'
                            assign discount_percent = 20
                          when 'TIER 3', 'Tier 3'
                            assign discount_percent = 25
                          else
                            assign discount_percent = 15
                        endcase
                        assign discount_decimal = discount_percent | divided_by: 100.0
                        assign multiplier = 1.0 | minus: discount_decimal
                        assign original_price = product.selected_or_first_available_variant.price | times: 1.0 | divided_by: multiplier | round
                      -%}
                      {%- unless hide_trade_info -%}
                        <input type="hidden"
                              name="properties[Original Price]"
                              id="b2b-original-price-input"
                              value="{{ original_price | money_without_trailing_zeros }}">
                        <input type="hidden"
                              name="properties[Trade Discount]"
                              value="{{ discount_percent }}%">
                      {%- endunless -%}
                    {%- endif -%}

                    <div class="product-form__buttons">
                      <button
                        type="submit"
                        name="add"
                        class="product-form__submit button {% if block.settings.show_dynamic_checkout and product.selling_plan_groups == empty %}button--secondary{% else %}button--primary{% endif %}"
                        {% if product.selected_or_first_available_variant.available == false %}
                          disabled
                        {% endif %}
                        {% if product.selected_variant == nil and product.has_only_default_variant == false %}
                          disabled
                        {% endif %}
                      >
                        {% if product.selected_variant == nil and product.has_only_default_variant == false %}
                          {{ 'products.product.choose_options' | t }}
                        {%- elsif product.selected_or_first_available_variant.available -%}
                          {% assign price = product.selected_or_first_available_variant.price
                            | money_without_trailing_zeros
                          %}
                          {{ 'products.product.add_to_cart_html' | t: price: price }}
                        {%- else -%}
                          {{ 'products.product.sold_out' | t }}
                        {%- endif -%}
                      </button>
                      {%- if block.settings.show_dynamic_checkout -%}
                        {{ form | payment_button }}
                      {%- endif -%}
                    </div>
                  {%- endform -%}
                </product-form>
              </div>
              <div class="b2b-mobile">
                {% render 'b2b-trade-info' %}
              </div>
            {%- when 'shop_pay' -%}
              <div {{ block.shopify_attributes }}>
                {%- form 'product', product, id: 'product-form-installment', class: 'installment caption-large' -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  {{ form | payment_terms }}
                {%- endform -%}
              </div>
            {%- when 'tabset' -%}
              {% render 'product-details-tabset', block: block, product: product %}
            {%- when 'color_matching' -%}
              <div class="product-form__input product-form__input-color-matching product-form__input-checkbox">
                <input
                  type="checkbox"
                  id="{{ section.id }}-color-matching"
                  name="properties[_color_matching]"
                  value="1"
                  form="product-form-{{ section.id }}"
                  class="input-color-matching visually-hidden"
                >
                <label for="{{ section.id }}-color-matching" class="form__label">
                  {{- 'products.product.color_matching' | t -}}
                </label>
                <label for="{{ section.id }}-color-matching-order" class="form__label visually-hidden">
                  {{ 'products.product.color_matching_order' | t }}
                </label>
                <input
                  type="text"
                  id="{{ section.id }}-color-matching-order"
                  name="properties[Color Match Order]"
                  value=""
                  form="product-form-{{ section.id }}"
                  class="color-match-input additional-input"
                  pattern="[0-9]{5,7}"
                  placeholder="{{ 'products.product.color_matching_order' | t }}"
                  title="{{ 'products.product.color_matching_order_msg' | t }}"
                >
                {{ 'products.product.color_matching_description_html' | t }}
              </div>
            {%- when 'rush_processing' -%}
              {%- liquid
                assign rush_price = block.settings.rush_processing_product.price | divided_by: 100
                assign rush_product = block.settings.rush_processing_product.selected_or_first_available_variant
              -%}
              <div class="product-form__input product-form__input-rush-processing">
                <input
                  type="checkbox"
                  id="{{ section.id }}-rush-processing"
                  name="properties[Rush Processing]"
                  value="{{ block.settings.rush_processing_product.handle }}"
                  form="product-form-{{ section.id }}"
                  class="input-rush-processing visually-hidden"
                  data-product="{{ rush_product.id }}"
                >
                <label for="{{ section.id }}-rush-processing" class="form__label">
                  Add {{ block.settings.rush_processing_product.title }} +${{ rush_price }}
                </label>
              </div>
            {%- when 'embroidery_options' -%}
              <link
                rel="stylesheet"
                href="{{ 'embroidery-webfonts.css' | asset_url }}"
              >
              <script src="{{ 'html2canvas.min.js' | asset_url }}" defer></script>
              {%- assign embroidery_product = block.settings.product -%}
              {%- if template.suffix contains 'pouch' -%}
                <input
                  type="hidden"
                  name="properties[_product_image]"
                  form="product-form-{{ section.id }}"
                  value="{{ product.media.last | image_url: width: 1500 }}"
                >
              {%- endif -%}
              
              <details-modal-embroidery class="product__modal product__modal-embroidery{% if product.metafields.custom.disable_personalization %} hidden{% endif %}">
                <div class="embroidery__error-message-wrapper" role="alert" hidden>
                  <span class="embroidery__error-message"></span>
                </div>

                <details>
                  <summary
                    class="modal__toggle button button--outline"
                    aria-haspopup="dialog"
                    aria-label="Add embroidery"
                  >
                    Personalize (+{{ embroidery_product.price | money_without_trailing_zeros }})
                  </summary>
                  <div
                    class="product-modal modal__content"
                    role="dialog"
                    aria-modal="true"
                    aria-label="Add embroidery"
                  >
                    <div class="modal-overlay"></div>
                    <div class="product-modal__content template-embroidery" tabindex="-1">
                      <link
                        rel="stylesheet"
                        href="{{ 'embroidery-modal.css' | asset_url }}"
                        media="print"
                        onload="this.media='all'"
                      >
                      <noscript>{{ 'embroidery-modal.css' | asset_url | stylesheet_tag }}</noscript>
                      <script src="{{ 'embroidery-options.js' | asset_url }}" defer="defer"></script>
                      {% render 'embroidery-options',
                        embroidery_product: embroidery_product,
                        product_form_id: product_form_id
                      %}
                    </div>
                  </div>
                </details>
              </details-modal-embroidery>
             
            {%- when 'personalization' -%}
              {%- unless product.title contains 'STACKER' -%}
                {{ 'personalization-input.css' | asset_url | stylesheet_tag }}
                {{ '//fonts.googleapis.com/css2?family=Comfortaa&display=swap' | stylesheet_tag }}
                <personalization-input
                  class="line-item-property__field product-form__input line-item__customization field letter__color-{{ letter_color_options.first | handleize | downcase | default: 'white' }}"
                  data-section="{{ section.id }}"
                  data-spacer-option="{{ product.metafields.namesforgood.spacer_options.value | handleize | default: 'heart' }}"
                >
                  <label for="Customization-{{ section.id }}" class="form__label">
                    {{ block.settings.label }}
                  </label>
                  <div class="field__button--end field">
                    <input
                      class="required focus-inset focus-visible field__input"
                      type="text"
                      maxlength="10"
                      placeholder=""
                      id="Customization-{{ section.id }}"
                      name="properties[{{ block.settings.label | escape }}]"
                      form="{{ product_form_id }}"
                      required
                    >
                    <details class="customization-options-wrapper">
                      <summary>
                        <i class="fas fa-keyboard icon"></i>
                      </summary>
                      <div class="customization-options">
                        <div class="h6">Choose Symbol</div>
                        <ul class="customization-symbols" role="list">
                          <li class="symbol">&hearts;</li>
                        </ul>
                      </div>
                    </details>
                  </div>
                  <div id="Customization-Output-{{ section.id }}" class="customization-output"></div>
                  <div id="Customization-Error-{{ section.id }}" class="customization-error"></div>
                  {%- if product.metafields.namesforgood.personalization_note.value != blank -%}
                    <p class="rte">{{ product.metafields.namesforgood.personalization_note.value }}</p>
                  {%- else -%}
                    <p class="rte">{{ block.settings.note }}</p>
                  {%- endif -%}
                </personalization-input>
                <script src="{{ 'personalization-input.js' | asset_url }}" defer></script>
              {%- endunless -%}
            {%- when 'quick_add' -%}
              {%- unless block.settings.product == blank -%}
                <script src="{{ 'quick-add-button.js' | asset_url }}" defer></script>
                {%- assign quick_add_product = block.settings.product -%}
                {%- capture sample_or_swatch -%}
                {%- if quick_add_product.type contains 'Trim'
                  or quick_add_product.type contains 'Piping'
                  or quick_add_product.type contains 'Rug'
                  or quick_add_product.type contains 'Fringe'
                  or quick_add_product.type contains 'Ruffle'
                -%}Sample{%- elsif quick_add_product.type contains 'Wallpaper'
                  or quick_add_product.type contains 'Fabric'
                -%}Swatch{%- endif -%}{%- endcapture -%}
                <div {{ block.shopify_attributes }}>
                  <quick-add-button>
                    <button
                      type="button"
                      class="button-unstyled button button--quick-add no-js-hidden"
                      data-variant-id="{{ quick_add_product.selected_or_first_available_variant.id }}"
                    >
                      {{ 'products.product.quick_add' | t: item: sample_or_swatch }}
                    </button>
                    <a href="{{ quick_add_product.url }}" class="button-unstyled button button--quick-add no-js">
                      {{ 'products.product.quick_add' | t: item: sample_or_swatch }}
                    </a>
                  </quick-add-button>
                </div>
              {%- endunless -%}
            {%- when 'notify_me' -%}
              <script src="{{ 'component-klaviyo-notify.js' | asset_url }}" defer="defer"></script>
              <klaviyo-notify class="no-js-hidden" {{ block.shopify_attributes }}>
                <form action="post" class="stack">
                  <p class="rte">{{ block.settings.heading }}</p>
                  <input
                    type="email"
                    name="email"
                    id="Email"
                    placeholder="Enter your email address"
                    required
                    class="additional-input"
                  >
                  <input type="hidden" name="product" value="{{ product.id }}">
                  <input type="hidden" name="variant" value="{{ product.selected_or_first_available_variant.id }}">
                  <button type="submit" class="button button--primary button--full-width">Notify Me</button>
                  <p class="notify-message notify-message__success hidden">You’re on the list!</p>
                  <p class="notify-message notify-message__error form-error hidden">Opps, something went wrong!</p>
                  <p class="notify-message notify-message__error-email form-error hidden">
                    Please enter a valid email address.
                  </p>
                </form>
              </klaviyo-notify>
            {%- when 'switch_option_color' %}
              {%- render 'switch-option', type: 'color', block: block -%}
            {%- when 'switch_option_type' %}
              {%- render 'switch-option', type: 'type', block: block -%}
            {%- when 'breadcrumbs' -%}
              {%- render 'multi-collection-breadcrumb', block: block -%}
            {% when 'pair_with_it' %}
              {%- render 'block-pair-with-it', block: block, product: product -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ shop.url | append: product.url | json }},
    {%- if product.selected_or_first_available_variant.featured_media -%}
      "image": [
        {{ product.selected_or_first_available_variant.featured_media | image_url: width: product.selected_or_first_available_variant.featured_media.preview_image.width | prepend: "https:" | json }}
      ],
    {%- endif -%}
    "description": {{ product.description | strip_html | json }},
    {%- if product.selected_or_first_available_variant.sku != blank -%}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif -%}
    "brand": {
      "@type": "Thing",
      "name": {{ product.vendor | json }}
    },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type" : "Offer",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price" : {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency" : {{ cart.currency.iso_code | json }},
          "url" : {{ shop.url | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

