{{ 'component-slider.css' | asset_url | stylesheet_tag: preload: true }}

<style>
  .announcement-bar {
    padding: 0.5rem;
    position: relative;
  }
  .announcement-bar + .announcement-bar {
    padding-top: 0;
    padding-bottom: 0.5rem;
  }
  .announcement-bar__link {
    text-decoration: none;
  }
  .announcement-bar__message {
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    font-weight: var(--font-body-weight);
    letter-spacing: var(--font-heading-spacing);
    margin: 0;
    line-height: 1.5;
  }
  .announcement-bar__message strong {
    font-weight: var(--font-body-weight);
  }
  .announcement-bar .slider .carousel-cell {
    padding-inline: 2rem;
  }
  .announcement-bar slider-component:not(.slider-hide-buttons) .slider-buttons {
    display: flex;
    height: 0;
    inset: 0;
    justify-content: space-between;
    position: absolute;
    width: 100%;
    top: 50%;
    transform: translateY(-50%);
  }
  .announcement-bar .slider-button {
    line-height: 1;
    position: relative;
    top: 0;
    min-width: auto
  }
  .announcement-bar .slider-button svg {
    max-width: 1.5rem;
  }
  @media (min-width: 60em) {
    .announcement-bar slider-component:not(.slider-hide-buttons) .slider-buttons {
      margin: 0 auto;
      max-width: 45%;
      {% comment %} top: 0; {% endcomment %}
    }
  }
</style>

{%- if section.blocks.size > 1 -%}
  <div
    class="announcement-bar announcement-bar-slider section-color-{{ section.settings.color_scheme }}"
    role="region"
    aria-label="{{ 'sections.header.announcement' | t }}"
  >
    <slider-component class="slider-hide-dots center" data-autoplay="5000">
      <ul class="list-unstyled slider grid grid-nowrap mobile-one desktop-one" id="Slider-{{ section.id }}" role="list">
        {%- for block in section.blocks -%}
          <li
            class="carousel-cell grid__item"
            role="listitem"
            aria-label="{{ 'sections.header.announcement' | t }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.text != blank -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="announcement-bar__link focus-inset">
              {%- endif -%}
              <p class="announcement-bar__message">
                {{ block.settings.text }}
              </p>
              {%- if block.settings.link != blank -%}
                </a>
              {%- endif -%}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      <div class="slider-dots no-js-hidden">
        {% for dot in (1..section.blocks.size) %}
          <button
            type="button"
            data-index="{{ forloop.index }}"
            class="slider-dot{% if forloop.index0 == 0 %} is-active{% endif %}"
            name="index"
            aria-label="{{ 'accessibility.slide_index' | t: index: forloop.index }}"
          ></button>
        {% endfor %}
      </div>
      <div class="slider-buttons no-js-hidden">
        <button
          type="button"
          class="slider-button slider-button--prev"
          name="previous"
          aria-label="{{ 'accessibility.previous_slide' | t }}"
        >
          {%- render 'icon-chevron-left' -%}
        </button>
        <div class="slider-counter visually-hidden">
          <span class="slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="visually-hidden">{{ 'accessibility.of' | t }}</span>
          <span class="slider-counter--total">{{ section.blocks.size }}</span>
        </div>
        <button
          type="button"
          class="slider-button slider-button--next"
          name="next"
          aria-label="{{ 'accessibility.next_slide' | t }}"
        >
          {%- render 'icon-chevron-right' -%}
        </button>
      </div>
    </slider-component>
  </div>
{%- else -%}
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'announcement' -%}
        <div
          class="announcement-bar section-color-{{ section.settings.color_scheme }} center"
          role="region"
          aria-label="{{ 'sections.header.announcement' | t }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.text != blank -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="announcement-bar__link focus-inset">
            {%- endif -%}
            <p class="announcement-bar__message">
              {{ block.settings.text }}
            </p>
            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
          {%- endif -%}
        </div>
    {%- endcase -%}
  {%- endfor -%}
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "background-primary",
          "label": "Primary"
        },
        {
          "value": "background-secondary",
          "label": "Secondary"
        },
        {
          "value": "background-tertiary",
          "label": "Tertiary"
        },
        {
          "value": "background-quaternary",
          "label": "Newsletter"
        }
      ],
      "default": "background-quaternary"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Welcome to our store",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement"
      }
    ]
  }
}
{% endschema %}
