{{ 'section-collection-block.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'section-collection-block.css' | asset_url }}" media="print" onload="this.media='all'">

{% style %}
  [data-section-id="{{ section.id }}"] {
    width: 100%;
    padding-top: {{ section.settings.padding_top_mobile | append: 'px' }};
    padding-bottom: {{ section.settings.padding_bottom_mobile | append: 'px' }};
    background-color: {{ section.settings.background_color }};
  }
  @media (min-width: 768px) {
    [data-section-id="{{ section.id }}"] {
      padding-top: {{ section.settings.padding_top | append: 'px' }};
      padding-bottom: {{ section.settings.padding_bottom | append: 'px' }};
    }
  }
{% endstyle %}

{%- assign slider_id = 'section-collection-block-slider-' | append: section.id -%}

<div class="section-collection-block" data-section-id="{{ section.id }}">
  <div class="section-heading">
    {% if section.settings.cta_text %}
      <div class="empty-spacing"></div>
    {% endif %}
    <div class="section-heading-content">
      {% if section.settings.heading != blank %}
        <h2 class="section-collection-block-title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="section-collection-block-subtitle">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>
    
    {% if section.settings.cta_text %}
      <a href="{{ section.settings.cta_link | default: section.settings.featured_collection.url }}"
        title="{{ section.settings.cta_text }}"
        class="button--link">
        {{ section.settings.cta_text }}
      </a>
    {% endif %}
  </div>

  <slider-component class="section-collection-block__slider-wrap">
    <ul
      id="{{ slider_id }}"
      class="section-collection-block__track slider__grid list-unstyled slider grid grid-nowrap grid-{{ section.settings.slide_to_show }}-columns"
      role="list"
    >
      {% for block in section.blocks %}
        {% if block.type == 'slide' %}
          <li class="section-collection-block__slide slider__slide slider__slide carousel-cell grid__item{% if forloop.last %} grid__item--last{% elsif forloop.first %} grid__item--first{% endif %}" {{ block.shopify_attributes }}>
            <div class="section-collection-block__slide-wrapper">
              <a href="{{ block.settings.url | default: '#' }}" title="{{ block.settings.title }}" class="block-item">
                <div class="section-collection-block__image-wrap">
                  {% if block.settings.image != blank %}
                    <img
                      src="{{ block.settings.image | image_url: width: 800 }}"
                      alt="{{ block.settings.image.alt | escape }}"
                      width="800"
                      height="800"
                      loading="lazy"
                    >
                  {% else %}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'section-collection-block__placeholder' }}
                  {% endif %}
                </div>

                {% if block.settings.title != blank %}
                  <span class="btn-title h3">{{ block.settings.title }}</span>
                {% endif %}
              </a>
            </div>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
    <div class="slider-buttons no-js-hidden">
      <button
        type="button"
        class="slider-button slider-button--prev"
        name="previous"
        aria-label="{{ 'accessibility.previous_slide' | t }}"
      >
        {% render 'icon-arrow-left' %}
      </button>
      <div class="visually-hidden slider-counter caption">
        <span class="slider-counter--current">1</span>
        <span aria-hidden="true"> / </span>
        <span class="visually-hidden">{{ 'accessibility.of' | t }}</span>
        <span class="slider-counter--total">{{ section.blocks.size }}</span>
      </div>
      <button
        type="button"
        class="slider-button slider-button--next"
        name="next"
        aria-label="{{ 'accessibility.next_slide' | t }}"
      >
        {% render 'icon-arrow-right' %}
      </button>
    </div>
  </slider-component>
</div>

{% schema %}
{
  "name": "Collection block",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F3F1EC"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Whatever You Do, Make It Yours"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Your destination for custom window treatments, furniture and decor."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "range",
      "id": "slide_to_show",
      "label": "Slide to show (desktop)",
      "default": 4,
      "min": 3,
      "max": 5
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection block",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
