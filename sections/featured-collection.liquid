<link rel="stylesheet" href="{{ 'section-featured-collection.css' | asset_url }}">

{% style %}
  [data-section-id="{{ section.id }}"] {
    width: 100%;
    padding-top: {{ section.settings.padding_top_mobile | append: 'px' }};
    padding-bottom: {{ section.settings.padding_bottom_mobile | append: 'px' }};
  }
  @media (min-width: 768px) {
    [data-section-id="{{ section.id }}"] {
      padding-top: {{ section.settings.padding_top | append: 'px' }};
      padding-bottom: {{ section.settings.padding_bottom | append: 'px' }};
    }
  }
{% endstyle %}

<div data-section-id="{{ section.id }}" class="section-outer section-color-{{ section.settings.color_scheme }}">
  <div class="section-inner" 
    style="--image-width-desktop: {{  section.settings.image_width | default: '4.5fr' }};
          --subheading-max-width: {{ section.settings.subheading_max_width }};
          --heading-font-size-desktop: {{ section.settings.heading_font_size | append: 'px' }};">
    {%- if section.settings.video != blank -%}
      <div class="media--type-video {% if section.settings.video_mobile != blank %}hide-mobile{% endif %}">
        <div class="media media--square">
          <video class="lazy" 
            height="{{ section.settings.video.sources[1].height }}" 
            width="{{ section.settings.video.sources[1].width }}" 
            id="video-{{ section.id }}" playsinline loop autoplay muted preload="metadata">
              <source data-src="{{ section.settings.video.sources[1].url }}">
          </video>
        </div>
      </div>
      {%- if section.settings.video_mobile != blank -%}
        <div class="media--type-video hide-desktop {% if section.settings.square_video_mobile %}square-video{% endif %}">
          <div class="media media--square">
            <video class="lazy" 
              height="{{ section.settings.video_mobile.sources[1].height }}" 
              width="{{ section.settings.video_mobile.sources[1].width }}" 
              id="video-{{ section.id }}-mobile" playsinline loop autoplay muted preload="metadata">
                <source data-src="{{ section.settings.video_mobile.sources[1].url }}">
            </video>
          </div>
        </div>
      {%- endif -%}
    {%- elsif section.settings.image != blank -%}
      <div class="media">
        <img
          srcset="
            {%- if section.settings.image.width >= 375 -%}{{ section.settings.image | image_url: width: 375 }} 375w,{%- endif -%}
            {%- if section.settings.image.width >= 750 -%}{{ section.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if section.settings.image.width >= 1100 -%}{{ section.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
            {%- if section.settings.image.width >= 1500 -%}{{ section.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
            {%- if section.settings.image.width >= 1780 -%}{{ section.settings.image | image_url: width: 1780 }} 1780w,{%- endif -%}
            {%- if section.settings.image.width >= 2000 -%}{{ section.settings.image | image_url: width: 2000 }} 2000w,{%- endif -%}
            {%- if section.settings.image.width >= 3000 -%}{{ section.settings.image | image_url: width: 3000 }} 3000w,{%- endif -%}
            {%- if section.settings.image.width >= 3840 -%}{{ section.settings.image | image_url: width: 3840 }} 3840w,{%- endif -%}
          "
          sizes="(min-width: 60em) 60vw, calc(100vw - 4rem)"
          src="{{ section.settings.image | image_url: width: 530 }}"
          loading="lazy"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.width | divided_by: section.settings.image.aspect_ratio }}"
        >
      </div>
    {%- endif -%}
    <div class="section-content">
      <div class="word-icon">
        {% if section.settings.word_graphic %}
          <div class="word-graphic">
            {% assign graphic_width = section.settings.word_graphic_width %}
            <img src="{{ section.settings.word_graphic | image_url: width: graphic_width }}" width="{{ graphic_width }}" height="{{ graphic_width }}" alt="{{ section.settings.word_graphic.alt }}" loading="lazy">
          </div>
        {% else %}
          {%- liquid
            case section.settings.word
              when 'new'
                render 'word-new'
              when 'the'
                render 'word-the'
              when 'shop'
                render 'word-shop'
              when 'free'
                render 'word-free'
              else
            endcase
          -%}
        {% endif %}
        <h2 class="display fc-heading h1">{% render 'no-widows', content: section.settings.heading %}</h2>
        {% if section.settings.subheading != blank %}
          <p class="subheading">{{ section.settings.subheading }}</p>
        {% endif %}
        {% if section.settings.link != blank and section.settings.label != blank %}
          <a href="{{ section.settings.link }}" class="button--underline">{{ section.settings.label }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% if section.settings.video != blank %}
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var lazyVideos = [].slice.call(document.querySelectorAll("[data-section-id='{{ section.id }}'] video.lazy"));

      if ("IntersectionObserver" in window) {
        var lazyVideoObserver = new IntersectionObserver(function (entries, observer) {
          entries.forEach(function (video) {
            if (video.isIntersecting) {
              for (var source in video.target.children) {
                var videoSource = video.target.children[source];
                if (typeof videoSource.tagName === "string" && videoSource.tagName === "SOURCE") {
                  videoSource.src = videoSource.dataset.src;
                }
              }

              video.target.load();
              video.target.classList.remove("lazy");
              lazyVideoObserver.unobserve(video.target);
              video.target.play();
            }
          });
        });

        lazyVideos.forEach(function (lazyVideo) {
          lazyVideoObserver.observe(lazyVideo);
        });
      }
    });
  </script>
{% endif %}

{% schema %}
{
  "name": "Featured collection",
  "class": "section-fc",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "background-primary",
          "label": "Primary"
        },
        {
          "value": "background-secondary",
          "label": "Secondary"
        },
        {
          "value": "background-tertiary",
          "label": "Tertiary"
        }
      ],
      "default": "background-secondary"
    },
    {
      "type": "select",
      "id": "word",
      "label": "Word graphic",
      "options": [
        {
          "value": "",
          "label": "Select the graphic"
        },
        {
          "value": "new",
          "label": "New"
        },
        {
          "value": "shop",
          "label": "Shop"
        },
        {
          "value": "the",
          "label": "The"
        },
        {
          "value": "free",
          "label": "Free"
        }
      ],
      "default": ""
    },
    {
      "type": "image_picker",
      "id": "word_graphic",
      "label": "Word graphic (image)"
    },
    {
      "type": "range",
      "id": "word_graphic_width",
      "label": "Word graphic image width",
      "default": 104,
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "label": "Image width (desktop)",
      "id": "image_width",
      "info": "Ex: px, %, fr"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Video Mobile",
      "info": "If this setting is blank, on mobile it will display the default video"
    },
    {
      "type": "checkbox",
      "id": "square_video_mobile",
      "label": "Enable square video on mobile",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "default": 32,
      "min": 10,
      "max": 44,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub heading"
    },
    {
      "type": "text",
      "id": "subheading_max_width",
      "label": "Sub heading max width (desktop)",
      "info": "175px"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
