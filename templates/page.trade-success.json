    "accordion_section_M4PVtR": {
      "type": "accordion-section",
      "blocks": {
        "accordion_qmDXTQ": {
          "type": "accordion",
          "settings": {
            "title": "Who qualifies for the Trade Program?",
            "content": "<p>Interior designers, architects, and other design professionals working on residential or commercial projects are eligible to join. To be accepted, applicants must provide one of the following:</p><p>Proof of professional design credentials or membership (e.g., ASID, IIDA, IDC)</p><p>An active business license or resale certificate for a design-related business</p><p>A company website or portfolio showcasing current design work</p>"
          }
        },
        "accordion_dM7BG6": {
          "type": "accordion",
          "settings": {
            "title": "How do I apply for the Trade Program?",
            "content": "<p>You can apply by filling out our trade application <a href=\"https://pepper-home.com/pages/trade-application\" target=\"_blank\" title=\"Pepper Home Trade Application\">here</a>. Our trade team will follow up shortly after with any questions.</p>"
          }
        },
        "accordion_pUc4eh": {
          "type": "accordion",
          "settings": {
            "title": "How does trade pricing work?",
            "content": "<p>Pepper Home offers a tiered discount structure based on your lifetime spend with us—the more you order, the more you save. Reach out to our trade team for full pricing details.</p>"
          }
        },
        "accordion_nBHRnX": {
          "type": "accordion",
          "settings": {
            "title": "Where do I see my trade pricing?",
            "content": "<p>Once you're logged into your trade account, your trade price is shown right on the product page alongside retail pricing, so you always know exactly what you're paying before you order.</p>"
          }
        },
        "accordion_H8TPLX": {
          "type": "accordion",
          "settings": {
            "title": "How do I place an order?",
            "content": "<p>All orders are placed directly on our website. Once you're logged into your trade account, your discount is applied automatically at checkout—no codes or extra steps needed.</p>"
          }
        },
        "accordion_t3ttkC": {
          "type": "accordion",
          "settings": {
            "title": "Can multiple people on my team place orders?",
            "content": "<p>Yes! You can add more than one email address to your company's trade account. Every approved user can place orders using your trade discount, making it easy for your whole team to order seamlessly.</p>"
          }
        },
        "accordion_tcAkqh": {
          "type": "accordion",
          "settings": {
            "title": "Are swatches complimentary?",
            "content": "<p>Trade members enjoy complimentary swatches, giving you access to our full library of fabric, wallpaper, and finishes.</p>"
          }
        },
        "accordion_UkTJkM": {
          "type": "accordion",
          "settings": {
            "title": "Do you offer tax exemption?",
            "content": "<p>Yes! If you're purchasing merchandise for resale, we're happy to waive sales tax on qualifying orders with the appropriate tax exemption documentation.</p>"
          }
        },
        "accordion_yKqEVx": {
          "type": "accordion",
          "settings": {
            "title": "What kind of support does the trade team provide?",
            "content": "<p>Our dedicated concierge team is here to help with quotes, custom orders, and design guidance from concept through installation, so you're never navigating a project alone. Email trade@pepper-home.com with any questions.</p>"
          }
        }
      },
