        "edbd427b-181e-43dd-8ae5-9466975a8cba": {
          "type": "tab",
          "settings": {
            "heading": "Rick Rack",
            "image_content_width": 150,
            "content": "<p>Elevated craft meets sophisticated color with rick rack trim that’s delightfully unexpected.</p><p>Try before you buy with our <a href=\"/products/sample-curtain-trim\" target=\"_blank\" title=\"Curtain Trim Sample\">Trim Samples</a></p>",
