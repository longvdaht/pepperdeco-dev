          "settings": {
            "heading": "Tassel",
            "image_content_width": 150,
            "content": "<p>A versatile trim that suits any style—from a traditional reading room to a breezy boho breakfast nook. </p><p>Try before you buy with our <a href=\"/products/sample-curtain-trim\" target=\"_blank\" title=\"Curtain Trim Sample\">Trim Samples</a></p>",
            "image_1": "shopify://shop_images/Grid-Tassel.png",
