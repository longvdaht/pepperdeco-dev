{% layout none %}
<!DOCTYPE html>
  <html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="//cloud.typography.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} | tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} | Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} | {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="https://kit.fontawesome.com/3d594780df.js" crossorigin="anonymous" defer="defer"></script>

    {{ content_for_header }}

    {% style %}
      @font-face {
        font-family: 'gt-super';
        src: url({{ 'gt-super-display-light.woff2' | asset_url }}) format('woff2'),
          url({{ 'gt-super-display-light.woff' | asset_url }}) format('woff'),
          url({{ 'gt-super-display-light.ttf' | asset_url }}) format('truetype');
        font-weight: 100;
        font-style: normal;
        font-display: swap;
      }
    @font-face {
        font-family: 'gt-super';
        src: url({{ 'gt-super-display-light-italic.woff2' | asset_url }}) format('woff2'),
          url({{ 'gt-super-display-light-italic.woff' | asset_url }}) format('woff'),
          url({{ 'gt-super-display-light-italic.ttf' | asset_url }}) format('truetype');
        font-weight: 100;
        font-style: italic;
        font-display: swap;
      }
      @font-face {
        font-family: 'gt-super';
        src: url({{ 'gt-super-display-regular.woff2' | asset_url }}) format('woff2'),
          url({{ 'gt-super-display-regular.woff' | asset_url }}) format('woff'),
          url({{ 'gt-super-display-regular.ttf' | asset_url }}) format('truetype');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'apercu';
        src: url({{ 'apercu-light-pro.eot' | asset_url }});
        src: url({{ 'apercu-light-pro.eot?#iefix' | asset_url }}) format('embedded-opentype'),
          url({{ 'apercu-light-pro.woff2' | asset_url }}) format('woff2'),
          url({{ 'apercu-light-pro.woff' | asset_url }}) format('woff'),
          url({{ 'apercu-light-pro.ttf' | asset_url }}) format('truetype');
        font-weight: 100;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'apercu';
        src: url({{ 'apercu-medium-pro.eot' | asset_url }});
        src: url({{ 'apercu-medium-pro.eot?#iefix' | asset_url }}) format('embedded-opentype'),
          url({{ 'apercu-medium-pro.woff2' | asset_url }}) format('woff2'),
          url({{ 'apercu-medium-pro.woff' | asset_url }}) format('woff'),
          url({{ 'apercu-medium-pro.ttf' | asset_url }}) format('truetype');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }

      :root {
        --font-heading-family: 'gt-super', serif;
        --font-heading-weight: light;

        --font-body-family: 'apercu', sans-serif;
        --font-body-style: normal;
        --font-body-weight: 100;
        --font-button-weight: 400;

        --color-base-text: {{ settings.colors_text_primary.red }}, {{ settings.colors_text_primary.green }}, {{ settings.colors_text_primary.blue }};
        --color-base-background-primary: {{ settings.colors_background_primary.red }}, {{ settings.colors_background_primary.green }}, {{ settings.colors_background_primary.blue }};
        --color-base-background-secondary: {{ settings.colors_background_secondary.red }}, {{ settings.colors_background_secondary.green }}, {{ settings.colors_background_secondary.blue }};
        --color-base-button-label: {{ settings.colors_button_label.red }}, {{ settings.colors_button_label.green }}, {{ settings.colors_button_label.blue }};
        --color-base-button-background: {{ settings.colors_button_background.red }}, {{ settings.colors_button_background.green }}, {{ settings.colors_button_background.blue }};
        --color-base-button-background-hover: {{ settings.colors_button_background_hover.red }}, {{ settings.colors_button_background_hover.green }}, {{ settings.colors_button_background_hover.blue }};

        --page-width: {{ settings.page_width | divided_by: 10 }}rem;
      }

      *,
      *::before,
      *::after {
        box-sizing: inherit;
      }

      html {
        box-sizing: border-box;
        font-size: 62.5%;
        height: 100%;
      }

      body {
        display: flex;
        flex-direction: column;
        color: rgb(var(--color-base-text));
        margin: 0;
        min-height: 100%;
        font-family: var(--font-body-family);
        font-size: 1.5rem;
        font-style: var(--font-body-style);
        font-weight: var(--font-body-weight);
        line-height: 1.4;
      }

      @media screen and (min-width: 40em) {
        body {
          font-size: 1.6rem;
          line-height: 1.5;
        }
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <style>
      body {
        background-color: #f9f3ef;
        padding: 5rem 2rem;
      }
      .gift_card__apple-wallet {
        display: block;
        height: auto;
        margin: 0 auto;
        max-width: 140px;
      }
      .gift-card__qr-code img {
        text-align: center;
        margin: 2rem auto;
      }
    </style>

    <link rel="stylesheet" href="{{ 'component-predictive-search.css' | asset_url }}" media="print" onload="this.media='all'">

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
  </head>

  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ "accessibility.skip_to_text" | t }}
    </a>


    <header class="gift-card__title page-width center">
      <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" width="250" height="42" loading="lazy">
      <h1 class="h3 gift-card__heading">{{ 'gift_cards.issued.subtext' | t }}</h1>
      <div class="gift-card__price">
        <p>
          {% if settings.currency_code_enabled %}
            {{ gift_card.initial_value | money_with_currency }}
          {% else %}
            {{ gift_card.initial_value | money }}
          {% endif %}
        </p>
        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p class="gift-card__label badge badge--{{ settings.sold_out_badge_color_scheme }}">{{ 'gift_cards.issued.expired' | t }}</p>
        {%- endif -%}
      </div>

      {% if settings.currency_code_enabled %}
        {%- assign gift_card_balance = gift_card.balance | money_with_currency -%}
      {% else %}
        {%- assign gift_card_balance = gift_card.balance | money -%}
      {% endif %}
      {%- if gift_card.balance != gift_card.initial_value -%}
        <p class="gift-card__label caption-large">{{ 'gift_cards.issued.remaining_html' | t: balance: gift_card_balance }}</p>
      {%- endif -%}
    </header>

    <main class="gift-card page-width center">
      <div class="gift-card__image-wrapper">
        <img src="{{ 'gift-card.jpg' | asset_url }}" alt="" class="gift-card__image" height="{{ 570 | divided_by: 1.5 }}" width="570" loading="lazy">
      </div>
      <div class="gift-card__qr-code" data-identifier="{{ gift_card.qr_identifier }}"></div>
      <div class="gift-card__information">
        <input
          type="text"
          class="gift-card__number"
          value="{{ gift_card.code | format_code }}"
          aria-label="{{ 'gift_cards.issued.gift_card_code' | t }}"
          readonly
        >
        <div class="gift-card__copy-code">
          <button class="button-unstyled text-link gift-card__copy-link">{{ 'gift_cards.issued.copy_code' | t }}</button>
          <span class="gift-card__copy-success form__message" role="status"></span>
          <template>
            <i class="fas fa-check"></i>{{ 'gift_cards.issued.copy_code_success' | t }}
          </template><br><br>
        </div>
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}" class="gift_card__apple-wallet">
            <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}" loading="lazy">
          </a>
        {%- endif -%}
        <div class="gift-card__buttons no-print">
          <a
            href="{{ shop.url }}"
            class="button"
            target="_blank"
            rel="noopener"
            aria-describedby="a11y-new-window-message"
          >
            {{ 'gift_cards.issued.shop_link' | t }}
          </a><br>
          <button
            class="text-link button-unstyled"
            onclick="window.print();"
          >
            {{ 'gift_cards.issued.print_gift_card' | t }}
          </button>
        </div>
      </div>
    </main>

    <script>
      var string = { qrImageAlt: {{ 'gift_cards.issued.qr_image_alt' | t | json }} };
      document.addEventListener('DOMContentLoaded', function() {
       new QRCode( document.querySelector('.gift-card__qr-code'), {
        text: document.querySelector('.gift-card__qr-code').dataset.identifier,
        width: 120,
        height: 120,
        imageAltText: string.qrImageAlt
        });
      });

      var template = document.getElementsByTagName("template")[0];
      var clonedTemplate = template.content.cloneNode(true);

      var isMessageDisplayed = false
      document
      .querySelector('.gift-card__copy-link')
      .addEventListener('click', () => {
        navigator.clipboard.writeText(document.querySelector('.gift-card__number').value).then(function () {
          if (!isMessageDisplayed) {
            document.querySelector('.gift-card__copy-success').appendChild(clonedTemplate);
            isMessageDisplayed = true
          }
        });
      });
    </script>

    <script>
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}'
      };

      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t }}`
      }

      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        addToCartHtml: `{{ 'products.product.add_to_cart_html' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
      }

      window.accessibilityStrings = {
        shareSuccess: `{{ 'general.share.success_message' | t }}`,
      }
    </script>

    {% comment %} <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script> {% endcomment %}

    {% comment %} SCRIPTS {% endcomment %}

    {% comment %} Facebook {% endcomment %}
    <script type="text/javascript">
      (() => {
        window.fbq('init', '2159623904124609');
      })();
    </script>
    <noscript>
      <img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=2159623904124609&ev=PageView&noscript=1" loading="eager" />
    </noscript>

    {% comment %} <!--Gorgias Chat Widget Start--> {% endcomment %}
    <script id="gorgias-chat-widget-install">!function(_){_.GORGIAS_CHAT_APP_ID="7740",_.GORGIAS_CHAT_BASE_URL="us-east1-898b.production.gorgias.chat",_.GORGIAS_API_BASE_URL="config.gorgias.chat";var e=new XMLHttpRequest;e.open("GET","https://config.gorgias.chat/applications/7740",!0),e.onload=function(t){if(4===e.readyState)if(200===e.status){var n=JSON.parse(e.responseText);if(!n.application||!n.bundleVersion)throw new Error("Missing fields in the response body - https://config.gorgias.chat/applications/7740");if(_.GORGIAS_CHAT_APP=n.application,_.GORGIAS_CHAT_BUNDLE_VERSION=n.bundleVersion,n&&n.texts&&(_.GORGIAS_CHAT_TEXTS=n.texts),n&&n.sspTexts&&(_.GORGIAS_CHAT_SELF_SERVICE_PORTAL_TEXTS=n.sspTexts),!document.getElementById("gorgias-chat-container")){var o=document.createElement("div");o.id="gorgias-chat-container",document.body.appendChild(o);var r=document.createElement("script");r.setAttribute("defer",!0),r.src="https://client-builds.production.gorgias.chat/{bundleVersion}/static/js/main.js".replace("{bundleVersion}",n.bundleVersion),document.body.appendChild(r)}}else console.error("Failed request GET - https://config.gorgias.chat/applications/7740")},e.onerror=function(_){console.error(_)},e.send()}(window||{});</script><script id="gorgias-chat-shopify-install">!function(_){_.SHOPIFY_PERMANENT_DOMAIN="{{ shop.permanent_domain }}",_.SHOPIFY_CUSTOMER_ID="{{ customer.id }}",_.SHOPIFY_CUSTOMER_EMAIL="{{ customer.email }}"}(window||{});</script>
    {% comment %} <!--Gorgias Chat Widget End--> {% endcomment %}
  </body>
  </html>
